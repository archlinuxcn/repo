pkgname=open-bamboo-networking
pkgver=2.3.0
# Bambu Studio plugin ABI (first three components of the Bambu Studio version)
# this build targets. The plugin only loads into a Bambu Studio of the same
# series.
_studio_abi=02.09.01
_mosquitto_ver=2.1.2
pkgrel=1
pkgdesc="Open-source replacement for the Bambu Studio network plugin"
arch=('aarch64' 'x86_64')
url="https://github.com/ClusterM/open-bamboo-networking"
license=('AGPL-3.0-or-later')
_abi=(${_studio_abi//./ })
_studio_ver=$((10#${_abi[0]})).$((10#${_abi[1]})).$((10#${_abi[2]}))
_studio_next=$((10#${_abi[0]})).$((10#${_abi[1]})).$((10#${_abi[2]} + 1))
depends=('curl' 'gcc-libs' 'glibc' 'openssl' 'zlib'
         "bambu-studio>=$_studio_ver" "bambu-studio<$_studio_next")
# cjson is only needed to configure mosquitto, the plugin does not use it.
makedepends=('cjson' 'cmake' 'uthash')
# mosquitto is vendored on purpose: the plugin uses an API added by its own
# patches (mosquitto_tls_verify_hostname_set) and links it statically.
source=("$pkgname-$pkgver.tar.gz::https://github.com/ClusterM/open-bamboo-networking/archive/refs/tags/v$pkgver.tar.gz"
        "mosquitto-$_mosquitto_ver.tar.gz::https://github.com/eclipse/mosquitto/archive/refs/tags/v$_mosquitto_ver.tar.gz"
        '0001-Allow-using-the-system-cJSON.patch')
sha256sums=('2b75e3b9e0123d56f6280df7e5bc2811e3f963241c2ddba15ccaf8be562886a0'
            '20e998aae86d1629e787a924c044bb912d21ac8f5d1c1b707f2af06eb4c6016d'
            'c3ff00cb57efc67c56d68951e1a8d04edde4ecfc4247652003d5aa9410f3fb78')

prepare() {
  cd $pkgname-$pkgver

  if [[ ! -d tools/abi_snapshot/v$_studio_abi ]]; then
    echo "open-bamboo-networking $pkgver does not support Bambu Studio ABI $_studio_abi" >&2
    return 1
  fi

  local mosquitto_tag=$(sed -nE 's/^set\(OBN_MOSQUITTO_GIT_TAG "v([^"]+)".*/\1/p' CMakeLists.txt)
  if [[ $mosquitto_tag != "$_mosquitto_ver" ]]; then
    echo "open-bamboo-networking $pkgver wants mosquitto $mosquitto_tag, not $_mosquitto_ver" >&2
    return 1
  fi

  patch -Np1 < ../0001-Allow-using-the-system-cJSON.patch
}

build() {
  # Keep the commit detection from picking up an enclosing git checkout
  export GIT_CEILING_DIRECTORIES="$srcdir"
  # Source paths end up in log messages
  CFLAGS+=" -ffile-prefix-map=$srcdir/="
  CXXFLAGS+=" -ffile-prefix-map=$srcdir/="

  cmake -B build -S $pkgname-$pkgver \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DOBN_CLIENT_TYPE=bambu_studio \
        -DOBN_VERSION=$_studio_abi.99 \
        -DOBN_RELEASE=ON \
        -DOBN_PATCH_CLIENT_CONF=OFF \
        -DOBN_SYSTEM_CJSON=ON \
        -DOBN_BUILD_TESTS=ON \
        -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
        -DFETCHCONTENT_SOURCE_DIR_ECLIPSE_MOSQUITTO="$srcdir/mosquitto-$_mosquitto_ver"
  cmake --build build
}

check() {
  # The live tests skip themselves without a printer configured
  ctest --test-dir build --output-on-failure
}

package() {
  local plugindir="$pkgdir/usr/lib/bambu-studio/plugins"
  install -Dm755 -t "$plugindir" \
          build/libbambu_networking.so build/libBambuSource.so build/liblive555.so

  cd $pkgname-$pkgver
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md STATUS.md
}
