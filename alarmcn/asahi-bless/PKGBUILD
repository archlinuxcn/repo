# Maintainer: Jos Dehaes <jos.dehaes@gmail.com>
# Maintainer: Matthias Kurz <m.kurz@irregular.at>

pkgname=asahi-bless
pkgver=0.4.4
pkgrel=1
pkgdesc='Tool to select active boot partition on ARM Macs'
arch=('aarch64')
url="https://crates.io/crates/$pkgname"
depends=('rust' 'cargo')
license=('MIT')
source=(
  "asahi-bless-${pkgver}.tar.gz::https://static.crates.io/crates/asahi-bless/asahi-bless-${pkgver}.crate"
)
sha256sums=('624e6d511a30ec2be6d8347523767ecbb4045c290e843a3864c08f5e2b3741ba')

build() {
  cd "${srcdir}/$pkgname-${pkgver}"
  cargo build --release --locked
}

package() {
  cd "${srcdir}/$pkgname-${pkgver}"
  cargo install --locked --path . --root "$pkgdir/usr"
  rm "$pkgdir/usr/".crates*
}
