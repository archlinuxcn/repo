prepare() {
  patch -Np1 -d BambuStudio-$_raw_pkgver < 0001-src-slic3r-CMakeLists.txt-avoid-linking-to-the-depre.patch
  patch -Np1 -d BambuStudio-$_raw_pkgver < 0002-Fix-build-with-CGAL-6.patch
  patch -Np1 -d BambuStudio-$_raw_pkgver < 0003-Fix-linking-with-system-libraries.patch
  patch -Np1 -d BambuStudio-$_raw_pkgver < 0004-Fix-build-with-newer-Boost.patch
  patch -Np1 -d BambuStudio-$_raw_pkgver < 0005-Support-system-libharu-header-layout.patch
  patch -Np1 -d BambuStudio-$_raw_pkgver < 0006-Disable-wxWidgets-sizer-consistency-checks.patch
  patch -Np1 -d BambuStudio-$_raw_pkgver < 0007-Fix-null-window-in-topbar-button-bitmap-lookup.patch
  patch -Np1 -d BambuStudio-$_raw_pkgver < 0008-Load-the-network-plugin-from-a-system-directory.patch
  patch -Np1 -d BambuStudio-$_raw_pkgver < 0009-Fix-size_t-arguments-to-d-in-wxString-Format.patch

  mkdir -p BambuStudio-$_raw_pkgver/build

  # OpenMeshCraft is set up the same way as the PATCH_COMMAND in
  # deps/OpenMeshCraft/OpenMeshCraft.cmake, except that the submodules it
  # would fill in come from the system and {fmt} is replaced by std::format.
  local recipe="$srcdir/BambuStudio-$_raw_pkgver/deps/OpenMeshCraft"
  if ! grep -q "OpenMeshCraft/archive/$_omc_commit\.zip" "$recipe/OpenMeshCraft.cmake"; then
    echo "Bambu Studio $_raw_pkgver does not use OpenMeshCraft $_omc_commit" >&2
    return 1
  fi
  cd OpenMeshCraft-$_omc_commit
  cp "$recipe/CMakeLists.txt.in" CMakeLists.txt
  cp "$recipe/OpenMeshCraftConfig.cmake.in" OpenMeshCraftConfig.cmake.in
  cp -r "$recipe/wrapper" bambu_wrapper
  # The external/CMakeLists.txt overlay is embedded in the recipe
  sed -n '/^file(WRITE "${_OMC_GEN_DIR}\/external_CMakeLists.txt" \[=\[$/,/^\]=\])$/p' \
      "$recipe/OpenMeshCraft.cmake" | sed '1d;$d' > external/CMakeLists.txt
  if [[ ! -s external/CMakeLists.txt ]]; then
    echo "Cannot find the external/CMakeLists.txt overlay in the recipe" >&2
    return 1
  fi
  patch -Np1 < ../openmeshcraft-system-deps.patch
}

_build_openmeshcraft() {
  # Only use the baseline instruction set of each architecture
  # (Arch still supports x86_64 CPUs without AVX)
  local simd=(-DOMC_CMAKE_ENABLE_AVX=OFF -DOMC_CMAKE_ENABLE_AVX2=OFF -DOMC_CMAKE_ENABLE_FMA=OFF)
  if [[ $CARCH == x86_64 ]]; then
    simd+=(-DOMC_CMAKE_ENABLE_SSE2=ON)
  else
    simd+=(-DOMC_CMAKE_ENABLE_SSE2=OFF)
  fi

  # Static libraries, installed into a private prefix for bambu-studio
  cmake -B "$srcdir/openmeshcraft-build" -S "$srcdir/OpenMeshCraft-$_omc_commit" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX="$srcdir/openmeshcraft" \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DOMC_BUILD_TEST=OFF \
        -DOMC_MASTER_PROJECT=OFF \
        -DOMC_BUILD_PREDICATES_GENERATOR=OFF \
        -DOMC_CMAKE_ENABLE_DEBUG_INFO=OFF \
        -DOMC_USE_STD_FORMAT=ON \
        "${simd[@]}"
  cmake --build "$srcdir/openmeshcraft-build"
  cmake --install "$srcdir/openmeshcraft-build"
}

build() {
  # Burrr, BBL is sticking with an old version of cmake ...
  export CMAKE_POLICY_VERSION_MINIMUM=3.5
  # GCC 15 defaults to c23, which breaks some old code ...
  export CC='gcc -std=gnu99'

  _build_openmeshcraft

  cd BambuStudio-$_raw_pkgver/build
  cmake ../ \
        -DSLIC3R_STATIC=0 \
        -DSLIC3R_GTK=3 \
        -DSLIC3R_FHS=1 \
        -DBBL_RELEASE_TO_PUBLIC=1 \
        -DBBL_INTERNAL_TESTING=0 \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DOPENSSL_ROOT_DIR=/usr \
        -DLIBNOISE_INCLUDE_DIR=/usr/include/noise \
        -DLIBNOISE_LIBRARY=/usr/lib/libnoise.so \
        -DFLATPAK=On \
        -DSLIC3R_SYSTEM_PLUGIN_DIR=/usr/lib/bambu-studio/plugins \
        -DCMAKE_PREFIX_PATH="$srcdir/openmeshcraft"
  cmake --build . --config Release
}

package() {
  cd BambuStudio-$_raw_pkgver/build
  # Only install bambu-studio itself, not the headers and docs of the bundled mcut
  DESTDIR="$pkgdir" cmake --install . --component Unspecified
  install -Dm0644 "$srcdir"/BambuStudio-$_raw_pkgver/LICENSE "$pkgdir"/usr/share/licenses/BambuStudio/LICENSE
}
