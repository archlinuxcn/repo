-wxBitmap create_filament_bitmap(const std::vector<wxColour>& colors, const wxSize& size, bool force_gradient)
+wxBitmap create_filament_bitmap(const std::vector<wxColour>& in_colors, const wxSize& size, bool force_gradient)
 {
-    if (colors.empty()) return wxNullBitmap;
+    if (in_colors.empty()) return wxNullBitmap;
+
+    // An empty or unparsable color string (e.g. an empty AMS tray) gives an
+    // invalid wxColour, whose accessors assert. Draw it as fully transparent,
+    // which is what those accessors return when the assertions are disabled.
+    std::vector<wxColour> colors(in_colors);
+    for (auto &c : colors) {
+        if (!c.IsOk())
+            c = wxColour(0, 0, 0, wxALPHA_TRANSPARENT);
+    }
 
     if (force_gradient && colors.size() >= 2) {
