--- a/cmake/modules/Findcereal.cmake
+++ b/cmake/modules/Findcereal.cmake
@@ -5,6 +5,13 @@
 endif()
 find_package(${CMAKE_FIND_PACKAGE_NAME} ${${CMAKE_FIND_PACKAGE_NAME}_FIND_VERSION} CONFIG ${_q})
 
+if (${CMAKE_FIND_PACKAGE_NAME}_FOUND AND TARGET cereal::cereal AND NOT TARGET cereal)
+    # cereal >= 1.3.1 only exports the namespaced cereal::cereal target, while
+    # the project links against plain `cereal` (which would become -lcereal).
+    add_library(cereal INTERFACE)
+    target_link_libraries(cereal INTERFACE cereal::cereal)
+endif()
+
 if (NOT ${CMAKE_FIND_PACKAGE_NAME}_FOUND)
     # Fall-back solution to find the Cereal serialization library header file
     include(CheckIncludeFileCXX)
