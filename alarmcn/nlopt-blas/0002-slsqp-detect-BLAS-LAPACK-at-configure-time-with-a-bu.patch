   src/util/mt19937ar.c src/util/sobolseq.c src/util/soboldata.h src/util/timer.c src/util/stop.c src/util/nlopt-util.h src/util/redblack.c src/util/redblack.h src/util/qsort_r.c src/util/rescale.c
@@ -232,13 +319,11 @@ endif ()
 if (M_LIBRARY)
   target_link_libraries (${nlopt_lib} PRIVATE ${M_LIBRARY})
 endif ()
-# SLSQP calls BLAS/LAPACK; for now this must be an ILP64 build with the
-# "64_" symbol suffix (e.g. libblas64 from OpenBLAS)
-find_library (NLOPT_BLAS64_LIBRARY NAMES blas64)
-if (NOT NLOPT_BLAS64_LIBRARY)
-  message (FATAL_ERROR "ILP64 BLAS/LAPACK (libblas64) not found")
+if (NLOPT_BLAS_LIBRARIES)
+  target_link_libraries (${nlopt_lib} PRIVATE ${NLOPT_BLAS_LIBRARIES})
+  target_compile_definitions (${nlopt_lib} PRIVATE NLOPT_HAVE_BLAS
