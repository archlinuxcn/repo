prepare() {
  cd nlopt-$pkgver

  for _patch in "${_patches[@]}"; do
    echo "Applying $_patch"
    patch -Np1 --no-backup-if-mismatch < ../"${_patch}"
  done

  # Fix build with octave 10+
  sed \
    -e 's|CMAKE_CXX_STANDARD 11|CMAKE_CXX_STANDARD 17|' \
    -i CMakeLists.txt
}

build() {
  local cmake_options=(
    -B build
    -S nlopt-$pkgver
    -D CMAKE_INSTALL_PREFIX=/usr
    -D NLOPT_BLAS="blas64;lapack64"
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
