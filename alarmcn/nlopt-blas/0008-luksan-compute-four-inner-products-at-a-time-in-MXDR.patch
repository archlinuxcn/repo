From fe46d1f1ddbde3a5ab2a703cbf58e1528046dbb3 Mon Sep 17 00:00:00 2001
From: Yichao Yu <yyc1992@gmail.com>
Date: Thu, 29 Oct 2026 21:44:20 -0400
Subject: [PATCH 08/21] luksan: compute four inner products at a time in MXDRMM

MXDRMM (y = A^T x for the stored columns of the variable-metric
methods) took about three quarters of the time of VAR1/VAR2 with a cheap
objective.  Compute four columns at a time, so that x is read once per
four columns and the four sums are independent; each is accumulated in
the same order as before, so the results are bit-identical.  With the
previous commit, VAR2 is 2.1-2.3x faster per evaluation (n = 1000-3000).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/algs/luksan/mssubs.c | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/src/algs/luksan/mssubs.c b/src/algs/luksan/mssubs.c
index bfd0221..fa56576 100644
--- a/src/algs/luksan/mssubs.c
+++ b/src/algs/luksan/mssubs.c
@@ -470,11 +470,29 @@ void luksan_mxdrmm__(int *n, int *m, double *a,
     --a;
 
     /* Function Body */
+    /* Four columns at a time, so that X is read once per four columns; each
+       inner product is accumulated in the same order as one at a time. */
     k = 0;
     i__1 = *m;
-    for (j = 1; j <= i__1; ++j) {
+    i__2 = *n;
+    for (j = 1; j + 3 <= i__1; j += 4) {
+	const double *a0 = &a[k], *a1 = a0 + *n, *a2 = a1 + *n, *a3 = a2 + *n;
+	double t0 = 0., t1 = 0., t2 = 0., t3 = 0.;
+	for (i__ = 1; i__ <= i__2; ++i__) {
+	    double xi = x[i__];
+	    t0 += a0[i__] * xi;
+	    t1 += a1[i__] * xi;
+	    t2 += a2[i__] * xi;
+	    t3 += a3[i__] * xi;
+	}
+	y[j] = t0;
+	y[j + 1] = t1;
+	y[j + 2] = t2;
+	y[j + 3] = t3;
+	k += *n << 2;
+    }
+    for (; j <= i__1; ++j) {
 	temp = 0.;
-	i__2 = *n;
 	for (i__ = 1; i__ <= i__2; ++i__) {
 	    temp += a[k + i__] * x[i__];
 /* L1: */
