From 17c4eeb3c6481649216510a938abd8592aa44961 Mon Sep 17 00:00:00 2001
From: Yichao Yu <yyc1992@gmail.com>
Date: Thu, 29 Oct 2026 22:41:00 -0400
Subject: [PATCH 11/21] luksan: use BLAS for the unmasked inner products and
 MXDRMM

With an external BLAS/LAPACK, compute the unmasked inner products
(MXUDOT, used throughout, e.g. twice per stored pair in the L-BFGS
recursion) with DDOT, the in-place unmasked updates (MXUDIR with z = y)
with DAXPY and MXDRMM (VAR1/VAR2) with DGEMV.  Without one, the loops
are kept, so the built-in build stays bit-identical to the original.

The summation order changes with BLAS, so results differ in the last
bits.  On an ill-conditioned quadratic with a cheap objective, the time
per evaluation drops by another 1.6x for L-BFGS (n = 1000-10000), 1.4x
for truncated Newton (n = 10000) and 1.2-1.3x for VAR2 (n = 1000-3000)
with single-threaded OpenBLAS.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/algs/luksan/mssubs.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/src/algs/luksan/mssubs.c b/src/algs/luksan/mssubs.c
index fa56576..db1ae90 100644
--- a/src/algs/luksan/mssubs.c
+++ b/src/algs/luksan/mssubs.c
@@ -1,5 +1,6 @@
 #include <math.h>
 #include "luksan.h"
+#include "nlopt-blas.h"
 
 #define MAX2(a,b) ((a) > (b) ? (a) : (b))
 #define iabs(a) ((a) < 0 ? -(a) : (a))
@@ -470,6 +471,18 @@ void luksan_mxdrmm__(int *n, int *m, double *a,
     --a;
 
     /* Function Body */
+#ifdef NLOPT_HAVE_BLAS
+    (void) i__1; (void) i__2; (void) i__; (void) k; (void) temp;
+    {
+	blas_int nn = *n, mm = *m, one = 1;
+	double done = 1., dzero = 0.;
+	if (mm > 0 && nn > 0) {
+	    NLOPT_BLAS(dgemv)("T", &nn, &mm, &done, &a[1], &nn, &x[1], &one, &dzero, &y[1], &one);
+	} else {
+	    for (j = 1; j <= mm; ++j) y[j] = 0.;
+	}
+    }
+#else
     /* Four columns at a time, so that X is read once per four columns; each
        inner product is accumulated in the same order as one at a time. */
     k = 0;
@@ -501,6 +514,7 @@ void luksan_mxdrmm__(int *n, int *m, double *a,
 	k += *n;
 /* L2: */
     }
+#endif
     return;
 } /* luksan_mxdrmm__ */
 
@@ -633,6 +647,13 @@ void luksan_mxudir__(int *n, double *a, double *x,
 
     /* Function Body */
     if (*job == 0) {
+#ifdef NLOPT_HAVE_BLAS
+	if (z__ == y) {
+	    blas_int nn = *n, one = 1;
+	    NLOPT_BLAS(daxpy)(&nn, a, &x[1], &one, &z__[1], &one);
+	    return;
+	}
+#endif
 	i__1 = *n;
 	for (i__ = 1; i__ <= i__1; ++i__) {
 	    z__[i__] = y[i__] + *a * x[i__];
@@ -725,11 +746,16 @@ double luksan_mxudot__(int *n, double *x, double *y, int *ix,
     /* Function Body */
     temp = 0.;
     if (*job == 0) {
+#ifdef NLOPT_HAVE_BLAS
+	blas_int nn = *n, one = 1;
+	temp = NLOPT_BLAS(ddot)(&nn, &x[1], &one, &y[1], &one);
+#else
 	i__1 = *n;
 	for (i__ = 1; i__ <= i__1; ++i__) {
 	    temp += x[i__] * y[i__];
 /* L1: */
 	}
+#endif
     } else if (*job > 0) {
 	i__1 = *n;
 	for (i__ = 1; i__ <= i__1; ++i__) {
