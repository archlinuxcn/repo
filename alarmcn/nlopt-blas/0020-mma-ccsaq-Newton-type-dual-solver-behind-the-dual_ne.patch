+	  if (accepted) {
+	       double *tmp;
+	       /* the step of z, kept within a factor KAPPA of the central
+		  path mu/s */
+	       for (l = 0; l < nF; ++l) {
+		    double sl = yt[F[l]] - lb[F[l]], mus = MAX(mu, DBL_MIN);
+		    z[l] += alpha_z * dz[l];
+		    z[l] = MAX(MIN(z[l], KAPPA * mus / sl), mus / (KAPPA * sl));
+	       }
+	       tmp = g; g = gt; gt = tmp;
+	       memcpy(y0, y, sizeof(double) * m);
+	       memcpy(y, yt, sizeof(double) * m);
+	  }
+	  if (nlopt_stop_forced(&ds)) { ret = NLOPT_FORCED_STOP; break; }
+	  if (nlopt_stop_evals(&ds)) { ret = NLOPT_MAXEVAL_REACHED; break; }
+	  if (nlopt_stop_time(&ds)) { ret = NLOPT_MAXTIME_REACHED; break; }
+	  if (!accepted || (ls > 0 && fabs(fyt - fy) <= tol)) {
+	       /* no decrease possible: limited by roundoff */
+	       if (accepted) fy = fyt;
+	       ret = NLOPT_FTOL_REACHED;
+	       break;
+	  }
+	  fy = fyt;
+	  if (nlopt_stop_x(&ds, y, y0)) { ret = NLOPT_XTOL_REACHED; break; }
+     }
+
+ done:
+     *minf = fy;
+     free(H);
+     free(B);
+     free(work);
+     return ret;
+}
