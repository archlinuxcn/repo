+// MMA and CCSA with the Newton-type dual solver ("dual_newton" parameter) on
+// a box-bounded quadratic with fewer and with more linear inequality
+// constraints than variables (the two ways ccsa_dual_newton solves its
+// Newton system), from an infeasible start.  For MMA, a constraint that is
+// always NaN (inactive) is added.  The reference minima were computed with
+// both algorithms and both settings of NLOPT_BLAS, which agree to 1e-14 (the
+// default dual solver stops 1e-8 to 1e-7 away from them).
+
+#include <cmath>
+#include <cstdlib>
+#include <iomanip>
+#include <iostream>
+#include <vector>
+#include <nlopt.hpp>
+
+static const unsigned n = 8;
+
+double objective(const std::vector<double> &x, std::vector<double> &grad, void *data)
+{
+  (void)data;
+  double f = 0, s = 0;
+  for (unsigned j = 0; j < n; ++j) s += x[j];
+  for (unsigned j = 0; j < n; ++j) {
+    double c = 1.5 * std::cos(j + 1.0);
+    f += (x[j] - c) * (x[j] - c);
+    if (!grad.empty()) grad[j] = 2 * (x[j] - c) + 0.2 * s;
+  }
+  return f + 0.1 * s * s;
+}
+
+// a_i^T x <= 0.3 with a_ij = sin(i + 1.7 j + 1)
+void linear(unsigned m, double *result, unsigned nx, const double *x, double *grad, void *data)
+{
+  (void)data;
+  for (unsigned i = 0; i < m; ++i) {
+    result[i] = -0.3;
+    for (unsigned j = 0; j < nx; ++j) {
+      double a = std::sin(i + 1.7 * j + 1);
+      result[i] += a * x[j];
+      if (grad) grad[i*nx + j] = a;
+    }
+  }
+}
+
+double nan_constraint(const std::vector<double> &x, std::vector<double> &grad, void *data)
+{
+  (void)x; (void)data;
+  for (double &g : grad) g = 0;
+  return NAN;
+}
+
+static bool run(const char *alg, unsigned m, std::vector<double> &x, double &minf)
+{
+  nlopt::opt opt(alg, n);
+  opt.set_lower_bounds(std::vector<double>(n, -1.0));
+  opt.set_upper_bounds(std::vector<double>(n, 1.0));
+  opt.set_min_objective(objective, NULL);
+  opt.add_inequality_mconstraint(linear, NULL, std::vector<double>(m, 1e-10));
+  if (opt.get_algorithm() == nlopt::LD_MMA)
+    opt.add_inequality_constraint(nan_constraint, NULL, 0);
+  opt.set_param("dual_newton", 1);
+  opt.set_xtol_rel(1e-10);
+  opt.set_maxeval(5000);
+  x.assign(n, 0.9);
+  try {
+    nlopt::result result = opt.optimize(x, minf);
+    std::cout << opt.get_algorithm_name() << ", m = " << m << ": result " << result << ", f = " << std::setprecision(17) << minf << " after "
+              << opt.get_numevals() << " evaluations" << std::endl;
+    return result > 0;
+  }
+  catch (std::exception &e) {
+    std::cerr << "nlopt failed: " << e.what() << std::endl;
+    return false;
+  }
+}
+
+int main(int argc, char *argv[]) {
+  const char *alg = argc < 2 ? "LD_MMA" : argv[1];
+  bool ok = true;
+  const struct { unsigned m; double minf; } cases[] = {
+    {3, 0.59686349241284586}, {40, 0.71906716975323159}};
+  for (const auto &c : cases) {
+    std::vector<double> x, fc(c.m);
+    double minf, viol = 0;
+    ok = run(alg, c.m, x, minf) && ok;
+    linear(c.m, fc.data(), n, x.data(), NULL, NULL);
+    for (double fci : fc) viol = std::fmax(viol, fci);
+    if (!(std::fabs(minf - c.minf) <= 1e-9 && viol <= 1e-9)) {
+      std::cerr << "f = " << minf << " instead of " << c.minf
+                << ", constraint violation " << viol << std::endl;
+      ok = false;
+    }
+  }
+  return ok ? EXIT_SUCCESS : EXIT_FAILURE;
+}
