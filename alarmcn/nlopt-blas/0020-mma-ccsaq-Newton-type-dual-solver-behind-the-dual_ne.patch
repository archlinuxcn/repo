+	  /* backtracking search on phi */
+	  phi = fy;
+	  for (l = 0; l < nF; ++l) phi -= mu * log(y[F[l]] - lb[F[l]]);
+	  memcpy(yt, y, sizeof(double) * m);
+	  for (ls = 0; ls < MAXLS; ++ls) {
+	       for (l = 0; l < nF; ++l) yt[F[l]] = y[F[l]] + alpha * dy[l];
+	       fyt = f(m, yt, gt, f_data);
