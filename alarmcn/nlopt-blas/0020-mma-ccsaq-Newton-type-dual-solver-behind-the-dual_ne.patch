+
+/* A Newton-type solver for the dual problems of MMA and CCSAQ (the
+   "dual_newton" parameter), in place of the general bound-constrained
+   optimizer dual_opt.
+
+   The dual function f(y), to be minimized over y >= lb, is the negated
+   minimum over x of the separable Lagrangian.  Its gradient is minus the
+   constraint approximations gc(x(y)), and its Hessian is G D G^T, where G is
+   the Jacobian of gc at x(y) and D is the diagonal inverse second
+   derivative of the Lagrangian in the components of x(y) that are not at a
+   bound (zero in the others); the caller supplies B = (G D^{1/2})^T.
+
+   The Hessian is singular when more multipliers are nonzero than
+   components of x are free, which is common when many constraints are
+   nearly active (e.g. a constraint at many sample points), and the dual
+   function is only once differentiable (its Hessian jumps where a component
+   of x(y) reaches a bound).  An active-set (projected) Newton method then
+   needs many iterations to find the multipliers that are zero at the
+   solution, so this is a primal-dual interior point method instead: with
+   multipliers z >= 0 for the bounds y >= lb and the distances s = y - lb,
+   each step is the Newton step for g - z = 0, s z = mu, that is
+       (B^T B + Z/S) dy = -(g - mu/s),
+   with Mehrotra's predictor-corrector choice of mu, a step of at most a
+   fraction of the distance to the bounds, and a backtracking search on the
+   barrier function f - mu sum(log(s)).  It stops when the decrease of f
+   still possible (estimated from the gradient, or from the Newton step) is
+   below dual_opt's ftol_rel/ftol_abs.  When there are more multipliers
+   than free components of x (k), the system is solved through a k-by-k
+   matrix by the Woodbury identity, leaving out the multipliers whose
+   contribution is negligible (most of the inactive constraints).
+
+   The solver needs a dual problem without upper bounds on y: the callers
+   use dual_opt for the subproblems of an infeasible start, whose upper
+   bounds of 1e40 put the dual function at a scale where the barrier terms
+   are lost to rounding. */
+
+#include <stdlib.h>
+#include <math.h>
+#include <string.h>
+#include <float.h>
+
+#include "mma.h"
+#include "nlopt-util.h"
+#include "nlopt-blas.h"
+
+#define MIN(a,b) ((a) < (b) ? (a) : (b))
+#define MAX(a,b) ((a) > (b) ? (a) : (b))
+
+#define ARMIJO 1e-4 /* sufficient decrease factor */
+#define MAXLS 30 /* maximum number of backtracking steps */
+#define FRAC_BOUNDARY 0.995 /* fraction of the step to the boundary */
+#define KAPPA 1e10 /* bound multipliers within [1/KAPPA, KAPPA] mu/s */
+#define INTERIOR 1e-8 /* initial distance from the bounds (times max(y, 1)
+			   for a warm start) */
+#define WEIGHT_MIN 1e-14 /* negligible columns in the Woodbury matrix */
+
+/* Cholesky factorization A = U^T U of the n-by-n symmetric positive
+   definite matrix a (upper triangle, column-major); returns 0 on success */
+static int cholesky(unsigned n, double *a)
+{
+#ifdef NLOPT_HAVE_BLAS
+     blas_int nn = n, info;
+     NLOPT_BLAS(dpotrf)("U", &nn, a, &nn, &info);
+     return info != 0;
+#else
+     unsigned i, j, k;
+     for (j = 0; j < n; ++j) {
+	  double *aj = a + j*n, d;
+	  for (i = 0; i < j; ++i) {
+	       const double *ai = a + i*n;
+	       double s = aj[i];
+	       for (k = 0; k < i; ++k) s -= ai[k] * aj[k];
+	       aj[i] = s / ai[i];
+	  }
+	  d = aj[j];
+	  for (k = 0; k < j; ++k) d -= aj[k] * aj[k];
+	  if (!(d > 0)) return 1;
+	  aj[j] = sqrt(d);
+     }
+     return 0;
+#endif
+}
+
+/* solve U^T U x = b in place, with U from cholesky */
+static void cholesky_solve(unsigned n, const double *u, double *x)
+{
+     blas_int nn = n, one = 1;
+     NLOPT_BLAS(dtrsv)("U", "T", "N", &nn, u, &nn, x, &one);
+     NLOPT_BLAS(dtrsv)("U", "N", "N", &nn, u, &nn, x, &one);
+}
+
+/* upper triangle of the n-by-n matrix a = b^T b (trans = 0) or b b^T
+   (trans = 1), for the k-by-n matrix (trans = 0) or n-by-k matrix
+   (trans = 1) b with leading dimension ldb */
+static void gram(unsigned n, unsigned k, const double *b, unsigned ldb,
+		 int trans, double *a)
+{
+#ifdef NLOPT_HAVE_BLAS
+     blas_int nn = n, kk = k, ld = ldb;
+     double d1 = 1, d0 = 0;
+     NLOPT_BLAS(dsyrk)("U", trans ? "N" : "T", &nn, &kk, &d1, b, &ld, &d0, a, &nn);
+#else
+     unsigned i, j, l;
+     if (!trans) {
+	  for (j = 0; j < n; ++j)
+	       for (i = 0; i <= j; ++i) {
+		    double s = 0;
+		    for (l = 0; l < k; ++l) s += b[l + i*ldb] * b[l + j*ldb];
+		    a[i + j*n] = s;
+	       }
+     }
+     else {
+	  for (j = 0; j < n; ++j)
+	       for (i = 0; i <= j; ++i) a[i + j*n] = 0;
+	  for (l = 0; l < k; ++l) {
+	       const double *bl = b + l*ldb;
+	       for (j = 0; j < n; ++j) {
+		    double blj = bl[j];
+		    double *aj = a + j*n;
+		    for (i = 0; i <= j; ++i) aj[i] += bl[i] * blj;
+	       }
+	  }
+     }
+#endif
+}
+
+/* solve (B^T B + Z/S) dy = r with the factorization in H (see
+   ccsa_dual_newton): directly (nF <= k), or else by the Woodbury identity
+   dy = W r - W B^T (I + B W B^T)^{-1} B W r with W = S/Z in w and the
+   columns K of B scaled by W^{1/2}; t (length k) and c (length nF) are
+   workspace */
+static void newton_solve(unsigned nF, unsigned k, unsigned nk, const double *H,
+			 const double *B, const unsigned *K, const double *w,
+			 const double *r, double *dy, double *t, double *c)
+{
+     blas_int kk = k, nn = nk, one = 1;
+     double d1 = 1, d0 = 0;
+     unsigned l;
+
+     if (nF <= k) {
+	  memcpy(dy, r, sizeof(double) * nF);
+	  cholesky_solve(nF, H, dy);
+	  return;
+     }
+     for (l = 0; l < nF; ++l) dy[l] = w[l] * r[l];
+     if (nk == 0) return;
+     for (l = 0; l < nk; ++l) c[l] = sqrt(w[K[l]]) * r[K[l]];
+     NLOPT_BLAS(dgemv)("N", &kk, &nn, &d1, B, &kk, c, &one, &d0, t, &one);
+     cholesky_solve(k, H, t);
+     NLOPT_BLAS(dgemv)("T", &kk, &nn, &d1, B, &kk, t, &one, &d0, c, &one);
+     for (l = 0; l < nk; ++l) dy[K[l]] -= sqrt(w[K[l]]) * c[l];
+}
+
+/* bound on f(y) - min f by convexity, f(y*) >= f(y) + g^T (y* - y): the
+   components with g > 0 can gain at most g (y - lb), those with g < 0 an
+   unknown amount, estimated as |g| (sum(y - lb) + 1) */
+static double gap_estimate(unsigned nF, const unsigned *F, const double *y,
+			   const double *lb, const double *g)
+{
+     double gap = 0, gneg = 0, ysum = 1;
+     unsigned l;
+     for (l = 0; l < nF; ++l) {
+	  unsigned i = F[l];
+	  if (g[i] > 0) gap += g[i] * (y[i] - lb[i]);
+	  else gneg = MAX(gneg, -g[i]);
+	  ysum += y[i] - lb[i];
+     }
+     return gap + gneg * ysum;
+}
+
+nlopt_result ccsa_dual_newton(unsigned m, nlopt_func f, ccsa_dual_hess hess,
+			      void *f_data, unsigned n, const double *lb,
+			      const double *inactive, double *y, double *minf,
+			      nlopt_opt dual_opt, nlopt_stopping *stop)
+{
+     nlopt_result ret = NLOPT_SUCCESS;
+     nlopt_stopping ds = *stop;
+     int nevals = 0;
+     double *work, *xtol_abs, *g, *gt, *yt, *y0, *z, *r, *dy, *w, *dya, *dza, *dz, *t;
+     double *B = NULL, *H = NULL;
+     unsigned *F, *K, nF = 0, i, l;
+     size_t Hsize = 0;
+     double fy = HUGE_VAL, ymax = 0, d, mu;
+
+     if (m == 0) {
+	  *minf = f(m, y, NULL, f_data);
+	  return NLOPT_SUCCESS;
+     }
+
+     ds.n = m;
+     ds.minf_max = -HUGE_VAL;
+     ds.ftol_rel = nlopt_get_ftol_rel(dual_opt);
+     ds.ftol_abs = nlopt_get_ftol_abs(dual_opt);
+     ds.xtol_rel = nlopt_get_xtol_rel(dual_opt);
+     ds.x_weights = NULL;
+     ds.nevals_p = &nevals;
+     ds.maxeval = nlopt_get_maxeval(dual_opt);
+
+     work = (double *) malloc(sizeof(double) * (12*m + n) + sizeof(unsigned) * 2*m);
+     if (!work) return NLOPT_OUT_OF_MEMORY;
+     g = work;
+     gt = g + m;
+     yt = gt + m;
+     y0 = yt + m;
+     z = y0 + m;
+     r = z + m;
+     dy = r + m;
+     w = dy + m;
+     dya = w + m;
+     dza = dya + m;
+     dz = dza + m;
+     xtol_abs = dz + m;
+     t = xtol_abs + m;
+     F = (unsigned *) (t + n);
+     K = F + m;
+     nlopt_get_xtol_abs(dual_opt, xtol_abs);
+     ds.xtol_abs = xtol_abs;
+     B = (double *) malloc(sizeof(double) * n * m);
+     if (!B) { ret = NLOPT_OUT_OF_MEMORY; goto done; }
+
+     /* the multipliers F that are not held fixed */
+     for (i = 0; i < m; ++i)
+	  if (!(inactive && nlopt_isnan(inactive[i]))) {
+	       F[nF++] = i;
+	       ymax = MAX(ymax, fabs(y[i] - lb[i]));
+	  }
+
+     /* nothing to do if the warm start y is optimal (e.g. y = lb with
+	all the constraint approximations satisfied) */
+     fy = f(m, y, g, f_data);
+     ++nevals;
+     if (gap_estimate(nF, F, y, lb, g) <= MAX(ds.ftol_abs, ds.ftol_rel * fabs(fy))) {
+	  ret = NLOPT_FTOL_REACHED;
+	  goto done;
+     }
+
+     /* move y strictly inside (the method needs s > 0), and start from
+	there or, if that is worse (e.g. after the large multipliers of an
+	infeasible subproblem), from near the bounds.  (hess needs the last
+	evaluation to be at the current y.) */
+     d = INTERIOR * MAX(ymax, 1.0);
+     memcpy(yt, y, sizeof(double) * m);
+     for (l = 0; l < nF; ++l) {
+	  i = F[l];
+	  if (y[i] < lb[i] + d) y[i] = lb[i] + d;
+	  yt[i] = lb[i] + INTERIOR;
+     }
+     {
+	  double fyt = f(m, yt, NULL, f_data);
+	  ++nevals;
+	  fy = f(m, y, g, f_data);
+	  ++nevals;
+	  if (fyt < fy) {
+	       memcpy(y, yt, sizeof(double) * m);
+	       fy = f(m, y, g, f_data);
+	       ++nevals;
+	  }
+     }
+
+     /* bound multipliers on the central path s z = mu */
+     mu = 0;
+     for (l = 0; l < nF; ++l) mu += (y[F[l]] - lb[F[l]]) * fabs(g[F[l]]);
+     mu = MAX(mu / nF, DBL_MIN);
+     for (l = 0; l < nF; ++l) z[l] = mu / (y[F[l]] - lb[F[l]]);
+
+     while (nF > 0) {
+	  double comp = 0, tol, slope = 0, alpha = 1, alpha_z = 1;
+	  double phi, phit, fyt = fy;
+	  unsigned k, nk = 0, ls;
+	  int accepted = 0;
+
+	  for (l = 0; l < nF; ++l) {
+	       i = F[l];
+	       comp += (y[i] - lb[i]) * z[l];
+	  }
+	  tol = MAX(ds.ftol_abs, ds.ftol_rel * fabs(fy));
+	  if (gap_estimate(nF, F, y, lb, g) <= tol) {
+	       ret = NLOPT_FTOL_REACHED;
+	       break;
+	  }
+
+	  /* the Newton matrix B^T B + Z/S, as a Cholesky factor in H if
+	     nF <= k, or else, with W = S/Z (in w), the Cholesky factor of
+	     I + B W B^T computed from the nk columns K with a non-negligible
+	     W |b|^2, stored in B scaled by W^{1/2} (for the Woodbury identity
+	     in newton_solve) */
+	  mu = comp / nF;
+	  for (l = 0; l < nF; ++l) w[l] = z[l] / (y[F[l]] - lb[F[l]]);
+	  k = hess(m, y, nF, F, B, f_data);
+	  if ((size_t) MIN(nF, k) * MIN(nF, k) > Hsize) {
+	       free(H);
+	       Hsize = (size_t) MIN(nF, k) * MIN(nF, k);
+	       H = (double *) malloc(sizeof(double) * Hsize);
+	       if (!H) { ret = NLOPT_OUT_OF_MEMORY; goto done; }
+	  }
+	  if (nF <= k) {
+	       gram(nF, k, B, k, 0, H);
+	       for (l = 0; l < nF; ++l) H[l + l*nF] += w[l];
+	       if (cholesky(nF, H)) { ret = NLOPT_FTOL_REACHED; break; }
+	  }
+	  else {
+	       for (l = 0; l < nF; ++l) {
+		    const double *b = B + l*k;
+		    double b2 = 0, sw;
+		    w[l] = 1 / w[l];
+		    for (i = 0; i < k; ++i) b2 += b[i] * b[i];
+		    if (w[l] * b2 < WEIGHT_MIN) continue;
+		    sw = sqrt(w[l]);
+		    for (i = 0; i < k; ++i) B[i + nk*k] = b[i] * sw;
+		    K[nk++] = l;
+	       }
+	       if (nk > 0) {
+		    gram(k, nk, B, k, 1, H);
+		    for (i = 0; i < k; ++i) H[i + i*k] += 1;
+		    if (cholesky(k, H)) { ret = NLOPT_FTOL_REACHED; break; }
+	       }
+	  }
+
+	  /* Mehrotra's predictor-corrector: the affine step (mu = 0) sets
+	     the centering sigma = (mu_aff / mu)^3 and the second-order
+	     correction of the complementarity s z */
+	  for (l = 0; l < nF; ++l) r[l] = -g[F[l]];
+	  newton_solve(nF, k, nk, H, B, K, w, r, dya, t, dz);
+	  {
+	       double ap = 1, ad = 1, mu_aff = 0;
+	       for (l = 0; l < nF; ++l) {
+		    double sl = y[F[l]] - lb[F[l]];
+		    dza[l] = -z[l] - z[l] * dya[l] / sl;
