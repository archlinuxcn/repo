#!/bin/bash
# Generate the overlayfs layer that hides parts of the x86_64 rootfs managed by
# fex-pacman from FEX-Emu. The layer only contains whiteouts (0/0 character
# devices). FEX-Emu uses the host file for a path that doesn't exist in the
# rootfs, so the host files are used instead of the hidden ones.
#
# Only what's known to belong to the host is hidden, anything else installed in
# the rootfs stays visible:
# * the host state and user data (/home, /var, /tmp, ...),
# * the host identity and system configuration in /etc,
# * data shared with the host that FEX-Emu doesn't merge (a directory in the
#   rootfs is listed without the host files): locales, fonts, icons, themes,
# * the programs of the base system, which are run natively instead, except
#   for the shell and the tools that tell the system apart (e.g. uname).

set -euo pipefail

if (( $# != 2 )); then
  echo "Usage: $0 <rootfs dir> <mask dir>" >&2
  exit 1
fi

root=$(realpath -- "$1")
mask=$2

# Print the paths (relative to the rootfs) to hide, NUL separated.
masked_paths() (
  cd "$root"
  local p pkg dbdir= path
  local -A pkgdirs=()
  local -a deps=()

  for p in {boot,dev,home,media,mnt,proc,root,run,srv,sys,tmp,var} \
           etc/{adjtime,arch-release,bash.bash_logout,bash.bashrc} \
           etc/{ca-certificates,crypttab,default,environment,fstab} \
           etc/{group,gshadow,host.conf,hostname,hosts,inputrc,issue} \
           etc/{locale.conf,localtime,login.defs,machine-id} \
           etc/{makepkg.conf,makepkg.conf.d,motd,mtab,nsswitch.conf} \
           etc/{os-release,pacman.conf,pacman.d,pam.d,passwd,pki,profile} \
           etc/{profile.d,resolv.conf,securetty,security,shadow,shells,skel} \
           etc/{ssl,subgid,subuid,sudoers,sudoers.d,systemd,udev} \
           etc/vconsole.conf \
           usr/lib/locale usr/share/{fonts,icons,themes} \
           usr/lib/fex-emu-host usr/lib/ld-linux-aarch64.so.1; do
    if [[ -e $p || -L $p ]]; then
      printf '%s\0' "$p"
    fi
  done

  # The programs in /usr/bin of the packages base depends on, from the local
  # pacman database of the rootfs.
  while IFS=$'\t' read -r pkg p; do
    pkgdirs[$pkg]=${p%/desc}
  done < <(awk '/^%NAME%$/ { getline; print $0 "\t" FILENAME; nextfile }' \
               var/lib/pacman/local/*/desc 2> /dev/null)
  [[ -n ${pkgdirs[base]-} ]] || return 0
  mapfile -t deps < <(awk '/^%DEPENDS%$/ { while (getline > 0 && $0 != "") print }' \
                          "${pkgdirs[base]}/desc" | sed -E 's/[<>=].*//')
  for pkg in "${deps[@]}"; do
    dbdir=${pkgdirs[$pkg]-}
    [[ -n $dbdir ]] || continue
    while IFS= read -r path; do
      case ${path#usr/bin/} in
        cat|ls|env|sh|bash|file|stat|dirname|realpath|readlink|basename|\
          nproc|uname|arch|ulimit|ldd|ldconfig)
          continue ;;
      esac
      if [[ -e $path || -L $path ]]; then
        printf '%s\0' "$path"
      fi
    done < <(awk '/^%FILES%$/ { while (getline > 0 && $0 != "") print }' \
                 "$dbdir/files" | grep -E '^usr/bin/[^/]+$')
  done
)

# Escape a path for mtree (vis(3) style octal escapes) into $REPLY.
mtree_escape() {
  local LC_ALL=C path=$1 c i
  REPLY=
  if [[ $path != *[![:graph:]]* && $path != *[\\#]* ]]; then
    REPLY=$path
    return
  fi
  for (( i = 0; i < ${#path}; i++ )); do
    c=${path:i:1}
    if [[ $c == [[:graph:]] && $c != [\\#] ]]; then
      REPLY+=$c
    else
      printf -v c '\\%03o' "'$c"
      REPLY+=$c
    fi
  done
}

new=$mask.new
old=$mask.old
rm -rf -- "$new" "$old"
mkdir -p -- "$new"
# libarchive checks the mtree entries against the files relative to the current
# directory, read it from an empty one.
empty=$(mktemp -d)
trap 'rm -rf -- "$empty"' EXIT

# Create all the whiteouts with one bsdtar (mtree input) instead of running
# mknod thousands of times.
{
  echo '#mtree'
  while IFS= read -r -d '' path; do
    mtree_escape "$path"
    printf './%s type=char device=0 mode=0 uid=0 gid=0\n' "$REPLY"
  done < <(masked_paths)
} | bsdtar -cf - -C "$empty" @- | bsdtar -xpf - -C "$new"

if [[ -e $mask ]]; then
  mv -- "$mask" "$old"
fi
mv -- "$new" "$mask"
rm -rf -- "$old"
