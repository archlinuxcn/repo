# AMD Vitis/Vivado, libraries from the depends/optdepends of the AUR vitis and
# vivado packages that aren't already pulled in. Programs (git, zip, hostname,
# ...) are left out since they are hidden from FEX-Emu anyway, the native ones
# on the host are used instead.
libxcrypt-compat
ncurses5-compat-libs
libpfm
libxkbfile libyaml onetbb

