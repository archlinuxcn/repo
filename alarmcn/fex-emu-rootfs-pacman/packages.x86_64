# Packages installed by fex-pacman --init into the x86_64 FEX-Emu rootfs.
# Whitespace separated, '#' starts a comment.
#
# The same as the list of the rootfs image
# (https://github.com/yuyichao/archcn-fex-emu-rootfs/blob/master/packages.x86_64)
# except that the stock mesa is installed instead of mesa-fex-dummy.

base
archlinuxcn-keyring

# The mesa drivers in the mesa-fex-emu-overlay-{x86_64,i386} images used with
# the rootfs image.
mesa lib32-mesa
opencl-mesa lib32-opencl-mesa
vulkan-asahi lib32-vulkan-asahi
vulkan-broadcom lib32-vulkan-broadcom
vulkan-freedreno lib32-vulkan-freedreno
vulkan-intel lib32-vulkan-intel
vulkan-nouveau lib32-vulkan-nouveau
vulkan-panfrost lib32-vulkan-panfrost
vulkan-powervr lib32-vulkan-powervr
vulkan-radeon lib32-vulkan-radeon
vulkan-swrast lib32-vulkan-swrast
vulkan-virtio lib32-vulkan-virtio
vulkan-mesa-layers lib32-vulkan-mesa-layers
vulkan-mesa-implicit-layers lib32-vulkan-mesa-implicit-layers

strace
rsync
lsb-release
dbus lib32-dbus
glibc lib32-glibc
