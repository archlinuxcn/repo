# Maintainer: Yichao Yu

# x86_64 Arch Linux rootfs for FEX-Emu managed with pacman (fex-pacman) instead
# of the prebuilt rootfs image (fex-emu-rootfs-archcn). Packages are installed
# and upgraded in place, so the stock mesa is used directly instead of the
# mesa-fex-emu-overlay-* images. The parts of the rootfs known to belong to the
# host (system configuration, /home, base system programs, ...) are hidden by an
# overlayfs mask. On hosts without 4K pages, which FEX-Emu needs, the scriptlets
# are run in a muvm VM.
# Both muvm and fex-emu-rootfs.service (for FEX-Emu without muvm) stack the
# mask on top of the rootfs.

pkgname=fex-emu-rootfs-pacman
pkgver=3
pkgrel=1
pkgdesc='Arch Linux x86_64 rootfs for FEX-Emu managed with pacman'
arch=(any)
url='https://github.com/yuyichao/archcn-fex-emu-rootfs'
license=('MIT')
backup=(etc/fex-pacman.conf)
install=$pkgname.install
source=(fex-pacman
        fex-pacman.conf
        fex-emu-rootfs-mask
        fex-emu-rootfs-stack
        fex-emu-rootfs.service
        packages.x86_64)
sha256sums=('4b2cd0e9b1be8ad9bba2f98c6c2f0fe5a13090167c07cb99fc34fdf37451b7e6'
            'bcf1c4edbacdb22d98df6b128004c36e1a0f90533050f7c248aeb2665ed86b8e'
            'acf15b5c55bf514ea576b4880ba66f4fadd76a36a26e724bb63f4c749ffc7433'
            '93f8b53b83a6e64bf15b03ad747fd521fb51ed6cd465177b6fc98624aceaa732'
            '519cc6de58b2f9d0f6ef00baa4c1fc9732765a5f16e8a2566798c746393e2950'
            '91f2c46067fb85c899da9c11e8a4dfa3ae9fedcdb828416a47d97100f2f7989f')

package() {
  # Put depends in package() to avoid unnecessary build dependencies
  depends=(fex-emu pacman libarchive util-linux
           archlinux-keyring archlinuxcn-keyring)
  optdepends=('muvm: run x86 programs in a microVM with this rootfs, required on hosts without 4K pages')
  conflicts=(fex-emu-rootfs-archcn fex-emu-rootfs-arch)

  install -Dm755 fex-pacman -t "$pkgdir/usr/bin/"
  install -Dm644 fex-pacman.conf -t "$pkgdir/etc/"
  install -Dm644 packages.x86_64 -t "$pkgdir/usr/share/$pkgname/"
  install -Dm755 fex-emu-rootfs-mask fex-emu-rootfs-stack \
          -t "$pkgdir/usr/lib/fex-emu-rootfs/"
  install -Dm644 fex-emu-rootfs.service -t "$pkgdir/usr/lib/systemd/system/"
}
