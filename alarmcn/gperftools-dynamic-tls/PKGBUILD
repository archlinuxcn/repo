pkgname=gperftools-dynamic-tls
pkgver=2.19.1
pkgrel=1
pkgdesc='Fast, multi-threaded malloc and nifty performance analysis tools'
arch=(aarch64 x86_64)
url='https://github.com/gperftools/gperftools'
license=(BSD-3-Clause)
depends=(
  glibc
  libgcc
  libstdc++
  libunwind
)
makedepends=(
  asciidoctor
  git
)
source=("git+https://github.com/gperftools/gperftools.git#tag=gperftools-$pkgver")
b2sums=(551f79e54a5c8e24d3723a992bae445d85385d366db6fb45a048d958f1ebc1bc2859d1a1ef0eebd5e7a290f1c93ded3b9fe6db9631fb986b955877f8065a30f2)

_prepare() {
  cd gperftools
  autoreconf -fiv
}

prepare() {
  (cd gperftools
  find -type f -exec sed -i -e 's/ABSL_ATTRIBUTE_INITIAL_EXEC//g' {} \;
  find -type f -exec sed -i -e 's/__attribute__ *( *( *tls_model *( *"initial-exec" *) *) *)//g' {} \;)
  _prepare
}

build() {
  cd gperftools
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-frame-pointers \
    --enable-libunwind
  make
}

_check() {
  cd gperftools
  make check
}

package() {
  provides+=(gperftools=$pkgver)
  conflicts+=(gperftools=$pkgver)
  cd gperftools
  make DESTDIR="$pkgdir" install
  install -Dm644 -t "$pkgdir/usr/share/licenses/gperftools/" COPYING
}
