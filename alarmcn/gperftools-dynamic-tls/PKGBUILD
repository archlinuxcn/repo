pkgname=gperftools-dynamic-tls
pkgver=2.19.3
pkgrel=1
pkgdesc='Fast, multi-threaded malloc and nifty performance analysis tools'
arch=(aarch64 x86_64)
url='https://github.com/gperftools/gperftools'
license=(BSD-3-Clause)
depends=(
  glibc
  libgcc
  libstdc++
  libunwind
)
makedepends=(
  asciidoctor
  git
)
source=("git+https://github.com/gperftools/gperftools.git#tag=gperftools-$pkgver")
b2sums=(f40288c53ee886828494270ff1a4f66bceb2d8f30a343238204ddeaaef3a85a247370208f6bfd6aff8f368f2672465c0250a8fd8025bc2dc7e535625345cefcd)

_prepare() {
  cd gperftools
  autoreconf -fiv
}

prepare() {
  (cd gperftools
  find -type f -exec sed -i -e 's/ABSL_ATTRIBUTE_INITIAL_EXEC//g' {} \;
  find -type f -exec sed -i -e 's/__attribute__ *( *( *tls_model *( *"initial-exec" *) *) *)//g' {} \;)
  _prepare
}

build() {
  cd gperftools
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-frame-pointers \
    --enable-libunwind
  make
}

_check() {
  cd gperftools
  make check
}

package() {
  provides+=(gperftools=$pkgver)
  conflicts+=(gperftools=$pkgver)
  cd gperftools
  make DESTDIR="$pkgdir" install
  install -Dm644 -t "$pkgdir/usr/share/licenses/gperftools/" COPYING
}
