pkgname=triforce-lv2
pkgver=0.4.0
pkgrel=1
pkgdesc='a beamformer for Apple Silicon laptops'
arch=('aarch64')
url='http://asahilinux.org'
depends=('lv2')
makedepends=('rust' 'cargo')
license=('MIT')
source=(
  "triforce-lv2-${pkgver}.tar.gz::https://github.com/chadmed/triforce/archive/refs/tags/${pkgver}.tar.gz"
)
sha256sums=('c5b777a3c87bda5a88aeab2bd862324b27f49528455ec81c5fd5220c0c7a4861')

build() {
  cd triforce-${pkgver}
  make
}

package() {
  cd triforce-${pkgver}
  make LIBDIR=/usr/lib DESTDIR="${pkgdir}" install
}
