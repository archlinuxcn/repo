# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>

pkgname=tree-sitter-llvm
pkgver=1.1.0
pkgrel=0
pkgdesc="LLVM grammar for tree-sitter"
arch=('aarch64' 'i686' 'x86_64')
url="https://github.com/benwilliamgraham/tree-sitter-llvm"
license=('MIT')
# groups=('tree-sitter-grammars')
makedepends=('nodejs' 'tree-sitter-cli' 'cmake')
provides=('libtree-sitter-llvm.so')
source=("$pkgname-$pkgver-src.tar.gz::https://github.com/benwilliamgraham/tree-sitter-llvm/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('be4f36ebbff41d5625e8a0347437941573c3653ae51443750cd772dd44b54782')


build() {
  cd "$pkgname-$pkgver"

  rm -rf build
  mkdir build
  cd build
  cmake .. -DCMAKE_INSTALL_PREFIX=/usr
  make VERBOSE=1
}

package() {
  cd "$pkgname-$pkgver"

  make -C build DESTDIR="$pkgdir" install
  install -Dm644 "LICENSE" -t "$pkgdir/usr/share/licenses/tree-sitter-llvm"
  install -Dm644 "README.md" -t "$pkgdir/usr/share/doc/tree-sitter-llvm"

  # https://gitlab.archlinux.org/archlinux/packaging/packages/neovim/-/blob/390a730f1f0e85d48b3e49c69421cc7baeb3e00d/PKGBUILD#L74-76
  install -d "$pkgdir/usr/lib/tree_sitter"
  ln -s "/usr/lib/libtree-sitter-llvm.so" "$pkgdir/usr/lib/tree_sitter/llvm.so"
}
