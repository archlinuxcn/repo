# Maintainer: Hector Martin <marcan@marcan.st>

pkgname=uboot-asahi
_ver=2026.04
_asahirel=2

pkgver=${_ver}.asahi${_asahirel}
pkgrel=1
pkgdesc='U-Boot for Apple Silicon Macs'
_commit_id=asahi-v${_ver}-${_asahirel}
_srcname=u-boot-${_commit_id}
arch=('aarch64')
url='http://asahilinux.org'
license=('MIT' 'GPL2')
makedepends=( bc imagemagick )
source=(
  "u-boot-${_commit_id}.tar.gz::https://github.com/AsahiLinux/u-boot/archive/${_commit_id}.tar.gz"
)
sha256sums=('b3cdcc467afbf6737ad7c87d174daa8eb0dcc212feb275ee56c406c1e084768c')
b2sums=('6eb37d1ffb03a0bd71b69b4e11e266ce4c3183bb1d7360ec2b18c87d94af83c1bac86be8225b14cff3a7af5359fe668f36850db79c1974dd44514929308dd1fd')

prepare() {
  cd "${srcdir}/$_srcname"
  make apple_m1_defconfig
}

build() {
  cd "${srcdir}/$_srcname"
  make
}

package() {
  cd "${srcdir}"

  tgtdir="$pkgdir/usr/lib/asahi-boot"

  install -Dt "$tgtdir" -m644 "$_srcname/u-boot-nodtb.bin"
  install -Dt "$tgtdir/dtb" -m644 "$_srcname/dts/upstream/src/arm64/apple/"t[86]*.dtb
}
