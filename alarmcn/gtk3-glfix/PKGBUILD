pkgname=gtk3-glfix
pkgver=3.24.52
pkgrel=3
epoch=1
pkgdesc="GObject-based multi-platform GUI toolkit (with EGL config fix for Mesa without GLES 1)"
url="https://www.gtk.org/"
arch=(aarch64 x86_64)
provides=("gtk3=$epoch:$pkgver")
conflicts=(gtk3)
license=(LGPL-2.1-or-later)
depends=(
