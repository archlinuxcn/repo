# Maintainer: Hector Martin <marcan@marcan.st>

pkgname=m1n1
pkgver=1.6.1
pkgrel=1
pkgdesc='Asahi Linux bootloader'
arch=('aarch64')
url='http://asahilinux.org'
license=('MIT')
makedepends=(git imagemagick rustup cargo)
source=(
  "git+https://github.com/AsahiLinux/m1n1#tag=v${pkgver}"
)
sha256sums=('1b3ad7e15776f1bc91578907d4890d770a33c8125fd4a179fd078c64dfed2488')
b2sums=('8b11cb95f1876e32de8e9b1eeeda784d4c1d93711ea7de4b7e718c32059e79dc51ea063055e9fd0a71eb18f6323659b13aef628636ed84d87f44cb31559e2e20')

prepare() {
  cd m1n1
  git submodule update --init --recursive
}

build() {
  cd m1n1

  rustup default stable
  rustup target add aarch64-unknown-none-softfloat
  make ARCH= RELEASE=1 -j1
}

package() {
  install -Dt "$pkgdir/usr/lib/asahi-boot" -m644 "m1n1/build/m1n1.bin"
  install -Dm644 m1n1/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
