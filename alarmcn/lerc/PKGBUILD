# Maintainer: Sylvain POULAIN <sylvain dot poulain at giscan dot com>

pkgname=lerc
pkgver=4.3.0
pkgrel=1
pkgdesc='Limited Error Raster Compression library'
arch=(aarch64 x86_64)
url='https://github.com/Esri/lerc'
license=('Apache-2.0')
makedepends=('cmake')
source=("https://github.com/Esri/lerc/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('60b9d68b0e0478020b2940a7ea2d3d735db2c60c19fb808c6b672be55166e031ba59e999228b91dacabfaf578c288125d76920106f0829658f4c195d52a4da60')

build() {
  cd ${pkgname}-${pkgver}

  [[ -d build ]] || mkdir build

  cd build

  cmake -G "Unix Makefiles" .. \
        -DCMAKE_BUILD_TYPE="Release" \
        -DCMAKE_INSTALL_PREFIX=/usr/
  make
}

package() {
  cd ${pkgname}-${pkgver}/build

  make DESTDIR="${pkgdir}" install
}
