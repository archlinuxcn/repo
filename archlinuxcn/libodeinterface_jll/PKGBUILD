pkgname=libodeinterface_jll
pkgver=0.5.2
_commit=7df331313c72e4aa213febedcd527ee4dc654d1f
pkgrel=1
pkgdesc="ODEInterface.jl"
url="https://github.com/luchr/ODEInterface.jl.git"
arch=('aarch64' 'armv7h' 'x86_64')
license=('MIT')
makedepends=(git gcc-fortran)
depends=(julia-git)
source=("git+https://github.com/luchr/ODEInterface.jl.git#commit=$_commit")
sha256sums=('884fbfcc63cd3c7ded76adb8edd9b9621574ef76b6a12c419c255209700d8760')

prepare() {
  rm -rf bin
  mkdir bin
  cat > bin/gfortran <<EOF
exec /usr/bin/gfortran -ftrampoline-impl=heap -Wl,-z,noexecstack -g -O2 -ffile-prefix-map=${srcdir}=${DBGSRCDIR:-/usr/src/debug} $FFLAGS "\$@"
EOF
  chmod +x bin/gfortran
}

build() {
  cd ODEInterface.jl

  PATH="${srcdir}/bin:${PATH}" ODEINTERFACE_IGNORE_JLL=1 julia deps/build.jl
}

package() {
  cd ODEInterface.jl

  install -dm755 "${pkgdir}/usr/lib/julia/odeinterface/"
  install -Dm755 src/*.so "${pkgdir}/usr/lib/julia/odeinterface/"
}
