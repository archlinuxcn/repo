# Maintainer: Butui Hu <hot123tea123@gmail.com>

_pkgname=hydra
pkgname=python-hydra-core
pkgver=1.4.0rc1
pkgrel=1
pkgdesc='A framework for elegantly configuring complex applications'
arch=('any')
url='https://hydra.cc'
license=('MIT')
depends=(
  python-omegaconf
  python-packaging
)
makedepends=(
  antlr4
  python-build
  python-installer
  python-setuptools
  python-wheel
)
source=("${_pkgname}-${pkgver}.tar.gz::https://github.com/facebookresearch/hydra/archive/refs/tags/v${pkgver}.tar.gz")
sha512sums=('6bca32c3d84b93f18806fad67465770f460d9585a39b5b31ba56602f489c36d61dc60ad2c58d78495cba0a005be532723a20e73cec593eef96bf2b9350433dff')

prepare() {
  # use system antlr4
  sed -i 's#join(root_dir, "bin/antlr-4.9.3-complete.jar")#"/usr/share/java/antlr-complete.jar"#' "${_pkgname}-${pkgver}/build_helpers/build_helpers.py"
}
build() {
  cd "${_pkgname}-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${_pkgname}-${pkgver}"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
# vim:set ts=2 sw=2 et:
