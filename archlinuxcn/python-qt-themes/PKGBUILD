# Maintainer: RocketDev <ma2014119@outlook.com>
_pkgbase='qt-themes'
pkgname=python-$_pkgbase
pkgver=0.4.1
pkgrel=1
pkgdesc='A collection of themes for Qt in Python'
arch=('any')
url='https://github.com/beatreichenbach/qt-themes'
license=('MIT')
depends=(
    'python'
    'python-qtpy' # qtpy first, then fallback to pyside6, pyside2
)
makedepends=(
    'python-build'
    'python-setuptools'
    'python-installer'
    'python-wheel'
)
source=(
    "$_pkgbase-$pkgver.tar.gz::https://github.com/beatreichenbach/qt-themes/archive/v$pkgver.tar.gz"
)
b2sums=('d6d94f1e778f68d88c86facd92ddcaf6a19d34fa93388269a8b02ca5ce84f94fffd5ecb184aa31e8193e65ee97a9ccef109de2140038b3f039f96fb98b89e2f5')

build() {
    cd "$srcdir/$_pkgbase-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$_pkgbase-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
