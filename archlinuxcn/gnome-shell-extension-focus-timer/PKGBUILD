# Maintainer: Gavin Luo <lunt.luo@gmail.com>

pkgname=gnome-shell-extension-focus-timer
pkgver=6
pkgrel=1
pkgdesc='GNOME Shell integration for the Focus Timer app'
arch=('any')
url="https://github.com/focustimerhq/gnome-shell-extension-focus-timer"
license=('GPL-3.0-only')
depends=('gnome-shell>=48' 'dconf' 'focus-timer')
makedepends=('meson')
source=("${pkgver}.tar.gz"::"${url}/archive/refs/tags/${pkgver}.tar.gz")
b2sums=('a95bc1a2eda1240df6930e919f844143721e7a5a93216f127a3145cff14c7b17a7b2a9ada7a1615974df2cfb2cfdd4b3e1a55ad421b0a9669800dccd53b1b76a')

build() {
    cd "${pkgname}-${pkgver}"
    arch-meson build
    ninja -C build
}

package() {
    cd "${pkgname}-${pkgver}"

    DESTDIR="$pkgdir" ninja -C build install
}
