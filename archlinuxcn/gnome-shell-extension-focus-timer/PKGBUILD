# Maintainer: Gavin Luo <lunt.luo@gmail.com>

pkgname=gnome-shell-extension-focus-timer
pkgver=4
pkgrel=1
pkgdesc='GNOME Shell integration for the Focus Timer app'
arch=('any')
url="https://github.com/focustimerhq/gnome-shell-extension-focus-timer"
license=('GPL-3.0-only')
depends=('gnome-shell>=48' 'dconf' 'focus-timer')
makedepends=('meson')
source=("${pkgver}.tar.gz"::"${url}/archive/refs/tags/${pkgver}.tar.gz")
b2sums=('0b483a86710d0b98545b6f6f2713a30f959465b09c48993b5189ba27799a84db9aa0b3c18cf8c1ffcbea1cc19abd6985b244611cbbe88fe94c86d3ae293ac8b2')

build() {
    cd "${pkgname}-${pkgver}"
    arch-meson build
    ninja -C build
}

package() {
    cd "${pkgname}-${pkgver}"

    DESTDIR="$pkgdir" ninja -C build install
}
