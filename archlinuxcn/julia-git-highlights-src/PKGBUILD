pkgname=julia-git-highlights-src
pkgver=0.6.3
_commit=ef33bec0cc90f935029b4140ccc3d8d645850e83
pkgrel=1
pkgdesc="Highlights.jl"
url="https://github.com/JuliaDocs/Highlights.jl.git"
arch=('any')
license=('MIT')
makedepends=(git julia-pkg-scripts wget)
depends=(julia-git)
source=("git+https://github.com/JuliaDocs/Highlights.jl.git#commit=$_commit")
sha256sums=('7707780b01c7dceaac88adf39f8faa8b35735925d093f04541f7bc72e905b850')

build() {
  cd Highlights.jl

  local url
  url=$(sed -ne '/url *= *".*"/{s/ *url *= *"\(.*\)" */\1/p;q}' Artifacts.toml)

  wget -O gogh.tar.gz "$url"

  (
    rm -rf Gogh/
    mkdir Gogh/
    cd Gogh/
    tar xf ../gogh.tar.gz
    rm ../gogh.tar.gz
  )

  sed -i -e 's|Artifacts.artifact"Gogh"|joinpath(@__DIR__, "../Gogh")|' src/themes.jl
}

package() {
  cd Highlights.jl

  JULIA_INSTALL_SRCPKG=1 . /usr/lib/julia/julia-install-pkg.sh Highlights "${pkgdir}" "${pkgname}" julia-git
}
