# Maintainer: Kimiblock Moe

pkgname=tsukimi-portable
pkgver=158.0
pkgrel=1
epoch=1
pkgdesc="Tsukimi sandboxed by portable"
arch=('x86_64')
url="https://github.com/Kraftland/portable"
license=('GPL-3.0-or-later')
groups=()
provides=(tsukimi)
options=(!debug !strip)
conflicts=("tsukimi")

optdepends=()

makedepends+=(tsukimi portable-packer)

checkdepends=()

source=(
	config.toml
	desktop.file
)

depends=(
	'dconf'
	'fontconfig'
	'glib2'
	'glibc'
	'graphene'
	'gstreamer'
	'gtk4'
	'hicolor-icon-theme'
	'lcms2'
	'libadwaita'
	'libgcc'
	'libseccomp'
	'mpv'
	'pango'
	'portable'
)


md5sums=('ef9fbe1934606aeda2c6e94cac620723'
         '690d9e3d3104e1b668487a82e3f9889f')

function pkgver() {
	export LC_ALL=C
	pacman -Si tsukimi | grep Version | awk '{print $NF}' | cut -d'-' -f1
}

function package() {
	depends+=("portable")

	export pkgdir
	export pkgname
	export srcdir
	portable-packer \
		-v \
		--distro arch \
		--mode copy tsukimi \
		--hash true \
		--config-ng "${srcdir}/config.toml" \
		--desktop-file "${srcdir}/desktop.file"
}
