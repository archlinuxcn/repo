prepare() {
  cd gtk
  git apply -3 ../everyx-280065f977ab1032db58f35538fdd8f9d4419503.patch
  git apply -3 ../everyx-64b9e82ba888000ac3ae5d9332f4e428acfa5dff.patch
  git apply -3 ../everyx-080024237eb63ccca982ad4c866ea93974e0d1e4.patch
  git apply -3 ../everyx-db10c5661143b0035a61bd198b9f130b51f9d8a5.patch
  git apply -3 ../everyx-e75432c039f628b4a3085a822b5b1e5171a9b2a9.patch
  git apply -3 ../everyx-8c4cdd8b6950e0424fdf67b1542dd54002a374f5.patch
  git apply -3 ../everyx-0ccfedb9234d744098746bce6544c8ed110419db.patch
}

build() {
  local meson_options=(
    -D broadway-backend=true
    -D cloudproviders=enabled
    -D colord=enabled
    -D build-demos=false
    -D build-examples=false
    -D build-tests=false
    -D build-testsuite=false
    -D documentation=false
    -D introspection=enabled
    -D man-pages=true
    -D sysprof=enabled
    -D tracker=enabled
  )

  CFLAGS+=" -DG_DISABLE_CAST_CHECKS"
  arch-meson gtk build "${meson_options[@]}"
  meson compile -C build
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package() {
  optdepends=('evince: Default print preview command')
  provides+=(libgtk-4.so)

  meson install -C build --destdir "$pkgdir"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/gtk-4.0/settings.ini" <<END
[Settings]
gtk-icon-theme-name = Adwaita
gtk-theme-name = Adwaita
gtk-font-name = Adwaita Sans 11
END

  install -Dt "$pkgdir/usr/share/libalpm/hooks" -m644 gtk4-querymodules.hook
  install -D gtk4-querymodules.script "$pkgdir/usr/share/libalpm/scripts/gtk4-querymodules"

  cd "$pkgdir"

  # Built by GTK 4, shared with GTK 3
  _pick guic usr/bin/gtk4-update-icon-cache
  _pick guic usr/share/man/man1/gtk4-update-icon-cache.1
}

