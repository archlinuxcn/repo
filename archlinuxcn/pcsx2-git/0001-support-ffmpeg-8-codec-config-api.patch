+static const AVPixelFormat* GetSupportedPixelFormats(const AVCodec* codec)
+{
+#if LIBAVCODEC_VERSION_MAJOR >= 62
+	const void* formats = nullptr;
+	return (wrap_avcodec_get_supported_config(nullptr, codec, AV_CODEC_CONFIG_PIX_FORMAT, 0, &formats, nullptr) >= 0) ?
+		static_cast<const AVPixelFormat*>(formats) : nullptr;
+#else
+	return codec->pix_fmts;
+#endif
+}
+
+static const AVSampleFormat* GetSupportedSampleFormats(const AVCodec* codec)
+{
+#if LIBAVCODEC_VERSION_MAJOR >= 62
+	const void* formats = nullptr;
+	return (wrap_avcodec_get_supported_config(nullptr, codec, AV_CODEC_CONFIG_SAMPLE_FORMAT, 0, &formats, nullptr) >= 0) ?
+		static_cast<const AVSampleFormat*>(formats) : nullptr;
+#else
+	return codec->sample_fmts;
+#endif
+}
