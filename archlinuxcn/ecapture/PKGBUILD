pkgname=ecapture
pkgver=2.9.0
pkgrel=1
pkgdesc="Capture SSL/TLS plaintext with eBPF"
arch=(x86_64)
url="https://ecapture.cc"
license=("Apache-2.0")
provides=("ecapture")
conflicts=("ecapture-bin")
source=("${pkgname}::git+https://github.com/gojue/ecapture.git#tag=v${pkgver}")
b2sums=('786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce')

depends=(glibc)
makedepends=(
    go
    git
    bpf
    linux
    linux-headers
    libelf
    clang
    llvm
    pkgconf
)

build() {
    cd "${srcdir}/${pkgname}"
    UNAME_R=$(cat "/usr/src/linux/version")
    HOST_VERSION_SHORT=$(echo "${UNAME_R}" | cut -d'-' -f 1)
    make "UNAME_R=${UNAME_R}" "HOST_VERSION_SHORT=${HOST_VERSION_SHORT}" core
}

package() {
    cd "${srcdir}/${pkgname}"
    install -Dm755 "bin/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
    install -Dm644 "README.md" "README-zh_Hans.md" -t "${pkgdir}/usr/share/doc/${pkgname}"
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
