pkgname=julia-git-gumbo_jll-src
pkgver=0.10.2+0
_commit=ee01ae064c9be3abd6f0fc321854b88307645aae
pkgrel=1
pkgdesc="Gumbo_jll.jl"
url="https://github.com/JuliaBinaryWrappers/Gumbo_jll.jl.git"
arch=('any')
license=('MIT')
makedepends=(git julia-pkg-scripts)
depends=(julia-git gumbo-parser)
source=("git+https://github.com/JuliaBinaryWrappers/Gumbo_jll.jl.git#commit=$_commit"
        jll.toml)
sha256sums=('ded641b066b996bdc12a5ef77047d737e132378408bca45d975e1edfc281f430'
            '70f29d8a8f8290ac2843437a969b1095ffc5c5405951879234eb442d94a43274')

build() {
  cd Gumbo_jll.jl

  julia /usr/lib/julia/julia-gen-jll.jl Gumbo_jll ../jll.toml
}

package() {
  cd Gumbo_jll.jl

  JULIA_INSTALL_SRCPKG=1 . /usr/lib/julia/julia-install-pkg.sh Gumbo_jll "${pkgdir}" "${pkgname}" julia-git
}
