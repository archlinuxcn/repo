# Contributor: HurricanePootis <hurricanepootis@protonmail.com>
# Contributor: Marco Rubin <marco.rubin@protonmail.com>

pkgname=ryujinx-git
pkgver=4871.a61a4268
pkgrel=1
pkgdesc='Experimental Nintendo Switch Emulator written in C#'
url='https://ryujinx.app'
license=('MIT')
arch=('x86_64')
depends=('dotnet-runtime-10.0' 'gcc-libs' 'zlib' 'sdl3' 'fontconfig'
         'libsm' 'libx11' 'libxi' 'libxrandr' 'vulkan-icd-loader')
makedepends=('desktop-file-utils' 'dotnet-sdk-10.0' 'git')
optdepends=('openal: OpenAL audio backend' 'libsoundio: libsoundio audio backend')
provides=('ryujinx')
conflicts=('ryujinx')
options=('!strip' '!debug')
source=('ryubing::git+https://git.ryujinx.app/projects/Ryubing.git')
sha256sums=('SKIP')

pkgver() {
  cd ryubing
  printf '%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd ryubing
  # Use Arch's .NET 10 SDK feature band.
  sed -i 's/"version": "[^"]*"/"version": "10.0.100"/' global.json
}

build() {
  export DOTNET_CLI_HOME="$srcdir/dotnet-cli"
  export NUGET_PACKAGES="$srcdir/nuget-packages"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1

  dotnet publish ryubing/src/Ryujinx/Ryujinx.csproj \
    --configuration Release --runtime linux-x64 --self-contained false \
    --disable-build-servers \
    -p:PublishSingleFile=false -p:PublishTrimmed=false \
    -p:ExtraDefineConstants=DISABLE_UPDATER \
    --output "$srcdir/publish"
}

package() {
  install -dm755 "$pkgdir/usr/lib/ryujinx" "$pkgdir/usr/bin"
  cp -a "$srcdir/publish/." "$pkgdir/usr/lib/ryujinx/"
  ln -s /usr/lib/ryujinx/Ryujinx "$pkgdir/usr/bin/ryujinx"

  install -Dm644 ryubing/distribution/linux/app.ryujinx.Ryujinx.desktop \
    "$pkgdir/usr/share/applications/ryujinx.desktop"
  desktop-file-edit --set-key=Exec --set-value='ryujinx %f' \
    --set-icon=ryujinx "$pkgdir/usr/share/applications/ryujinx.desktop"
  install -Dm644 ryubing/distribution/misc/Logo.png \
    "$pkgdir/usr/share/pixmaps/ryujinx.png"
  install -Dm644 ryubing/distribution/linux/mime/Ryujinx.xml \
    "$pkgdir/usr/share/mime/packages/Ryujinx.xml"
  install -Dm644 ryubing/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
