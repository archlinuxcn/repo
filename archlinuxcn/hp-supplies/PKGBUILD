# Maintainer: LondyGhost <londyghost@users.noreply.github.com>

pkgname=hp-supplies
pkgver=1.2.2
pkgrel=1
pkgdesc='HP 打印机耗材与用量监控（LEDM over USB，无需 HPLIP）'
arch=('x86_64')
url='https://github.com/LondyGhost/hp-supplies'
license=('MIT')
depends=('gtk3' 'libusb')
makedepends=('make' 'gcc' 'pkgconf')
install=hp-supplies.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('be6822a8ac172957df5b4debea13c910d1c13c22cbee2e2fa7ecd743e798cdc1')

build() {
  cd "$pkgname-$pkgver"
  make APP_VERSION="$pkgver-$pkgrel"
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr APP_VERSION="$pkgver-$pkgrel"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
