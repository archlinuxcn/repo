# Maintainer: LondyGhost <476729421@qq.com>

pkgname=hp-supplies
pkgver=1.2.3
pkgrel=1
pkgdesc='HP 打印机耗材与用量监控（LEDM over USB，无需 HPLIP）'
arch=('x86_64')
url='https://github.com/LondyGhost/hp-supplies'
license=('MIT')
depends=('gtk3' 'libusb')
makedepends=('make' 'gcc' 'pkgconf')
options=(!debug)
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  make APP_VERSION="$pkgver-$pkgrel"
}

package() {
  cd "$pkgname"
  make install DESTDIR="$pkgdir" PREFIX=/usr APP_VERSION="$pkgver-$pkgrel"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
