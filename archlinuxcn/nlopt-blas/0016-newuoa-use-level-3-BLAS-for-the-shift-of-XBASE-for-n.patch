@@ -48,6 +48,10 @@ void   NLOPT_BLAS(dormr2)(const char* side, const char* trans, const blas_int* m
    callers keep their own loops for the built-in case. */
 void   NLOPT_BLAS(dger)(const blas_int* m, const blas_int* n, const double* alpha, const double* x, const blas_int* incx, const double* y, const blas_int* incy, double* a, const blas_int* lda);
 void   NLOPT_BLAS(dgemm)(const char* transa, const char* transb, const blas_int* m, const blas_int* n, const blas_int* k, const double* alpha, const double* a, const blas_int* lda, const double* b, const blas_int* ldb, const double* beta, double* c, const blas_int* ldc);
+void   NLOPT_BLAS(dsyrk)(const char* uplo, const char* trans, const blas_int* n, const blas_int* k, const double* alpha, const double* a, const blas_int* lda, const double* beta, double* c, const blas_int* ldc);
+void   NLOPT_BLAS(dsyr2k)(const char* uplo, const char* trans, const blas_int* n, const blas_int* k, const double* alpha, const double* a, const blas_int* lda, const double* b, const blas_int* ldb, const double* beta, double* c, const blas_int* ldc);
+void   NLOPT_BLAS(dspmv)(const char* uplo, const blas_int* n, const double* alpha, const double* ap, const double* x, const blas_int* incx, const double* beta, double* y, const blas_int* incy);
+void   NLOPT_BLAS(dspr2)(const char* uplo, const blas_int* n, const double* alpha, const double* x, const blas_int* incx, const double* y, const blas_int* incy, double* ap);
 #else
