diff --git a/src/algs/newuoa/newuoa.c b/src/algs/newuoa/newuoa.c
index 87e74fb..adca0cb 100644
--- a/src/algs/newuoa/newuoa.c
+++ b/src/algs/newuoa/newuoa.c
@@ -1608,6 +1608,106 @@ static void update_(int *n, int *npt, double *bmat,
 /*************************************************************************/
 /* newuob.f */
 
+#ifdef NLOPT_HAVE_BLAS
+/* The shift of XBASE by XOPT in NEWUOB (labels L120-L200, before XBASE and
+   XOPT themselves are updated), with level-2/3 BLAS: the per-K rank-two
+   (L140) and rank-one (L180) updates of the lower triangle of BMAT(NPT+1:,:)
+   become DSYR2K and DSYRK, the per-K products with ZMAT (L160, L170) DGEMM,
+   and the updates of GQ and HQ DSPMV and DSPR2.  Arrays are 0-based here;
+   W and VLAG are left as the loops leave them.  Returns 0, without changing
+   anything, if it cannot allocate its workspace.  It is kept out of line:
+   inlined into NEWUOB, it slowed down the iterations that do not shift
+   XBASE. */
+#ifdef __GNUC__
+__attribute__((noinline))
+#endif
+static int shift_xbase_blas(int n, int npt, int ndim, int idz, double *xpt,
+			    double *bmat, const double *zmat, const double *pq,
+			    double *gq, double *hq, const double *xopt,
+			    double xoptsq, double *w, double *vlag)
+{
+    const int nptm = npt - n - 1;
+    const double half = .5, tempq = xoptsq * .25;
+    blas_int nn = n, np_ = npt, nm = nptm, ldb = ndim, one = 1, nneg = idz - 1,
+	npos = nptm - (idz - 1);
+    double d1 = 1., d0 = 0., dm1 = -1.;
+    double *xw, *wz, *vl, *sumz, *s = w + npt, *bbot = bmat + npt;
+    int i, j, k;
+
+    xw = (double *) malloc(sizeof(double) * ((size_t) npt * n + (size_t) npt * nptm
+					     + (size_t) n * nptm + nptm));
+    if (!xw) return 0;
+    wz = xw + (size_t) npt * n;
+    vl = wz + (size_t) npt * nptm;
+    sumz = vl + (size_t) n * nptm;
+
+    /* The changes to BMAT that do not depend on ZMAT: S = XPT XOPT,
+       GQ += XPT^T (PQ .* S), XPT -= XOPT/2, and with the rows
+       S(K) XPT(K,:) + TEMPQ XOPT^T of XW, the lower triangle of
+       BMAT(NPT+1:,:) += BMAT(1:NPT,:)^T XW + XW^T BMAT(1:NPT,:). */
+    NLOPT_BLAS(dgemv)("N", &np_, &nn, &d1, xpt, &np_, xopt, &one, &d0, s, &one);
+    for (k = 0; k < npt; ++k) wz[k] = pq[k] * s[k];
+    NLOPT_BLAS(dgemv)("T", &np_, &nn, &d1, xpt, &np_, wz, &one, &d1, gq, &one);
+    for (k = 0; k < npt; ++k) s[k] -= half * xoptsq;
+    for (j = 0; j < n; ++j) {
+	double *xptj = xpt + (size_t) j * npt, *xwj = xw + (size_t) j * npt;
+	for (k = 0; k < npt; ++k) {
+	    xptj[k] -= half * xopt[j];
+	    xwj[k] = s[k] * xptj[k] + tempq * xopt[j];
+	}
+    }
+    NLOPT_BLAS(dsyr2k)("L", "T", &nn, &np_, &d1, bmat, &ldb, xw, &np_, &d1, bbot, &ldb);
+
+    /* The changes that depend on ZMAT: with WZ(:,K) = S .* ZMAT(:,K) and
+       VL = XPT^T WZ + TEMPQ XOPT SUM(ZMAT)^T, BMAT(1:NPT,:) += ZMAT D VL^T and
+       the lower triangle of BMAT(NPT+1:,:) += VL D VL^T, where D = diag(-1)
+       for the first IDZ-1 columns of ZMAT and diag(1) for the others. */
+    for (k = 0; k < nptm; ++k) {
+	const double *zk = zmat + (size_t) k * npt;
+	double *wzk = wz + (size_t) k * npt, sz = 0;
+	for (i = 0; i < npt; ++i) {
+	    sz += zk[i];
+	    wzk[i] = s[i] * zk[i];
+	}
+	sumz[k] = sz;
+    }
+    NLOPT_BLAS(dgemm)("T", "N", &nn, &nm, &np_, &d1, xpt, &np_, wz, &np_, &d0, vl, &nn);
+    for (k = 0; k < nptm; ++k) {
+	const double *zk = zmat + (size_t) k * npt;
+	double *vlk = vl + (size_t) k * n, *wzk = wz + (size_t) k * npt;
+	for (j = 0; j < n; ++j) vlk[j] += tempq * sumz[k] * xopt[j];
+	for (i = 0; i < npt; ++i) wzk[i] = k < idz - 1 ? -zk[i] : zk[i];
+    }
+    NLOPT_BLAS(dgemm)("N", "T", &np_, &nn, &nm, &d1, wz, &np_, vl, &nn, &d1, bmat, &ldb);
+    if (nneg > 0)
+	NLOPT_BLAS(dsyrk)("L", "N", &nn, &nneg, &dm1, vl, &nn, &d1, bbot, &ldb);
+    if (npos > 0)
+	NLOPT_BLAS(dsyrk)("L", "N", &nn, &npos, &d1, vl + (size_t) nneg * n, &nn, &d1, bbot, &ldb);
+    if (nptm > 0) {
+	const double *zl = zmat + (size_t) (nptm - 1) * npt;
+	for (i = 0; i < npt; ++i) w[i] = s[i] * zl[i];
+	memcpy(vlag, vl + (size_t) (nptm - 1) * n, sizeof(double) * n);
+    }
+
+    /* Complete the shift: W = XPT^T PQ, XPT -= XOPT/2, GQ += HQ XOPT,
+       HQ += W XOPT^T + XOPT W^T, and BMAT(NPT+1:,:) symmetric again. */
+    NLOPT_BLAS(dgemv)("T", &np_, &nn, &d1, xpt, &np_, pq, &one, &d0, w, &one);
+    for (j = 0; j < n; ++j) {
+	double *xptj = xpt + (size_t) j * npt;
+	for (k = 0; k < npt; ++k) xptj[k] -= half * xopt[j];
+    }
+    NLOPT_BLAS(dspmv)("U", &nn, &d1, hq, xopt, &one, &d1, gq, &one);
+    NLOPT_BLAS(dspr2)("U", &nn, &d1, w, &one, xopt, &one, hq);
+    for (j = 0; j < n; ++j)
+	for (i = 0; i < j; ++i)
+	    bbot[i + (size_t) j * ndim] = bbot[j + (size_t) i * ndim];
+
+    free(xw);
+    return 1;
+}
+#endif
+
+
