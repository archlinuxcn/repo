 	tempq = xoptsq * .25;
 	i__1 = *npt;
 	for (k = 1; k <= i__1; ++k) {
@@ -1961,24 +2070,6 @@ L120:
 /* L150: */
 		w[i__] = w[*npt + i__] * zmat[i__ + k * zmat_dim1];
