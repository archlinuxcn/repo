+# opus-rs 0.4.0 (pi-voice -> opus) enables opusic-sys' `bundled` default,
+# building a static libopus from vendored C sources via CMake. The vendored
+# copy defaults to dynamic linking against the system libopus.
+opusic-sys = { path = "crates/vendor/opusic-sys" }
 
 [profile.release]
 opt-level = 3
