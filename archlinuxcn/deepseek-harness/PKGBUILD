# Maintainer: RocketDev <ma2014119@outlook.com>

pkgname=deepseek-harness
pkgver=0.1.7.rc1
_npmver=$(sed -E 's/\.([a-z]+)([0-9]+)$/-\1.\2/' <<< "$pkgver")
pkgrel=1
pkgdesc="An open-source agent harness developed by DeepSeek AI"
arch=(x86_64)
url="https://deepseek.com/harness"
license=(MIT)
depends=(
    glibc
    libstdc++
    libgcc
    sh
    ripgrep
    nodejs
)
optdepends=("pnpm: Plugin manager")
makedepends=("npm")
options=('!strip')
source=("$pkgname-$pkgver.tgz::https://registry.npmjs.org/@deepseek-ai/dsh/-/dsh-${_npmver}.tgz")
noextract=("$pkgname-$pkgver.tgz")
b2sums=('d50356a1aaece12e4278f55458e213ea55a0904b6336e9858cc64b96e5fb1e369f7dd8a2a7dbde6c27e1c0ddd073adb895664fb27ccd44fff91814a8c3095ba7')

package() {
    npm install -g --prefix "$pkgdir/usr" --cache "$srcdir/npm-cache" \
        --no-fund \
        --no-audit \
        --allow-scripts=@deepseek-ai/dsh-subprocess-local,koffi,node-pty,@google/genai,protobufjs \
        $pkgname-$pkgver.tgz
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    ln -sf /usr/lib/node_modules/@deepseek-ai/dsh/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    find "$pkgdir/usr" -type f -name rg -exec ln -sf /usr/bin/rg '{}' \;
    find "$pkgdir/usr" -type d -exec chmod 755 {} +
    chown -R root:root "$pkgdir"
}
