pkgname=julia-git-gpucompiler-src
pkgver=1.23.0
_commit=3c19d2fb778bb5b9e58570cc73622c2c8fb2a536
pkgrel=2
pkgdesc="GPUCompiler.jl"
url="https://github.com/JuliaGPU/GPUCompiler.jl.git"
arch=('any')
license=('MIT')
makedepends=(git julia-pkg-scripts)
depends=(julia-git)
source=("git+https://github.com/JuliaGPU/GPUCompiler.jl.git#commit=$_commit"
        0001-Backport-Julia-master-fix.patch)
sha256sums=('669815046b7c745c0db4621b4cd215d32e680423d9fddfde3e3c5cbcff07eac0'
            '99da88f07195bcd92150e094442650a705e861f4c9076c962e850d9c063a3d72')

prepare() {
  cd GPUCompiler.jl

  patch -Np1 --no-backup-if-mismatch < ../0001-Backport-Julia-master-fix.patch
}

package() {
  cd GPUCompiler.jl

  JULIA_INSTALL_SRCPKG=1 . /usr/lib/julia/julia-install-pkg.sh GPUCompiler "${pkgdir}" "${pkgname}" julia-git
}
