# Maintainer: Kimiblock Moe

pkgname=86box-portable
pkgver=6.0
pkgrel=1
epoch=1
pkgdesc="86Box sandboxed by portable"
arch=('x86_64')
url="https://github.com/Kraftland/portable"
license=('GPL-2.0-or-later' 'CC-BY-4.0')
groups=()
provides=(86box)
options=(!debug !strip)
conflicts=("86box")

depends=(
	'portable'
	'fluidsynth'
	'hicolor-icon-theme'
	'libserialport'
	'libslirp'
	'openal'
	'qt6-base'
	'rtmidi'
	'sdl2'
	'freetype2'
	'gcc-libs'
	'glib2'
	'glibc'
	'libevdev'
	'libglvnd'
	'libpng'
	'libsndfile'
	'libx11'
	'libxcb'
	'libxext'
	'libxi'
	'libxkbcommon-x11'
	'libxkbcommon'
	'zlib'
)

makedepends=(
	'cmake'
	'extra-cmake-modules'
	'ninja'
	'qt6-tools'
	'vde2'
	'vulkan-headers'
	'git'
)
optdepends=(
	'86box-roms: ROM files'
	'discord-game-sdk: Discord Rich Presence'
	'ghostscript: Printing with Generic PostScript Printer'
	'libpcap: Networking not limited to TCP/IP'
)
options=(
	'!buildflags'
)

checkdepends=()

source=(
	config.toml
	desktop.file

	"source::git+https://github.com/86Box/86Box.git#tag=v${pkgver}"
	"assets::git+https://github.com/86Box/assets.git#tag=v${pkgver}"
)


md5sums=('c47943c9d67ff1ad1d2787e7325f8f35'
         '67906c0629e5ee4e1fef7634e3fda431'
         'd0e3a36660b2169e81b17889ebffd95f'
         '3f4d5a973129a686037b9db4629a2c31')

build() {
	LDFLAGS='-z now -z shstk' \
		cmake \
		-S"source" \
		-Bbuild \
		--preset \
		regular \
		--toolchain \
		"cmake/flags-gcc-${CARCH}.cmake" \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DUSE_QT6=on
	cmake \
		--build \
		build
}

function package() {
	DESTDIR="${pkgdir}" \
		cmake \
		--build \
		"${srcdir}/build" \
		--target install
	for i in 16x16 20x20 24x24 32x32 48x48 64x64 72x72 128x128 256x256; do
		install \
			-vDm644 \
			"${srcdir}/source/src/unix/assets/${i}/net.86box.86Box.png" \
			-t \
			"${pkgdir}/usr/share/icons/hicolor/${i}/apps"
	done

	install \
		-d \
		"${pkgdir}/usr/share/86Box/assets"
	cp \
		-a \
		"${srcdir}/assets/sounds" \
		"${pkgdir}/usr/share/86Box/assets"

	export pkgdir
	export pkgname
	export srcdir
	portable-packer \
		-v \
		--distro arch \
		--mode post \
		--hash true \
		--config-ng "${srcdir}/config.toml" \
		--desktop-file "${srcdir}/desktop.file"
}
