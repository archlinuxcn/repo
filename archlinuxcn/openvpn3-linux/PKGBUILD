    util-linux-libs
    polkit
    tinyxml2
    systemd-libs
    fmt
    # arch enabled dco kernel support
    libnl
    protobuf
    python
    gdbuspp
)
makedepends=(
    git
    meson
    ninja
    asio
    bzip2
    python-docutils
    python-jinja
)
checkdepends=(
    gtest
)
source=(
    "$pkgname::git+$url.git#tag=v$pkgver?signed"
    "git+https://github.com/OpenVPN/openvpn3.git"
    sysuser.conf
    0001-Substitute-with-system-dependencies.patch
    0002-Fix-srcdir-reference.patch
    0003-Remove-extra-version-logic.patch
    0004-Fix-target-dependency-graph.patch
)
