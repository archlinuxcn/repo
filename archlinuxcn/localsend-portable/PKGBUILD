# Maintainer: Kimiblock Moe

pkgname=localsend-portable
pkgver=1.18.2
pkgrel=2
provides=(localsend)
conflicts=(localsend)
pkgdesc="AirDrop alternative. Sandboxed by portable."
arch=(x86_64)
url='https://localsend.org'
license=('Apache-2.0')
depends=(portable)
makedepends=(localsend portable-packer)
source=(
	config.toml
	desktop.file
)
b2sums=('10b23a9810c22a616269893236ad3d582206eee3bbe68d29fc3484b5fb88750851b12089ad8b5d601fe23c71ba756e027d18a691328e93cb9a7758ee1d53a47e'
        '1ee8212c4ebaffe9b5803c7367e271879918665545a702a5dfe7c9d6f7f8a8b9be71998f40af059f663030d117682be50acfa02a42258c4fc78ace9e777452e0')

package() {
	export pkgdir
	export pkgname
	export srcdir
	portable-packer \
		-v \
		--distro arch \
		--mode copy localsend \
		--hash true \
		--config-ng "${srcdir}/config.toml" \
		--desktop-file "${srcdir}/desktop.file"

	ln -srf "${pkgdir}/usr/bin/localsend-portable" "${pkgdir}/usr/bin/localsend"
}
