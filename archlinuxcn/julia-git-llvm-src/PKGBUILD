pkgname=julia-git-llvm-src
pkgver=9.13.2
_commit=856cfb0da3fa9d7b8229f831f040bcf75f4a4f3e
pkgrel=2
pkgdesc="LLVM.jl"
url="https://github.com/maleadt/LLVM.jl.git"
arch=('any')
license=('MIT')
makedepends=(git julia-pkg-scripts)
depends=(julia-git)
source=("git+https://github.com/maleadt/LLVM.jl.git#commit=$_commit"
        LLVM.jl-v9.13.2-llvm23.patch)
sha256sums=('c0b35f53b5066ef26f0b19050d40f63cabc57ec6f46abf88ccd1f1216b09848b'
            '7662ad64f39d87daa13bc6513c03d50bc0891f002ab7f27976524c2a4f123554')

prepare() {
  cd LLVM.jl

  patch -Np1 --no-backup-if-mismatch < "../LLVM.jl-v9.13.2-llvm23.patch"
}

package() {
  cd LLVM.jl

  JULIA_INSTALL_SRCPKG=1 . /usr/lib/julia/julia-install-pkg.sh LLVM "${pkgdir}" "${pkgname}" julia-git

  rm -rf "${dest_dir}"/deps
}
