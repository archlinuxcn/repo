_unpack_overlay() {
  local ovl=$1 libdir=$2 f
  shift 2

  rm -rf "$ovl"
  mkdir "$ovl"
  for f; do
    # merge every package into one tree; skip pacman metadata
    bsdtar -xf "$f" -C "$ovl" \
      --exclude .PKGINFO --exclude .MTREE --exclude .BUILDINFO --exclude .INSTALL
  done

  # Not needed inside the guest, keep the image small.
  rm -rf "$ovl"/usr/include "$ovl"/usr/share/doc "$ovl"/usr/share/man \
         "$ovl/usr/$libdir/pkgconfig"

  # Overlays do not update ld.so.cache, so ld.so falls back to the default
  # search path. That is fine for ld.so but not for Steam's libcapsule, whose
  # fallback is hardcoded to /lib:/usr/lib. Same workaround as Fedora/asahi-alarm:
  # https://github.com/ValveSoftware/steam-runtime/issues/704
  for f in "$ovl/usr/$libdir"/gbm/dri_gbm.so \
           "$ovl/usr/$libdir"/libGLX_mesa.so.*.*.* \
           "$ovl/usr/$libdir"/libEGL_mesa.so.*.*.* \
           "$ovl/usr/$libdir"/libRusticlOpenCL.so.*.*.*; do
    [[ -f $f && ! -L $f ]] && patchelf --add-rpath "/usr/$libdir" "$f"
  done
  return 0
}

prepare() {
  _unpack_overlay ovl-x86_64 lib "${_x86_64_files[@]}"
  _unpack_overlay ovl-i386 lib32 "${_i386_files[@]}"
}

build() {
  local a
  for a in x86_64 i386; do
    rm -f "mesa-$a.erofs"
    mkfs.erofs -z lz4 --all-root -T "${SOURCE_DATE_EPOCH:-0}" "mesa-$a.erofs" "ovl-$a"
  done
}

_package_overlay() {
  local a=$1 pkg=$2
  shift 2

  install -Dpm0644 -t "$pkgdir/usr/share/fex-emu/overlays/" "mesa-$a.erofs"
  # record what went in
  printf '%s\n' "$@" \
    | install -Dm0644 /dev/stdin "$pkgdir/usr/share/fex-emu/overlays/mesa-$a.packages"

  local lic
  for lic in "ovl-$a"/usr/share/licenses/{mesa,lib32-mesa}/LICENSE; do
    [[ -f $lic ]] && install -Dpm0644 "$lic" "$pkgdir/usr/share/licenses/$pkg/LICENSE" && break
  done
  return 0
}

package_mesa-fex-emu-overlay-x86_64() {
  pkgdesc='Arch Linux x86_64 mesa repacked as a FEX-Emu/muvm rootfs overlay'
  _package_overlay x86_64 "$pkgname" "${_x86_64_names[@]}"
}

package_mesa-fex-emu-overlay-i386() {
  pkgdesc='Arch Linux lib32 (multilib) mesa repacked as a FEX-Emu/muvm rootfs overlay for i386 guests'
  _package_overlay i386 "$pkgname" "${_i386_names[@]}"
}

package_mesa-fex-dummy() {
  pkgdesc='Empty package satisfying mesa dependencies inside a FEX-Emu rootfs (drivers come from the overlays)'
  license=('0BSD')
  # Installed *inside* the x86_64 FEX rootfs (pacman -U while building the
  # image), never on the host. Provides every real split package name with its
  # version (epoch:pkgver, no pkgrel) plus everything they provide; conflicts
  # only with the real package names so a stock mesa cannot sneak in.
  # Depends on what the real packages depend on so that the libraries needed
  # by the drivers in the overlays are in the rootfs.
  provides=(
    "${_mesa_pkgs[@]/%/=${_mesa_ver%-*}}"
    "${_lib32_mesa_pkgs[@]/%/=${_lib32_mesa_ver%-*}}"
    "${_mesa_provides[@]}"
    "${_lib32_mesa_provides[@]}"
  )
  conflicts=("${_mesa_pkgs[@]}" "${_lib32_mesa_pkgs[@]}")
  depends=("${_mesa_depends[@]}" "${_lib32_mesa_depends[@]}")
}
