# Maintainer: Yichao Yu

# Repacks the stock Arch Linux x86_64 `mesa` and multilib `lib32-mesa` packages
# into the erofs overlays that muvm mounts on top of the FEX-Emu rootfs
# (/usr/share/fex-emu/overlays/mesa-{x86_64,i386}.erofs, filenames hardcoded in
# muvm), plus an empty package for the rootfs itself that satisfies every mesa
# dependency so the drivers come exclusively from the overlays.
#
# Nothing is compiled: download + extract + mkfs.erofs, hence arch=(any).
#
# The _mesa_*/_lib32_mesa_* variables below are generated by lilac.py: the
# versions come from nvchecker (archpkg) with the epoch recovered from the
# packaging repo's release tag, the package/provides lists from the official
# PKGBUILD at that tag (makepkg --printsrcinfo), and so are the runtime
# dependencies of the split packages for mesa-fex-dummy. Do not edit them by hand.

pkgbase=mesa-fex-emu-overlay
pkgname=(mesa-fex-emu-overlay-x86_64 mesa-fex-emu-overlay-i386 mesa-fex-dummy)
pkgver=26.2.6
pkgrel=1
pkgdesc='Arch Linux mesa repacked as FEX-Emu/muvm rootfs overlays'
arch=(any)
url='https://www.mesa3d.org/'
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
makedepends=(erofs-utils patchelf zstd)
options=(!strip !debug)

# --- generated by lilac.py (one line each) ----------------------------------
_mesa_ver=1:26.2.6-1
_mesa_pkgs=(mesa opencl-mesa vulkan-asahi vulkan-broadcom vulkan-dzn vulkan-freedreno vulkan-gfxstream vulkan-intel vulkan-nouveau vulkan-panfrost vulkan-powervr vulkan-radeon vulkan-swrast vulkan-virtio vulkan-mesa-implicit-layers vulkan-mesa-layers mesa-docs)
_mesa_depends=(expat glibc libdrm libelf libgcc libglvnd libstdc++ libx11 libxcb libxext libxshmfence libxxf86vm llvm-libs lm_sensors spirv-tools wayland zlib zstd clang spirv-llvm-translator libclc libdisplay-info systemd-libs vulkan-icd-loader xcb-util-keysyms libpng python)
_mesa_provides=(libva-mesa-driver mesa-libgl libva-driver opengl-driver opencl-driver vulkan-driver)
_lib32_mesa_ver=1:26.2.6-1
_lib32_mesa_pkgs=(lib32-mesa lib32-opencl-mesa lib32-vulkan-asahi lib32-vulkan-broadcom lib32-vulkan-dzn lib32-vulkan-freedreno lib32-vulkan-gfxstream lib32-vulkan-intel lib32-vulkan-nouveau lib32-vulkan-panfrost lib32-vulkan-powervr lib32-vulkan-radeon lib32-vulkan-swrast lib32-vulkan-virtio lib32-vulkan-mesa-implicit-layers lib32-vulkan-mesa-layers)
_lib32_mesa_depends=(lib32-expat lib32-gcc-libs lib32-glibc lib32-libdrm lib32-libelf lib32-libglvnd lib32-libx11 lib32-libxcb lib32-libxext lib32-libxshmfence lib32-libxxf86vm lib32-llvm-libs lib32-lm_sensors lib32-spirv-tools lib32-wayland lib32-zlib lib32-zstd lib32-clang lib32-spirv-llvm-translator lib32-libdisplay-info lib32-systemd lib32-vulkan-icd-loader lib32-xcb-util-keysyms lib32-libpng)
_lib32_mesa_provides=(lib32-libva-mesa-driver lib32-mesa-libgl lib32-libva-driver lib32-opengl-driver lib32-opencl-driver lib32-vulkan-driver)
# ----------------------------------------------------------------------------

# Split packages that are pointless inside a Linux guest and left out of the
# overlays (the dummy still provides/conflicts them).
_exclude=(mesa-docs vulkan-dzn vulkan-gfxstream lib32-vulkan-dzn lib32-vulkan-gfxstream)

_archive=https://archive.archlinux.org/packages

# Build source=() and the per-overlay file lists from the generated arrays.
# Archive filenames carry the epoch as a literal ':' (-> %3A in the URL); the
# local copy is renamed so that no ':' ends up on disk.
source=()
_x86_64_names=() _x86_64_files=()
_i386_names=() _i386_files=()
for _p in "${_mesa_pkgs[@]}"; do
  case " ${_exclude[*]} " in *" $_p "*) continue ;; esac
  _f="$_p-$_mesa_ver-x86_64.pkg.tar.zst"
  source+=("${_f//:/_}::$_archive/${_p:0:1}/$_p/${_f//:/%3A}")
  _x86_64_names+=("$_p-$_mesa_ver")
  _x86_64_files+=("${_f//:/_}")
done
for _p in "${_lib32_mesa_pkgs[@]}"; do
  case " ${_exclude[*]} " in *" $_p "*) continue ;; esac
  _f="$_p-$_lib32_mesa_ver-x86_64.pkg.tar.zst"
  source+=("${_f//:/_}::$_archive/${_p:0:1}/$_p/${_f//:/%3A}")
  _i386_names+=("$_p-$_lib32_mesa_ver")
  _i386_files+=("${_f//:/_}")
done
unset _p _f
noextract=("${source[@]%%::*}")
# regenerated by updpkgsums in lilac.py pre_build
