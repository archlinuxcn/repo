# Maintainer: Gavin Luo <lunt.luo@gmail.com>

pkgname=python-zxing-cpp
pkgver=3.1.1
pkgrel=1
pkgdesc='Python bindings for zxing-cpp.'
url='https://github.com/zxing-cpp/zxing-cpp'
arch=('x86_64')
license=('Apache-2.0')
_name=${pkgname#python-}-${pkgver}
source=("${_name}.tar.gz::${url}/releases/download/v${pkgver}/${_name}.tar.gz")
b2sums=('e62694e8aa1386ccb176dc1d10655827028f79d4fafaccb8c57791139619b33917fe62c5d852be4cf9eec4bf11f447346b096b63be5100b0866586463bea10e4')
depends=('python')
makedepends=(
    'python-build'
    'python-installer'
    'python-wheel'
    'python-scikit-build-core'
    'nanobind'
    'cmake>=3.18'
)

build() {
    cd "${srcdir}/${_name}/wrappers/python"
    python -m build --wheel --no-isolation
}

package() {
    cd "${srcdir}/${_name}/wrappers/python"
    python -m installer --destdir="$pkgdir" dist/*.whl
}
