# Maintainer: ston <2424284164@qq.com>
# Maintainer: Merrkry <jeffpotvin930@gmail.com>

_pkgname=looking-glass
pkgbase=looking-glass-rc
pkgname=("${pkgbase}"
	"${pkgbase}-module-dkms"
	"${pkgbase}-host"
	"obs-plugin-${pkgbase}")
epoch=1
pkgver=B8rc1
_pkgver=${pkgver/rc/-rc}
pkgrel=1
pkgdesc="An extremely low latency KVMFR (KVM FrameRelay) implementation for guests with VGA PCI Passthrough. (Candidate Version)"
url="https://looking-glass.io/"
arch=('x86_64')
license=('GPL-2.0-or-later')
makedepends=('cmake' 'dkms' 'fontconfig' 'fuse3' 'libdecor' 'libegl' 'libelf' 'libpipewire'
	'libpulse' 'libsamplerate' 'libunwind' 'libxi' 'libxinerama' 'libxpresent' 'libxrandr'
	'libxss' 'obs-studio' 'simde' 'spice-protocol' 'usbredir' 'wayland-protocols')
source=("looking-glass-${_pkgver}.tar.gz::https://looking-glass.io/artifact/${_pkgver}/source")
sha256sums=('8820a77c1a68f823be0c19dbcddb1c3a3e6a08a388925da81703665b7e79f971')

_lgdir="${_pkgname}-${_pkgver}"

prepare() {
	chmod -R a+rX "${srcdir}/${_lgdir}"
}

build() {
	cd "${srcdir}/${_lgdir}"
	for component in client host obs; do
		cmake -S "${component}" -B "${component}/build" \
			-DOPTIMIZE_FOR_NATIVE=x86-64-v2 -DCMAKE_INSTALL_PREFIX=/usr
		cmake --build "${component}/build"
	done
}

package_looking-glass-rc() {
	pkgdesc="A client application for accessing the LookingGlass IVSHMEM device of a VM"
	depends=('fontconfig' 'fuse3' 'glibc' 'gmp' 'hicolor-icon-theme' 'libdecor' 'libegl'
		'libelf' 'libgcc' 'libgl' 'libpipewire' 'libpulse' 'libsamplerate' 'libstdc++' 'libunwind'
		'libx11' 'libxcursor' 'libxfixes' 'libxi' 'libxinerama' 'libxkbcommon' 'libxpresent'
		'libxrandr' 'libxss' 'nettle' 'usbredir' 'wayland')
	# Preserve the client's own split debug file and its crash backtrace debuglink.
	options=('!strip' '!debug')
	provides=("${_pkgname}")
	conflicts=("${_pkgname}")
	cd "${srcdir}/${_lgdir}/client/build"
	make DESTDIR="${pkgdir}" install
	strip --strip-unneeded "${pkgdir}/usr/bin/looking-glass-client"
}

package_looking-glass-rc-module-dkms() {
	pkgdesc="A kernel module that implements a basic interface to the IVSHMEM device for when using LookingGlass in VM->VM mode"
	arch=('any')
	depends=('dkms')
	provides=("${_pkgname}-module-dkms")
	conflicts=("${_pkgname}-module-dkms")
	cd "${srcdir}/${_lgdir}/module"
	install -Dm644 -t "${pkgdir}/usr/src/kvmfr-${pkgver}" \
		Makefile \
		dkms.conf \
		kvmfr.{h,c}
	sed -i "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"${pkgver}\"/" \
		"${pkgdir}/usr/src/kvmfr-${pkgver}/dkms.conf"
}

package_looking-glass-rc-host() {
	pkgdesc="Linux host application for pushing frame data to the LookingGlass IVSHMEM device"
	depends=('glib2' 'glibc' 'libelf' 'libgcc' 'libpipewire' 'libunwind' 'libxcb')
	provides=("${_pkgname}-host")
	conflicts=("${_pkgname}-host")
	cd "${srcdir}/${_lgdir}/host/build"
	make DESTDIR="${pkgdir}" install
}

package_obs-plugin-looking-glass-rc() {
	pkgdesc="Plugin for OBS Studio to stream directly from Looking Glass without having to record the Looking Glass client"
	depends=('glibc' 'libelf' 'libunwind' 'obs-studio')
	provides=("obs-plugin-${_pkgname}")
	conflicts=("obs-plugin-${_pkgname}")
	install -Dm644 -t "${pkgdir}/usr/lib/obs-plugins" \
		"${srcdir}/${_lgdir}/obs/build/liblooking-glass-obs.so"
}
