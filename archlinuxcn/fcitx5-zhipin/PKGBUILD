# Maintainer: LondyGhost <476729421@qq.com>

pkgname=fcitx5-zhipin
pkgver=1.0.0
pkgrel=1
pkgdesc='Intelligent ABC style input method engine for fcitx5 (librime backend)'
arch=('x86_64')
url='https://github.com/LondyGhost/fcitx5-zhipin'
license=('GPL-3.0-only')
depends=('fcitx5' 'librime' 'rime-prelude' 'hicolor-icon-theme')
optdepends=('rime-ice: recommended dictionary base for the abc schema')
makedepends=('cmake' 'ninja' 'gcc' 'pkgconf')
options=(!debug)
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  cd "$pkgname"
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
