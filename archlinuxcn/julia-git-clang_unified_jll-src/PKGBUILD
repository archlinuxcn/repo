pkgname=julia-git-clang_unified_jll-src
pkgver=0.1.9+0
_commit=12bec2f33240bb4cf950b16cd7e606d9f1b43a3e
pkgrel=1
pkgdesc="Clang_unified_jll.jl"
url="https://github.com/JuliaBinaryWrappers/Clang_unified_jll.jl.git"
arch=('any')
license=('MIT')
makedepends=(git julia-pkg-scripts)
depends=(julia-git clang)
source=("git+https://github.com/JuliaBinaryWrappers/Clang_unified_jll.jl.git#commit=$_commit"
        jll.toml)
sha256sums=('d301e080924a594342382c1ab81eedeb88505f76b13617050274337785ca4220'
            '95770c49718f23d957659820e7fd066c35b41bbf3c0d24ba9894d84f900c8c7a')

build() {
  cd Clang_unified_jll.jl

  julia /usr/lib/julia/julia-gen-jll.jl Clang_unified_jll ../jll.toml
}

package() {
  cd Clang_unified_jll.jl

  JULIA_INSTALL_SRCPKG=1 . /usr/lib/julia/julia-install-pkg.sh Clang_unified_jll "${pkgdir}" "${pkgname}" julia-git
}
