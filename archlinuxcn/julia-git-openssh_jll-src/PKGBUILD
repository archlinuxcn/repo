pkgname=julia-git-openssh_jll-src
pkgver=10.5.1+0
_commit=faed8c5c0ac75335605f68aa4b92ae19ccf7b082
pkgrel=1
pkgdesc="OpenSSH_jll.jl"
url="https://github.com/JuliaBinaryWrappers/OpenSSH_jll.jl.git"
arch=('any')
license=('MIT')
makedepends=(git julia-pkg-scripts)
depends=(julia-git openssh)
source=("git+https://github.com/JuliaBinaryWrappers/OpenSSH_jll.jl.git#commit=$_commit"
        jll.toml)
sha256sums=('be25d9953c69209e10ad8b2e5beba9db26fec41b2dcafe582a5f6843561ff19f'
            '04e880b1371e824140b0599b050ac85876922458e46edd794a421e78f1f613ab')

build() {
  cd OpenSSH_jll.jl

  julia /usr/lib/julia/julia-gen-jll.jl OpenSSH_jll ../jll.toml
}

package() {
  cd OpenSSH_jll.jl

  JULIA_INSTALL_SRCPKG=1 . /usr/lib/julia/julia-install-pkg.sh OpenSSH_jll "${pkgdir}" "${pkgname}" julia-git
}
