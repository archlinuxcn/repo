_reponame="lk-jwt-service"
pkgname="element-${_reponame}"
pkgver=0.6.0
pkgrel=1
pkgdesc='LiveKit Management Service for Element Call'
arch=(x86_64)
url='https://github.com/vector-im/lk-jwt-service/'
license=("AGPL-3")
makedepends=(rust git)
source=(
	"source::git+https://github.com/element-hq/lk-jwt-service.git#tag=v${pkgver}"
	"${_reponame}.service"
)
sha512sums=('cdcbac56b2ccf3956707d6f5fdb53b693125cd45dbf252a15e034313e67ce123f83f29763141b28bc6909a922441622a00686e15896dd022e95063cbac7084ca'
            '7f78c64b5a6de2505ea0c57b95071493bf9d57cc80e091f7bd70e8288690f4a2e0cb8a3dda267e62645d40e93769845e2a1e04844490fd04a320e763b2a69db4')

prepare() {
	cd source
	cargo fetch --locked --target host-tuple
}

build() {
	cd source
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo build --frozen --release
}

package() {
	install -vDm755 source/target/release/lk-jwt-service -t "$pkgdir/usr/bin"
	install -vDm644 ${_reponame}.service -t "$pkgdir/usr/lib/systemd/system/"
}
