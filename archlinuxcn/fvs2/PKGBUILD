_corever=0.1.3

pkgname=fvs2
pkgver=0.11.0
pkgrel=2
pkgdesc='Standalone CLI for FVS v2'
arch=('x86_64' 'aarch64')
url='https://github.com/fvs-lab/fvs2'
license=('MIT')
depends=('glibc')
makedepends=('go' 'git')

source=(
	"source::git+$url#tag=v${pkgver}"
	"core::git+https://github.com/fvs-lab/core.git#tag=v${_corever}"
)

sha256sums=('15ba35ecb589784bd1e1de1cd63f6dfa77a908af5fd86d38ee7ca904e91988e6'
            '4288e796ae3deb3db4a9e896ea2473d8914c219e0aa15eed1b8ff1d0fd28c037')

prepare() {
	cd source
	go mod download -modcacherw
	mkdir -p build
}

build() {
	cd source
	export CGO_CPPFLAGS="$CPPFLAGS"
	export CGO_CFLAGS="$CFLAGS"
	export CGO_CXXFLAGS="$CXXFLAGS"
	export CGO_LDFLAGS="$LDFLAGS"
	export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'

	go \
		build \
		-ldflags='-linkmode external' \
		-o "build/$pkgname" \
		"./cmd/$pkgname"
}

package() {
	cd source

	install \
		-vDm755 \
		"build/$pkgname" \
		"$pkgdir/usr/bin/$pkgname"
	install \
		-vDm644 \
		LICENSE \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
install \
	-vDm644 \
	README.md \
	"$pkgdir/usr/share/doc/$pkgname/README.md"
}
