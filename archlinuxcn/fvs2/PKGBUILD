_corever=0.1.3

pkgname=fvs2
pkgver=0.11.0
pkgrel=1
pkgdesc='Standalone CLI for FVS v2'
arch=('x86_64' 'aarch64')
url='https://github.com/fvs-lab/fvs2'
license=('MIT')
depends=('glibc')
makedepends=('go' 'git')

source=(
	"source::git+$url#tag=v${pkgver}"
	"core::git+https://github.com/fvs-lab/core.git#tag=v${_corever}"
)

sha256sums=('1dc0c1cf3343f7ef69f48f2f08bec31d4994f714f87a6c09f157be8e4144e7fa'
            '070b9961fbb5b9ab8b51be4b8fe7c7c7119c97054be82cdd55889a68b2aacd59')

prepare() {
	cd source
	go mod download -modcacherw
	mkdir -p build
}

build() {
	cd source
	export CGO_CPPFLAGS="$CPPFLAGS"
	export CGO_CFLAGS="$CFLAGS"
	export CGO_CXXFLAGS="$CXXFLAGS"
	export CGO_LDFLAGS="$LDFLAGS"
	export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'

	go \
		build \
		-ldflags='-linkmode external' \
		-o "build/$pkgname" \
		"./cmd/$pkgname"
}

package() {
	cd source

	install \
		-vDm755 \
		"build/$pkgname" \
		"$pkgdir/usr/bin/$pkgname"
	install \
		-vDm644 \
		LICENSE \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
install \
	-vDm644 \
	README.md \
	"$pkgdir/usr/share/doc/$pkgname/README.md"
}
