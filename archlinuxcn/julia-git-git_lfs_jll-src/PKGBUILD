pkgname=julia-git-git_lfs_jll-src
pkgver=3.7.1+0
_commit=abe2f7202b75cd01a9081cc58655f705b1e78d69
pkgrel=1
pkgdesc="Git_LFS_jll.jl"
url="https://github.com/JuliaBinaryWrappers/Git_LFS_jll.jl.git"
arch=('any')
license=('MIT')
makedepends=(git julia-pkg-scripts)
depends=(julia-git git-lfs)
source=("git+https://github.com/JuliaBinaryWrappers/Git_LFS_jll.jl.git#commit=$_commit"
        jll.toml)
sha256sums=('11f9bf90955041fb9df3e941735eee9deeae08d4b41f08c6c42149d0d3fcaf5b'
            '8066bf343b2ec759d995eed096e2b5117177eab9fbfdd1a33022f168ad2ff13c')

build() {
  cd Git_LFS_jll.jl

  julia /usr/lib/julia/julia-gen-jll.jl Git_LFS_jll ../jll.toml
}

package() {
  cd Git_LFS_jll.jl

  JULIA_INSTALL_SRCPKG=1 . /usr/lib/julia/julia-install-pkg.sh Git_LFS_jll "${pkgdir}" "${pkgname}" julia-git
}
