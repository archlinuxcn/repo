                   '10cbe26104fb9d26f913935069360731947ad1c8fe7f82d0e5b476c876ae063d')
sha256sums_i686=('903bb6c7196040aa6e20b6313984b53274158c9e26c047a073c97a978fd98022'
                 '4ab319a89fec1f496b158d58cb1d95205e58deb34e3bdd522e263765019d4061')
sha256sums_loong64=('65186380612cda5e94a118daf6c1dbd23fd528cbb78868503b1b7434cd6c66ab'
                    'd3b9202a2611c61feb1c0f07c01c3d3e81e44393007bef6bb9b8a89fb3475b99')
sha256sums_powerpc64le=('c3778d228cb26da9d9508d4a2665af953b2ded168a388cac097f22fda9c7edbb'
                        'd3b395c2ba63a90076ea47692817284d2fe7405650adbb7328d6e12dcbf38fee')
