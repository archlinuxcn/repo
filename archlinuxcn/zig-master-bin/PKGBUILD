                   '8ede0c2487bd9c4af925cee7aa55cc771cfce7095eb89c34a5fc70e19dd41801')
sha256sums_i686=('211c596dd5deba4dd421d57e825ca92320403724bf3e8650a2bf5acfacd671c5'
                 'cb2a416befe18f8f9a5f335c61618995353577f356013c417f5f16b60bdc0af2')
sha256sums_loong64=('0167ee00972936a02ed78368cf3ac1409bb3c573abec20eb2f179593813dfccc'
                    '437220cb362696413264fc98b6e5d6c4d7fd22fc7b6ce8828a90e28ca8fe231b')
sha256sums_powerpc64le=('161825ae62e5cd30d289cabf067dc2ae53ca0a31ed3c118a4428f1a6da314bf1'
                        'f99b8e21442edb88e1066d61b4ce646e8100c3fac71ad505571a95ac9371ad97')
