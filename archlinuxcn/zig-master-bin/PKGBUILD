                   'cfb6d4cde8dbbdfc6bd9c2422bd416ef5cd3b8a4107b8cb17c1ed1c83fa0c492')
sha256sums_i686=('f482b81073e61e63a3071e1bc2fd745e4bf70f5820ade4656ddcf6a4fd6a8ec8'
                 'fe8a11365bd5438f851d8aa204770e3c1f2b757f51e6d7ac0274119b869b0ffd')
sha256sums_loong64=('5350cd7c5a21d5af426d0003079b40f30b24303e4104310cb21889946c0a6955'
                    'b5e9325f12216171264be12bd44cde3b1e1c8788a47417db23c731216f5aa7c9')
sha256sums_powerpc64le=('5872284454ef5ef7f4b54805f1069d6774bbda055e6be04396437935c5e32889'
                        'ee353cbf1fb602e74e9a93cfc595c061883650b7768efdfc30238177f653e708')
