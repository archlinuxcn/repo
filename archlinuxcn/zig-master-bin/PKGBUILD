                   '4959bf41c9f1f7f168341c95074852bab91cee6120f63472b9eed4449e2a50b3')
sha256sums_i686=('d2560f3dbeee038400c469598c837890d8d6e5506343d74dca78e02ea99404e8'
                 'e5e77d5884305ca6e1e561e20d02320f3c8e6db0001e5c9edb6c043b94cecf14')
sha256sums_loong64=('966b6cccd583a99a26adc897baa1a6c9288b1a91628bbd4ee811c0d2138bc7d7'
                    '770423feaf2c29727cf0882f252e5994abc20c5fb37583b1b56836a70a2190ad')
sha256sums_powerpc64le=('e982d784a7fcac949da5703ed0268cd6a5a7b39e1173c90193902a5b38fc854c'
                        '52bbe1c0312f6dfb852ecbb63e4d207c1044a4c4f86292141f8258b0d916ccdc')
