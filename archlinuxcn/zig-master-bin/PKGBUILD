                   'eac814ce487326ce220915b52f71dca5f7f8fb3b5df5ff9eb84572ac40c703d0')
sha256sums_i686=('f1a2a36632caeb046241d2c796e527e74841aff4ab25411a6e28e00fe194cafb'
                 '0837d07ede85411cce8632cb819c0ee378b5403b48822bca34f7bf16cba5f17b')
sha256sums_loong64=('effad3d436b5ab025fe8baced7f0d0928077b97bdb286bac66d154e50530994a'
                    '18e501be34af84ff538ef1db36d4feafd18e712cebc0bddbdfad9a66d1b68feb')
sha256sums_powerpc64le=('2eddc978b30f74391c8546e18feba22f21ae9fe70f0ab61cdf7dc83166be2262'
                        '712f6505e86a114905df947a05276cc0860193b60e29c420f7e931ccffb087eb')
