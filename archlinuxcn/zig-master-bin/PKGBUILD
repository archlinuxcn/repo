                   'a3af79cce64ce331070f7b281d228b9a9a18411930ef7d31417aeb655f94010e')
sha256sums_i686=('05b0ee65cfa245c50c5ebb825cd3deb8291eabaae35cd7ec8be1ada23bec1b73'
                 '7f430908c5a68f3f41e520bf551571f3dde608088d8a71cefbdb33cebc3f2e18')
sha256sums_loong64=('f0cb0b123e9a44d3a46c2f812df17b6498d221c1b137efb2ddd8a44a99542993'
                    '8b41adbd1090487b62c86c58f2627ddd7547ab55a13b5a50298204a3dc4b5608')
sha256sums_powerpc64le=('c2e52779c9d2917bda13471a4c487ea89e3c6c3106c54e2b5b939ee424823720'
                        '52bd4be3848efcbe7631957d3e0f3b54a55989a4251c53a25e8538081ebba16b')
