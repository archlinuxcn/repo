# shellcheck shell=bash
pkgname=zig-master-bin
pkgver=0.18.0dev.1180+2e9bb03df
pkgrel=1
pkgdesc="A general-purpose programming language and toolchain for maintaining robust, optimal, and reusable software (master release)"
arch=('aarch64' 'armv7h' 'i686' 'loong64' 'powerpc64le' 'riscv64' 'x86_64')
url="https://ziglang.org/"
license=('MIT')
provides=('zig-master' 'zig-unstable')
conflicts=('zig')
replaces=('zig-nightly-bin')
makedepends=('minisign')
options=('!strip')

_master_version=${pkgver/dev/-dev}

source_aarch64=("https://ziglang.org/builds/zig-aarch64-linux-${_master_version}.tar.xz" "https://ziglang.org/builds/zig-aarch64-linux-${_master_version}.tar.xz.minisig")
sha256sums_aarch64=('29931fd37d2691fa88d64eba8942003d51ec7c40e4fc844ae3c3ed554d66182e'
                    '294a60b1e10fdd91e1b8cfb6ba4b2043f22b7d7db5b34c8120c6bd5440d50799')
sha256sums_armv7h=('9883ec93ac8c5ed26cb2d2e2689aa16570d88872dd06acd17209cab104933614'
                   '3251ad4bd1ac772b575aa033c2ad594efebb6cffd604f513a9e18f97090d5414')
sha256sums_i686=('02bb2026b4b23c7ef047cc2515bad19275a423cb4c35fbf5355f992e3068806a'
                 'f3b1493cc8d5fe4d032dc30442e94e4de4aa561901cf6d2592b9740fc4e7af8e')
sha256sums_loong64=('3531fe49b547ccb73119b295bb538da9f7185a11688e3196ada5c7be49f0d5a2'
                    'a3e6133becaee6f229f31d88fb2daec208c8f9459945be63b5e56a7ed1f2c8f4')
sha256sums_powerpc64le=('5045256dddd919f408465e5c5bcc6bb3582b911178a04c40af5ca9e1f8fcd373'
                        'd375f93406a72221c761d11e58b6c8adcb6fa6e95a59ee2f6a1f8cd0135842bf')
