                   '651fc258efc8bb899948daed2465ad80f3151c919c35750e1720ed66895b8a6b')
sha256sums_i686=('d2c7233868381d5f91cd43106777175207c18e30e4438d4875275b0917c17892'
                 'd0ffb4d3b56cb0cccbb59f57d554283c33f33e0aecb46e065777527edbeeb69a')
sha256sums_loong64=('02ba4937b27f18ee18b57dc88235ed9c7d6e7627dcd5a194f4c92e80c2b90247'
                    '1e3127ab323b1cd91c0be85e197ced291435387837f654630b9d5f6a88f45e63')
sha256sums_powerpc64le=('d4564752740fcfe26ade9af99ae1710d2a8430833a445580a489828e3140ccef'
                        '5925eb36280201c957275c6402ad459aec581c6f96a8aaa7806ecfc60fac21fd')
