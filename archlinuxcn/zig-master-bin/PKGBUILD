                   'b7f51f13ef4eaae45ef3e691637c67d262a954b0ac550f8e4445a0e4a4117b63')
sha256sums_i686=('14770716e7bfd3373f71fe1db01c0468ad5e1a0d1effe17a1ec49eb9bd12743f'
                 '2cdb33659b30a8d9054f9af5c7424cb6e4ce8e6b96df39db4c74ec910c0ef002')
sha256sums_loong64=('98179195572262cd02d245c0edb184ef13f56b8e42299f83ab14f650bbc89e0e'
                    'ba0d8fcf5d928499a25858c527816398b433fcae592649838f2f69c061b87dd6')
sha256sums_powerpc64le=('6445940536a62320d316f25eba3ecb2390331e429f51bcf8c19c6a219fb161f5'
                        'a189d5ef2bca0788edceec65822b09d029c5db4e00faf8d11a7edeab0d4e2582')
