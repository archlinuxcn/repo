                   '1764c207a57199eb77680c7a462884791e6874adf16929190f1f84cf682ddfa8')
sha256sums_i686=('cc5413b3702d92810e6a631f350ff49314581421f47bb5d064b7e5028b3a89fb'
                 '44640603add75022a2e63d06b5592590650a5744db62351a43ab292e0102946f')
