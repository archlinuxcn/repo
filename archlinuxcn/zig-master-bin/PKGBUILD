                   '820a659cd212953a3d0ed5851cc4ed97da46651f6f46524ed48fad0ddef68953')
sha256sums_i686=('2c2c1406a2318050bc73b90857e2136d2ef4fae3d6cfa86b02029827f731711d'
                 'ad83d2b2c92d4c075743faa512aaf1bb48b2533862216edab40398085f3575f3')
sha256sums_loong64=('7676b176692c86ae4a0413cc6d11e6a04c8fb306bb251cce9968e6d83cf215b5'
                    '49179a69dda04c7b8e96cad407ea7280d44165bf481fc2b1b2e127a60f2e4f09')
sha256sums_powerpc64le=('bd1ecfdcc8c79675549779fc70e0f7d2b285800cb530003739dd962078f11f5c'
                        '1dd4e9f8ce9e084d95dc1652313efe4d65ee56d56acac2450a0eb0bbd5027ae5')
