                   '160954817bf15764cab8ecb01f986c34d7c457cb3c828d2fd267cc20985294e0')
sha256sums_i686=('37c148c0b539ed90266193df5e4ecfe0bd8b784f659386b467e43da087632552'
                 'b6c060083d99c37a24e7a5b5decabdeb465bdd7ca8097cf9462a9dc2ba2340b6')
sha256sums_loong64=('ad49de72b637879a09a2d0fda2803729340527939353b402438a27adc9210000'
                    '2894cda4f5c1636189ac37cb8cebdae376d56cae24edc76fef8b54b4ffca024c')
