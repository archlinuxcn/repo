                   'a6a7769e47645026ef5c03d7723cba3a7a0865710ffe88ebf6a112ab8f20b40b')
sha256sums_i686=('c3dd946cff5f0c9fa1708236fa0c8ed0bf85613a064912ed675a51a25d365d41'
                 'dfa223259170eccdc2c10a3fe91bcb79b334aee55a781804adebb5f52067c400')
sha256sums_loong64=('54b743e8852bb53b3471d13c57133969cd440823af7dfcfa104685e7f59dd804'
                    '83ff8f8baa3b9250c3e28ae57138f7eb7d97a1ffb3d34eafb23e442686af190a')
sha256sums_powerpc64le=('2f559678ed7fea74465d53b6e02777fa4a03b76a0f649109cac22e337bdd07f7'
                        'eb04183afbda620756f3a3c935c598a538e1e83d7ca4d6554aa86fce8b0443e4')
