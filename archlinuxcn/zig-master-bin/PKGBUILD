                   'd482d0ee38d935ce966e9fe0ad3cd40153365c449616c978fc551ba9d132a25d')
sha256sums_i686=('778f72041d41b71f4e21dd2c5a69926dcd87ac0a5d2444b1743a5a8b1cce0004'
                 '1ba5d30ac473d313b533b2486cd8ac806cde20927829fa0558117285ad8767e8')
sha256sums_loong64=('3fe1253dad407112e9fae54567b6c1c1abbe411509b2f7804f242c6fd6df74a0'
                    '4013914babc1b091d1208abae5a5126fde7d3e3e34bfba69d4ebeb349e27233f')
sha256sums_powerpc64le=('f5c28c246c77c2266c19bf4bd71422288e078359cb8f5d8d9ebf85c7a33b6bab'
                        '925b225d840fecc63923b65d0a33db3de50c4e13714a3f0cabe01313995e9ea9')
