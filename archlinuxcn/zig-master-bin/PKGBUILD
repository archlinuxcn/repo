                   '6d116b4226d6c6ceafcf29a1b85d61ddfac861012bd17be63467ee5bd29a5e1f')
sha256sums_i686=('c28dcb11e23ee1bdc90c97d1e5cd5e38fa784313510969b092b29976fcc7bdfb'
                 '7770828f5c8ac06d81e8e6a14ee53d6adcf3dd885dda487fedc72b7d2ac44d23')
sha256sums_loong64=('6e4a7b98d17e9d562b2df4c41254c474207edad73fbeff15caaba9f523d75556'
                    '9386a6d85dc07eafa9a554ca86d53f110dc2c31f6958123f0bfa86a7827e706a')
sha256sums_powerpc64le=('5ed3bfe7a8cb6b5c24e4304fc4caf0695aa646bb114877dbfc236707c2a587d2'
                        'd53d70aed4da9e5f174655eb789eccb2d53d98b739ffa1986adf58e705b5a946')
