                   'bec1659dd491dedb964c66a997f30601c6f5fdf000b8ba1968ddbd0943444aa3')
sha256sums_i686=('a6f5cb7b3dffb09f057754b5a2f88caa75af0e2d7b56cb8d5ef29341f2755503'
                 'b2ffad6f653d0c934655a4f63a49bcc3d9f045f5ae1e3c495d67d33fe85c0f38')
sha256sums_loong64=('eb35690b3147a1f4c1f5d5e9d8a51c1b818804f544747708329759442aee140a'
                    'ae7bf64382b866e0d5aacb882a8b6a94c1c594d80b31ad79489d3eadeb57ff5c')
sha256sums_powerpc64le=('2acc3bca064ac62fa56699cc2be3f63613118637a05a12aeed5e9f887960fb29'
                        'fb442cee6786bd06ff425c33f09641595033936602d270abdc519338dd447b1b')
