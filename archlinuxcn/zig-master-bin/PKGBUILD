                 '6df9acfbdcd5b8d3eb41302ba4d56f30c799bbe91dd63448f590ddb0895c975d')
sha256sums_loong64=('b4f7d609e3b184b77a37f3c750f3ac50aba0d19cc24a54b1e6296858d23b755a'
                    '9efcc0539d106ff66239580cbf5d22d3d0b41ce22310e90db1d5e1fa75878fd0')
sha256sums_powerpc64le=('31a4a4f2c9e8ada50dc98d7d49fe064caf691969e74f232bbf01a83c9531b781'
                        '282f8f8c01248202eba9da77f4eb6d5c98459092f8c9270401bf361e2cb3a3bc')
