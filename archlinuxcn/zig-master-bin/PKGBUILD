                   '742612d8cb5a821352177f1afa40e65b301e2fb9ee06d8991ec7daf3af00e265')
sha256sums_i686=('16426c5217fa3ca62f650bcec9ff1d73d36afeed236f325f95950d45c8eccad4'
                 '5b8a8961b9101030ceeec04addae08fe2a6a55320a924521c9e6bf9376fcd7d0')
sha256sums_loong64=('a0143ae34a2073ba712bb214d1c0362bbae6db6723c930fff7ac46d8911d77b1'
                    '7fcef5d071cd868f1ab48bfdf7ff4a22a1f4230c8c2ed1a3d3a53544158bfe2d')
sha256sums_powerpc64le=('948c98be77f755e1033fd52293a78d7a3b37174411f8893ffee78f4bcc7d6d91'
                        '0c08a06df985771b5d4bcc26571b942249b4acbe59fa1807105efd42d2279938')
