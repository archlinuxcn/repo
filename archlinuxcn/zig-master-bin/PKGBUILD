                 '29daf4cdc9dcdb5edc75ed45a73b4c423576e1eeb377c4b7106011cc9aba608f')
sha256sums_loong64=('48703a88133aa944ec4deab2c881743fd10de6a959c5f7ad7809286146596441'
                    '763430d79d539b154155b633ce87d81e934b335cfd52f68b57f0ca481dcea586')
sha256sums_powerpc64le=('69c2c6e3b6f70cf502a1d6647b0221bbc26ecc1a06ad4efe3c77a1aab1f45f9a'
                        'c113e7e39fcdd651467a6b14794ddca784ce07380a253772c323ad23ce4aba78')
