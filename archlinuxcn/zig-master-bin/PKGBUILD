                    '0d0343e668dfcecba8fb2935796ecd48a677defaa8b3eeea1c301ad9e9796b1e')
sha256sums_x86_64=('a07eee1bbd24dbf34e1609ddc904bec610a216c0b0d99654b5a976a5f650c895'
                   '6f4727a81b3548db203dc091e70396f3b8b0c2e9612ef3eb91aa3b493fd9f489')
source_armv7h=("https://ziglang.org/builds/zig-arm-linux-${_master_version}.tar.xz" "https://ziglang.org/builds/zig-arm-linux-${_master_version}.tar.xz.minisig")
source_i686=("https://ziglang.org/builds/zig-x86-linux-${_master_version}.tar.xz" "https://ziglang.org/builds/zig-x86-linux-${_master_version}.tar.xz.minisig")
source_loong64=("https://ziglang.org/builds/zig-loongarch64-linux-${_master_version}.tar.xz" "https://ziglang.org/builds/zig-loongarch64-linux-${_master_version}.tar.xz.minisig")
source_powerpc64le=("https://ziglang.org/builds/zig-powerpc64le-linux-${_master_version}.tar.xz" "https://ziglang.org/builds/zig-powerpc64le-linux-${_master_version}.tar.xz.minisig")
source_riscv64=("https://ziglang.org/builds/zig-riscv64-linux-${_master_version}.tar.xz" "https://ziglang.org/builds/zig-riscv64-linux-${_master_version}.tar.xz.minisig")
source_x86_64=("https://ziglang.org/builds/zig-x86_64-linux-${_master_version}.tar.xz" "https://ziglang.org/builds/zig-x86_64-linux-${_master_version}.tar.xz.minisig")

_archive() {
    local source_array="source_${CARCH}[0]"
    local source_url="${!source_array}"
    basename "$source_url"
}

# Check signatures in the chroot, after minisign is installed.
prepare() {
    minisign -q -V \
        -P "RWSGOq2NVecA2UPNdBUZykf1CCb147pkmdtYxgb3Ti+JO/wCYvhbAb/U" \
        -m "$(_archive)"
}

package() {
    local tarball=$(_archive)
    cd "${srcdir}/${tarball%.tar.*}" || return

    install -D zig "${pkgdir}/usr/bin/zig"

    install -d "${pkgdir}/usr/lib/zig"
    cp -a lib/* "${pkgdir}/usr/lib/zig/"

    install -d "${pkgdir}/usr/share/doc/zig"
    cp -a doc/* "${pkgdir}/usr/share/doc/zig"

    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
