                   '09dd1be1bb12efbfe23ec32e9dba0f90de1ab9e8f8858451b0646cb9ef17cfef')
sha256sums_i686=('a7384fdc7f4460d13afd750220d717d2d2a9c61dea059b5c4465e87c224c89c7'
                 '20ccffbb7d5cd194f4c27ff57b2b6decd04cd18e4570aa59b6a82da046247366')
