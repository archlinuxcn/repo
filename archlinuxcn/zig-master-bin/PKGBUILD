sha256sums_i686=('4c5a2043c18c0bdee4d832780e8c0733a33b966661c6bc5c53f0b364007ccbfc'
                 '878af74171c6379c5b9c1ea26ae496767b2b751dcda4f564cc6c22da32b8022e')
sha256sums_loong64=('48ab8be0781a4814897d92eec7fe0df1d66045dac70a18efaaec3ccc26b3657c'
                    'f991afdb6f5f44df614a11447f63794269e39ebce2eb248efac44d5bfc9b05f2')
sha256sums_powerpc64le=('c176dcb4e43eca26ebe9b5b3b74a2e2fa67ec1d5d863648ba7de8dea8d8d8279'
                        'e2d416ede90e0eb6d4bd96b3cafdc99c2abe99b5a4cea43e82695183b5f5da66')
