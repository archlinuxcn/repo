                   '3ed5ff5cff27560fa60be2cf55c87959afc14bff3375557f7706f36320a5f9f4')
sha256sums_i686=('253a4c4d5515084b1e278ba99fc00d49e6a66b4cb276dd221fa89e65285d8e56'
                 'e9299c827ee8e10e7dbfed2acbd2355fb632711d3a610f0033cb1672642c23d4')
sha256sums_loong64=('796318758d7311875279b5cb91a5701bbcade98dfdfbf4e40f89dcf1fa9aad57'
                    '15d631a97c1c379f17c0fc06815c680072812000a19cfa0a09ddf3b6be6a640e')
sha256sums_powerpc64le=('ef98f2046449690caeb972d06d3b6a3542fbf06308b3aaebd7c3505ee28daae9'
                        '340b20478bdacd12351e36b46c9619c07375e10a3be3037d6f3aaab34d48f532')
