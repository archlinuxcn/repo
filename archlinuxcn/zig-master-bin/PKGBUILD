                 'af90aa924a0dc9dde6fea4375566e3d4332fa1cb753d76c47117d84987d31bed')
sha256sums_loong64=('ed0c69def6f3c3c3140fa66e835c3327f5ae6276c358f29314ce84da36a9b0e6'
                    '6531b0f2df0c2c64273852f4b9899942b92b4358326e38409ab5e963d7087080')
sha256sums_powerpc64le=('d452361800f47651dc6485aa0e68e0563994917d36bb81dc3a483c7800578ad7'
                        '298be6bb77c26c26d233c2b4e5fa6e0044df76a6887e470ed207a6da51359af2')
