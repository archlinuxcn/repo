                    '744e0fee2b65c2f766db1e1ac0902b6637a7038592663970acd22bcbb6717109')
sha256sums_powerpc64le=('322f59f77f7e1d41259ff8bb820e212789a37ac01eccf100e6b457c1410df1ed'
                        '39ac9e882d4c9a293e9da9ede4ef04d22efb33037426f616cce130645a020f42')
