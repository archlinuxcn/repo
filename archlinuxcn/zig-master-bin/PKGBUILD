                   '5dd78f368ab32f21ad88207eb63a1d53ab080270fd31d20f529d71d347dca389')
sha256sums_i686=('50a4203a3318ea05f47bfabd01a49fd225877e388d93b5986c3da5aef36ee8b4'
                 '88f8eca9300be2f054febddb2fc45ea1ddf78099183192befb0002e2e4223e77')
