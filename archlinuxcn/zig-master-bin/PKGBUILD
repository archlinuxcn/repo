                 '347121c013c5010367bb5c0c63be83a67f6c109e1137ec8557fd5c06019323e2')
sha256sums_loong64=('094b7f9fb56a4610b52705a3e377806e1fc392741c848d2f3bc4026f448d912c'
                    'd00c15b732e3e5abbdf4a3bb87a57b8f78fbc4e8d8f8db903eaea755f621e1cd')
sha256sums_powerpc64le=('0920c89d3c89f9e9a73fdfbd3b54e4edcd4ebfd0498d05100a1dfa031a34a5b5'
                        '005c49adfc9e44e9c0235e2869d3f795ca84aa62f9a56949915a03921ede6600')
