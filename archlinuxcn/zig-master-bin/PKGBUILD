                   'cd99a4a19b42a9aec171c761a84093e17057a5883cabc0fa9d2c194faa043d1c')
sha256sums_i686=('e7a9636f571bfe9ecafe388501df7b9158f2ce010b5be3d51b194eb2f3e39b75'
                 '94b37c81e379c10fa092c2907053997f13856c8ef5f6bd394fd426c976741295')
sha256sums_loong64=('7335f86f11db7ee802622c6ebe1918de3213eaadde75fbbaeec9423fa34cdd3c'
                    '598200859a6d33cdb5f6421bd03a902f6b0b7b32430d2351b40a779f54c8f936')
sha256sums_powerpc64le=('4125fca6ff81925c946c376d8277c5c51995ce22a8f61ea9365b3c1b728af3f7'
                        '3ec12d77df531afc447d5ad89f039589008ce2ef12b85f763450c8ad0949ce82')
