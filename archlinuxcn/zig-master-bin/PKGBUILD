                   'f3bfbd0bc189769af4d74c095e7746b8c489b6e120bbb4da028c0cb737f856ad')
sha256sums_i686=('9ff2d7b5c184469135c6be2dedbf14e4b44db766ac9cfb3f87577ced9c289b80'
                 'e0a30ae2b383b87bd4361110670456789ad31cb18d15c261962ff6709f07b86a')
