                   '643ae5b23da1287bf7a68fdeb869d500627dbfb9996148775023b55c53cf8599')
sha256sums_i686=('5fce3bcf509bfdd5283cb329c18c9dfaa96b3dd1b28a4ccd08237c5cf3fc6f85'
                 '6165c5bcdb22cdf06ab53c6e583dd90565c0be2a107bf26d810bf93b919abbb3')
sha256sums_loong64=('d685e77e9b0f335c5f34217fd09d1a7e4088211e4e2298e718e8e599b3316458'
                    'bb99bfc8768afa8255da53b7c54f166f80cefa0b82437e66ca9d7d94a0cacd8c')
sha256sums_powerpc64le=('e22e5a8662d63d637bfa3b7584047b92f1c63609c40189f846e8be0dca346d4e'
                        '16ab0d837535ea799c39d57cb01fda9487b43362e64f76dcb60b35a589c7f26e')
