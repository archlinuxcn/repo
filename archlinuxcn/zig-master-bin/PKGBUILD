                   '02622f883df2496ba529c083f22e441fd19ef631e691ffa0d4ca321b47ba3bf4')
sha256sums_i686=('779a8abf8467c993e4996216017095ccca72d686bce52d230c7797b1c4fef062'
                 '14da078e8fa4050a7521a0a93b6951ed4b0f1621ab9c2c72bc31d9e57163c42b')
sha256sums_loong64=('935f5c60b205e1e8a4754893e038c69f260e9f44c2cb0a8e6394cc7acddd87b9'
                    'b5131a4e471f24775af3246150c469ec14b4b594150fb326cc58f157c44f536b')
sha256sums_powerpc64le=('495483577090aaa6966ab335ff70e0fa6e35cef383130b5e106e025054fb0d54'
                        'e93cf0886fb9a60fb292c917fad5bc5173292d0349da7c1303ade8dd70476076')
