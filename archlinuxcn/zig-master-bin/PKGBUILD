                   '9d078c6e83f12203c9f4b45aa4b8c53740ecfe693018d137d51a66f260026ece')
sha256sums_i686=('20dfd7d428d559a98eec7214ee0340f78be8691114ac46a900e1d08467e613eb'
                 '395629a97ec71e3fa21ec4ca2c195bf10cdf00fa098f67bbb5dd440a936ad3e9')
sha256sums_loong64=('20c43e86390653e9534abaab9d005aee90ea438c752197e9548eefc633ec62ab'
                    '30ad2dc9101eb9bc708a1f9313bc7c968218deb7bb77c09224532fb81face17f')
sha256sums_powerpc64le=('fa072142c2f5f749e59758662e8b764b46cd66aaec751497969bdd9a631a1495'
                        '3ac40febaa4f1ffccb0d0d711d356e289fad8b79e8fcdb9afa466588386bc855')
