sha256sums_i686=('4f4c5d3f2f843ee780312fa20d4002bcd62e3bb573758f900d20c49e8639f2ce'
                 'f3daecbce5a66a48c984152caa7069dfa4fc087a33ee3d83cb95ae7de3ef72db')
