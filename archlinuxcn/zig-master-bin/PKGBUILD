sha256sums_armv7h=('5a01eadc42fd7ce7222489630172a36c3e56cf7b8f12fe06ac5a605c0001d568'
                   'a6406054f89c72f9e833393b32066ee642e367b7cf29540242b694f98a2061e3')
sha256sums_i686=('0be378ab9579de4930d705b12efeeaac18a473401f62932cde228d37c96ab0a5'
                 '68331a27823a7e6851f5b5ba31eb822ea9c5b2a54bbe0c44543da427c64b8c37')
sha256sums_loong64=('825d7fa6ba3884a2b46994cc9672e7cc36caa16e7ccae7b3f22a78bd14a71228'
                    'd3c9e95ffa58d71e68c5570147664d208b23b0d252f1cca504c650e52d6ea528')
sha256sums_powerpc64le=('21c0dd9eb0a4135058a0f0044b50cb128d5dcda713f6b1fc02081df15b4445e9'
                        '10f58eef9c3b09d307db1866ebc88d38c258d7c6e4b00298a2e6ed448828b187')
