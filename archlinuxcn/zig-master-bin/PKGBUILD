sha256sums_i686=('e9a418121175e0281fab841ddea40df068daf2f241c59fe74829645d3176ecef'
                 'c7ed4343c1cda5aeadd8cb5c6e710804e813d4d2fdd35c260323608bed68cfd5')
sha256sums_loong64=('803d125739987c61e35fc09a328171720c59ea1a6bf07d6d1d8e690f49cb01c7'
                    '4e85e585410c3c0495a87fe56e934e88cc4888dc306386b399d613587726bde5')
sha256sums_powerpc64le=('df0f7bef58d12cc0adb2de2a973d3e32221b6d52cc7de9bc8a89f5de4010ee3a'
                        'f30f180ad3f5c2a4777901ad9f791eae0d0fc7d2ca7a95c9dbbd32b6d9def125')
