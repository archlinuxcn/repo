                    'd6db320f02b9fcc151c7ee2d5ee44cea10c4a1a0209acf606659bd7126272b5b')
sha256sums_powerpc64le=('3599898bec5c91cbdff8152258b67ce2982f4230118be3fdb5bdbd78bd238922'
                        '07aab3274cf6b141ef88144d0d0500b41093bfe671e6840d09a8639f53f1b522')
