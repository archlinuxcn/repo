                   '2f63548b114e9420cb78b12c527dce65586d161ca08e3045efd9375b48b7f415')
sha256sums_i686=('5652ed03b5172186189844a0ee28869a77967bf36a01c2b566b4459e6440d8e8'
                 'ad1af134b108f60b1357771cd46a76f8e6f414853a884f67c1e9887f53fe8cb1')
sha256sums_loong64=('044b0c87bbf36df7b9f1d3e3a29b8cca909cd82dfac0998904c88c330f0866cb'
                    'f3bbaa327f612d2fbd47ff537772c70df6c6b446ae5e9de6aa9bd041a6114fb9')
sha256sums_powerpc64le=('96877f9046d43719c621aeff3d5120368a46e2cd01ac21ee7535c4c4d5b3f5ac'
                        '2c497c1abd2806eb7d9f80a898b137b2084fb73b24c90ce3051ed3dcae706633')
