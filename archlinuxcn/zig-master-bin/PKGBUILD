                   '7c34c8f1cdd4bad53ac2c7d7b6228619dcc9b18d0678636103df516125a789df')
sha256sums_i686=('5ab0cad0cc183a61f67ead4205e70feb567534ed77ecaa4ea04cdfa0958a6d7d'
                 '03d8ce8677b1310a3836f10e3adcbae1fe5611653ea1a6f8072039b5d9170299')
sha256sums_loong64=('bda6f61760a680c19a418ed8e53e96706fea44d4bfbd596712b603386f4cec05'
                    '2dbbf70d5a577c304394ce5381f2827dbeca937cd2e02d723eb72248df530fae')
sha256sums_powerpc64le=('7ffd6c2e46cf2c3e29d3d42a811f454d182954a00496a757ae42676e9c0b8814'
                        'e8cbceedc490131d34d507b558030e52a8398c3188f284f6023c1f61d752a81a')
