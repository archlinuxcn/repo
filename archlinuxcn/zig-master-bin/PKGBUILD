                   'c377ba440bd5f4daf6b32d7494e343f3da6d446f9b0c431463da7d166404821a')
sha256sums_i686=('6a51796410634109e6713f89df8b79afd7aaa99a4959b2bc894741c8bbdc9380'
                 '19dd3807a3465ef3280522c0b30713efe6efb807b66ace3c26fd80680e1eb653')
sha256sums_loong64=('b482783853d326837d5b9ca4b54ed829d4eba7ed7ad928c55e2c8a5ee71fedee'
                    '65feb6ced34bc91f8b0332700d8a8b5e75f27115d00aa326037c194ef2dcb062')
sha256sums_powerpc64le=('acee5fd38d381fc571c3e52f31b982cc5e59b09f291c38dff79ec4424e5ed5bc'
                        'ce4824e1cef007855cb99ae594ab1f02992ad9f5b419338f3342b31ef9ec984e')
