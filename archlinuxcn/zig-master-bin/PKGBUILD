                   '5d7b8a08a24ed157a6a4a16b7ab3412eddd17fc2215d946b29afac244f20b909')
sha256sums_i686=('a0717e1b2ea437b4308f163490d46deef99f9f9eba75db17198aa603ee505e98'
                 'f60c692ca690bec71460512468176e50d0b391c87a8477c13b8d4970eb7a5a63')
sha256sums_loong64=('4c60361532378fb3e978cdd1172f39a05f0faf424a4158253acd09aa41d302fd'
                    'c4a2d04ea3272e130a4fc10a6896eeeb1f2ce5bd2b6108343fddd3d007d1de27')
sha256sums_powerpc64le=('cffb12f8136ec4bb4222cc13f9b22a65dc4b562681b50b14763ec35112cae988'
                        'af7d8f343750e720d9c4137c9b3a1e5b3de4b3c1c9c2995f768c74541c498eaf')
