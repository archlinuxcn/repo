                   'bb1a99233c1f6c239652956af5a9b3b7fe8d845a0eee038a08511e0f99396808')
sha256sums_i686=('90c5ebd3b9933b8ee5058bc8db28e1808891665ee86314ba9efdb9fe58690ef3'
                 '22a555d67f0eb565065d4e3dc291bcacf04fefbe78f4148cd34cba5513c3bc90')
sha256sums_loong64=('67dbf172af75d501eb2a811dde92ad838326095c4c0a9b9a50c1599e012403aa'
                    '1171e8a14e3206e546fc30aa74fc8ff580d2cea6266939216c7e7df499ae220d')
sha256sums_powerpc64le=('80509ce9c837682bdd72d1b4b967d679b8ef474d13c90fa253f1dcd7af4043ff'
                        '0ca78b0fac516e61dc0e4de61c86c4e9be97bda2c7b223eb3ddc291c43304258')
