                    'a109c43c984f84969c2b876909471eb20ac09149a019dfaa37255d1f705e49ee')
sha256sums_powerpc64le=('0c87894cedf230805f84fa8095dd221fc92caed5f746e641fb15b47b6022da0f'
                        'af6697cc9d68616ab23ac81780f4b33ff2ed7117cc1a086ac74a2eb604ac61b9')
