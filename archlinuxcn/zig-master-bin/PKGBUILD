                    '0d853e988b6aa1fc5978fbd668a0681c13daf478d1ec144ea0e5eb5312b8619d')
sha256sums_powerpc64le=('136be0a916e13b36c1f0fadd591de2be2f1cbd18f573b21acc743da574234c72'
                        '86d467719f57faaf99bcbc244390b96f3451f7ecbce1684800b4cc3798c26da7')
