sha256sums_i686=('fbd1bc452992bc73d97abfda29389a72ffbe0f13a7becc1b88b122ca188334d2'
                 '7ed0a237990911314a81b1d538de5bfde9924a2fb47b138d783ba5a475f12cf8')
sha256sums_loong64=('3753caf177d71f38b41de1df8bb6f00cc534fa41ff839de799f61cc99550cfd1'
                    'd8e2265fb4cda0b25117de8aa1196ba62f7f478707be113e8c0399c6e93950cb')
sha256sums_powerpc64le=('801b48d14b93b710cd74984387b58b8fe9ce530135eb22d93251a219a55f63b9'
                        '199a54b0d53ca9bfd564d4672cb944f4133d95978a0403d8c7eadb1cd938ad95')
