# shellcheck shell=bash
pkgname=zig-master-bin
pkgver=0.18.0dev.855+aa2d45d91
pkgrel=1
pkgdesc="A general-purpose programming language and toolchain for maintaining robust, optimal, and reusable software (master release)"
arch=('aarch64' 'armv7h' 'i686' 'loong64' 'powerpc64le' 'riscv64' 'x86_64')
url="https://ziglang.org/"
license=('MIT')
provides=('zig-master' 'zig-unstable')
conflicts=('zig')
replaces=('zig-nightly-bin')
makedepends=('minisign')
options=('!strip')

_master_version=${pkgver/dev/-dev}

source_aarch64=("https://ziglang.org/builds/zig-aarch64-linux-${_master_version}.tar.xz" "https://ziglang.org/builds/zig-aarch64-linux-${_master_version}.tar.xz.minisig")
