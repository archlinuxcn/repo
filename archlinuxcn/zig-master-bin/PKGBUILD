                   '9e22460c6303bcbba30f63b51be1220cd0b44fddd23b8a18ca35c1e70c17a8a6')
sha256sums_i686=('fc0dd21ce3499322f6c812b7b7473a5ab279267f7a6dce24241226b93a9dc004'
                 '67960eb854534557e5eaed896dab31f4d8c9b9bbc8c9f2b0c5e33b38da50288a')
sha256sums_loong64=('41e089ebd83d9436da187e6d74788aad6c1f96f075eee7be89b3150774b88c16'
                    '2fb488dbf9cc8ca38c5ea3be74d6e2f756779d0feec3a9722f9b813e1880fdcd')
sha256sums_powerpc64le=('00e57a92207d4bc8740c0db7d1dee7782b6e5f6556fbfb0938c2c2aa144177a1'
                        '29bcf14b68945a0a0603c096db0b77be897f6785952c98f2ee333e663775746f')
