                   '00d7d6c5aa25bad882f46fab69f29a74414e3d16d0bb30a434729f0ae6335100')
sha256sums_i686=('593fcc322d27cdd839242977cf8cb893241c734c905f67eeb8ef0994d7b1379d'
                 '92cef6fa4506829bd0f44afe55999abd462e52c69f5f20eb36a7494a061dddbb')
sha256sums_loong64=('9618443ee0d992e6df35bf0e5a1eb8ef71cc9099dc2d11d7955f52a8c08f8cad'
                    '56b182e64e6d9e979001e52f0b0ebd72e5aaeb5aaa5a171ce752b6f06b5723ac')
sha256sums_powerpc64le=('ea495ea3cf8cc9f1f2ba2d71b9a328ac0c1921b2323d668421803394fb5cf6ee'
                        'bc231557e8f358fdfece71a7ae9fe7e5ea9fbad1103752733f1e32f26a44a183')
