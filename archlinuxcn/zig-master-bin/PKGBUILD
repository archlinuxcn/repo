                   'f576cbd17d785c9543f21063a0750254f5484b73b91380c85c691b8e72104db0')
sha256sums_i686=('6d1f799ba3cbfb595be6821a6033fcac55759f6c327cb486a4b489143e1d65af'
                 'b9fd5c80f7169a6c7ce74d241e6d08d751fc2d6f8e5ec08ab86036c44855d810')
sha256sums_loong64=('30bbb4a195b17bd860c42df1fe79ae9c89c87f6b735766da3d38aad0936e96d4'
                    'fb1bc6ea575cb1c50f1e67efe62883f95e8dbde9c07f9bf76d9988ca26dea213')
sha256sums_powerpc64le=('5268f91b0140f8fda1c18818a1213967dbc3f53cd89963a95386525a9e1f0229'
                        'd65b5b005c40b944f0211b0f94be3d9507a439507f319ab7288d63cb340cfdca')
