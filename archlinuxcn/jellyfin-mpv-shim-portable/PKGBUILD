# Maintainer: Kimiblock Moe

pkgname=jellyfin-mpv-shim-portable
pkgver=3.3.0
pkgrel=1
epoch=1
pkgdesc="Cast media from Jellyfin Mobile and Web apps to MPV, sandboxed by portable"
arch=('any')
url="https://github.com/jellyfin/jellyfin-mpv-shim"
license=('MIT')
groups=()
provides=(jellyfin-mpv-shim)
options=()
conflicts=(jellyfin-mpv-shim)

optdepends=()

makedepends+=(
	portable-packer
	python-build
	python-installer
	python-wheel
	gettext
	python-setuptools
	git
)

checkdepends=()

source=(
	config.toml
	desktop.file
	"source::git+${url}.git#tag=v${pkgver}"
)

depends=(
	mpv
	python
	hicolor-icon-theme
	python-mpv
	python-requests
	python-mpv-jsonipc
	python-jellyfin-apiclient
	python-pillow
	mpv-shim-default-shaders
	'portable'
)


md5sums=('c8de0f2fb631bbd095fe88b63759ad56'
         '8f618c4b3ae46327779c7f9b2d2be6d8'
         'e83e526a42c71a1eff2dff61cc6724da')

function prepare() {
	cd source

	find -iname '*.po' | while read -r _file; do
		msgfmt "$_file" -o "${_file%.*}.mo"
	done
}

function build() {
	cd source
	python -m build --wheel --no-isolation
}

function package() {
	cd source

	install -Dm644 "LICENSE.md" "${pkgdir}"/usr/share/licenses/$pkgname/LICENSE

	python -m installer --destdir="${pkgdir}" dist/*.whl

	for i in 16 32 48 64 128 256; do
		install \
			-vDm644 \
			jellyfin_mpv_shim/integration/jellyfin-$i.png \
			"${pkgdir}"/usr/share/icons/hicolor/${i}x${i}/apps/com.github.iwalton3.jellyfin-mpv-shim.png
	done

	install \
		-vDm644 \
		jellyfin_mpv_shim/integration/com.github.iwalton3.jellyfin-mpv-shim.appdata.xml \
		-t "${pkgdir}"/usr/share/metainfo/

	cd "${pkgdir}"
	local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")

	ln \
		-s \
		/usr/share/mpv-shim-default-shaders \
		${site_packages:1}/jellyfin_mpv_shim/default_shader_pack


	depends+=("portable")

	export pkgdir
	export pkgname
	export srcdir
	portable-packer \
		-v \
		--distro arch \
		--mode post \
		--hash true \
		--config-ng "${srcdir}/config.toml" \
		--desktop-file "${srcdir}/desktop.file"
}
