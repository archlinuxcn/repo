pkgname=qdl
pkgver=2.8
pkgrel=0
pkgdesc="Tool to communicate with Qualcomm System On a Chip bootroms to install or execute code"
arch=(armv7h aarch64 i686 x86_64)
url='https://github.com/linux-msm/qdl'
license=('BSD-3-Clause')
depends=(libxml2.so libzip.so xz libicui18n.so libicuuc.so libicudata.so libusb-1.0.so)
makedepends=(git meson ninja cmake help2man)
source=("https://github.com/andersson/${pkgname}/archive/v${pkgver}.tar.gz")
sha512sums=('08253666baf0de51d9dd182e3b0503fd838b084d66a019c0972a95c67e939406995b4e0b1659a9fff89d60a8eb916265523f5fe231c3faef2b45a0b785f37a04')

build(){
  cd ${pkgname}-${pkgver}

  arch-meson . build -D tests=disabled -D nbdkit=disabled
  meson compile -C build
}

package(){
  cd ${pkgname}-${pkgver}

  meson install -C build --destdir "$pkgdir"

  # Package license
  install -d "${pkgdir}/usr/share/licenses/${pkgname}/"
  install LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/"

  # Package documentation
  install -d "${pkgdir}/usr/share/doc/${pkgname}/"
  install README.md "${pkgdir}/usr/share/doc/${pkgname}/"
}
