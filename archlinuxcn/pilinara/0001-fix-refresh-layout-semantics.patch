From: nlsdt <nlsdt@archlinuxcn.org>
Subject: [PATCH 0001/2] fix(refresh): 修复 RefreshLayout 布局协议违规

---
 lib/common/widgets/refresh_layout.dart | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/lib/common/widgets/refresh_layout.dart b/lib/common/widgets/refresh_layout.dart
index 691e9fa62..f7eab6fce 100644
--- a/lib/common/widgets/refresh_layout.dart
+++ b/lib/common/widgets/refresh_layout.dart
@@ -62,8 +62,8 @@ class RenderRefreshLayout extends RenderBox
       return;
     }
     _heightFactor = value;
-    _layoutIndicator();
-    markNeedsPaint();
+    markNeedsLayout();
+    markNeedsSemanticsUpdate();
   }
 
   double _scaleFactor = 0;
@@ -73,8 +73,8 @@ class RenderRefreshLayout extends RenderBox
       return;
     }
     _scaleFactor = value;
-    _layoutIndicator();
-    markNeedsPaint();
+    markNeedsLayout();
+    markNeedsSemanticsUpdate();
   }
 
   void _scaleListener() {
@@ -103,9 +103,7 @@ class RenderRefreshLayout extends RenderBox
     final body = this.body..layout(constraints);
     setOffset(body, .zero);
 
-    if (heightFactor > 0 && scaleFactor > 0) {
-      _layoutIndicator();
-    }
+    _layoutIndicator();
   }
 
   void _layoutIndicator() {
-- 
