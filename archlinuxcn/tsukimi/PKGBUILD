# Contributor: Merrkry <merrkry@tsubasa.moe>

pkgname=tsukimi
pkgver=26.9.1
pkgrel=1
pkgdesc="A simple third-party GTK4 Emby/Jellyfin client"
arch=('x86_64')
url="https://github.com/tsukinaha/${pkgname}"
license=('GPL-3.0-or-later')
depends=(
	'dconf'
	'fontconfig'
	'glib2'
	'glibc'
	'graphene'
	'gstreamer'
	'gtk4'
	'hicolor-icon-theme'
	'lcms2'
	'libadwaita'
	'libgcc'
	'libseccomp'
	'mpv'
	'pango'
)
makedepends=('cargo' 'meson' 'blueprint-compiler')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('a2ee17d56a151a3fc6c0299aebb24ba3ad2ada4eb5ec1fa9f6f7d379a51b1480')
options=('!lto')

build() {
	arch-meson "${pkgname}-${pkgver}" build
	meson compile -C build
}

check() {
	meson test -C build --print-errorlogs
}

package() {
	meson install -C build --no-rebuild --destdir "${pkgdir}"
}
