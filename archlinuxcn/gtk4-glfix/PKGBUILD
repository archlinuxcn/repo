pkgname=gtk4-glfix
pkgver=4.24.1
pkgrel=2
epoch=1
pkgdesc="GObject-based multi-platform GUI toolkit (with EGL config fix for Mesa without GLES 1)"
url="https://www.gtk.org/"
arch=(aarch64 x86_64)
provides=("gtk4=$epoch:$pkgver")
conflicts=(gtk4)
license=(LGPL-2.1-or-later)
depends=(
