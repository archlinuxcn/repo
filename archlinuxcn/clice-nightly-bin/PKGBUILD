pkgbase=clice-nightly-bin
pkgname=('clice-nightly-bin' 'clice-nightly-bin-debug')
pkgver=1.1.2026112810
pkgrel=1
pkgdesc='Next-generation C++ language server'
arch=('x86_64')
url='https://github.com/clice-io/clice'
license=('Apache-2.0')
options=('!strip' '!debug')

source=(
  "symbolize-${pkgver}.ts::https://raw.githubusercontent.com/clice-io/clice/v${pkgver}/tools/release/symbolize.ts"
  "clice-${pkgver}.${CARCH}-unknown-linux-gnu.tar.gz::${url}/releases/download/v${pkgver}/clice-${pkgver}.${CARCH}-unknown-linux-gnu.tar.gz"
  "clice-${pkgver}.${CARCH}-unknown-linux-gnu.symbols.tar.xz::${url}/releases/download/v${pkgver}/clice-${pkgver}.${CARCH}-unknown-linux-gnu.symbols.tar.xz"
  clice-symbolize
)
sha256sums=('a4a4e9af25f7613872071ab821042c91c92e3dd036314a0e6d6540cd414847d2'
            'e0ff17aae339e11bb4285a339540120881ae7326ad35d9b4dcd45d2fde0ee45a'
            '7ccd3908fc93bbba2bb797f2a4f8c3151646631c6dfd1e973305e787a3827d77'
            '8c4b9e332db63b026ef808b5fff712ad330487df8c1544fe879950c46e91a534')

package_clice-nightly-bin() {
  pkgdesc+=' (upstream nightly binary)'
  depends=('glibc')
  provides=("clice=${pkgver}")
  conflicts=('clice' 'clice-bin' 'clice-git')

  install -Dm755 "${srcdir}/clice/bin/clice" "${pkgdir}/usr/lib/clice/bin/clice"
  install -dm755 "${pkgdir}/usr/lib/clice/lib"
  cp -a "${srcdir}/clice/lib/clang" "${pkgdir}/usr/lib/clice/lib/"

  install -dm755 "${pkgdir}/usr/bin"
  ln -s /usr/lib/clice/bin/clice "${pkgdir}/usr/bin/clice"
  install -Dm644 "${srcdir}/clice/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/clice/clice.toml" "${pkgdir}/usr/share/doc/${pkgname}/clice.toml"
}

package_clice-nightly-bin-debug() {
  pkgdesc+=' (debugsym for upstream nightly binary)'
  depends=("clice-nightly-bin=${pkgver}-${pkgrel}" 'nodejs>=22.18.0' 'llvm' 'bash')

  install -Dm644 "${srcdir}/clice.gsym" "${pkgdir}/usr/lib/debug/usr/bin/clice.gsym"
  install -Dm755 "${srcdir}/symbolize-${pkgver}.ts" "${pkgdir}/usr/lib/clice/lib/symbolize.ts"
  install -Dm755 "${srcdir}/clice-symbolize" "${pkgdir}/usr/bin/clice-symbolize"
}
