# Maintainer: Kimiblock Moe
pkgname=bitwarden-portable
pkgver=2026.3.1
pkgrel=2
pkgdesc="Zen Browser sandboxed by portable"
arch=('any')
url="https://github.com/Kraftland/portable"
license=(GPL-3.0-or-later)
groups=()
options=(!debug !strip)

makedepends+=(git portable-packer)

depends=(
	"portable"
	"electron"
)

optdepends=()

provides=(bitwarden)
conflicts=(bitwarden)

makedepends+=(
	"bitwarden"
)

checkdepends=()

source=(
	config.toml
	desktop.file
)

function pkgver() {
	export LC_ALL=C
	pacman -Si bitwarden | grep Version | awk '{print $NF}' | cut -d'-' -f1
}

function package() {
	export pkgdir
	export pkgname
	export srcdir
	portable-packer \
		-v \
		--distro arch \
		--mode copy bitwarden \
		--hash true \
		--config-ng "${srcdir}/config.toml" \
		--desktop-file "${srcdir}/desktop.file"
}
sha256sums=(
	'SKIP'
	'SKIP'
)
