[Unit]
Description=Stack the FEX-Emu rootfs and overlay images at /run/fex-emu/rootfs
ConditionPathExists=/usr/share/fex-emu/RootFS/default.erofs

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/fex-emu-rootfs/fex-emu-rootfs-stack start
ExecStop=/usr/lib/fex-emu-rootfs/fex-emu-rootfs-stack stop
# Leave the erofsfuse daemons (if any) alone, they exit by themselves once the
# lazily unmounted layers are no longer used by running FEX-Emu processes.
KillMode=process

[Install]
WantedBy=multi-user.target
