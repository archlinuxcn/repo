# Maintainer: akirco <earlfx@163.com>
pkgname=pigma
pkgver=0.2.13
pkgrel=1
pkgdesc="A netease cloud music client"
arch=('x86_64' 'aarch64')
url="https://github.com/akirco/pigma"
license=('Apache-2.0')
depends=('alsa-lib' 'glibc' 'libgcc')
makedepends=('cargo' 'git')
source=(
    "$pkgname::git+${url}.git#tag=v${pkgver}"
    "y7dl::git+https://github.com/akirco/y7dl.git"
)
sha256sums=('8ed66d60251896c0c41ceb2f2e3ce90939c96b72e3b69a082eb500fdf409d574'
            'SKIP')
options=('!lto')

prepare() {
    cd "${pkgname}/"
    rm -f .cargo/config.toml
    git submodule init
    git -c protocol.file.allow=always submodule set-url crates/y7dl "$srcdir/y7dl"
    git -c protocol.file.allow=always submodule update crates/y7dl
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "${pkgname}/"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-features
}

check() {
    cd "${pkgname}/"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --all-features
}

package() {
    cd "${pkgname}/"
    install -Dm755 "target/release/${pkgname}" -t "${pkgdir}/usr/bin/"
    install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
