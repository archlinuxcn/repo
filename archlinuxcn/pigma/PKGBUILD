# Maintainer: akirco <earlfx@163.com>
pkgname=pigma
pkgver=0.2.6
pkgrel=1
pkgdesc="A netease cloud music client"
arch=('x86_64' 'aarch64')
url="https://github.com/akirco/pigma"
license=('Apache-2.0')
depends=('alsa-lib' 'glibc' 'libgcc')
makedepends=('cargo' 'git')
source=(
    "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
    "y7dl::git+https://github.com/akirco/y7dl.git"
)
sha256sums=('316cff13b28ba7711089dfc802dfea19b33102bbfadbad2a4c5df8325496b41a'
            'SKIP')
options=('!lto')

prepare() {
    cd "${pkgname}-${pkgver}/"
    rm -f .cargo/config.toml
    rm -rf "crates/y7dl"
    mv "$srcdir/y7dl" "crates/y7dl"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "${pkgname}-${pkgver}/"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-features
}

check() {
    cd "${pkgname}-${pkgver}/"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --all-features
}

package() {
    cd "${pkgname}-${pkgver}/"
    install -Dm755 "target/release/${pkgname}" -t "${pkgdir}/usr/bin/"
    install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
