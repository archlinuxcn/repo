 }
 
+MtkRegion *
+meta_shaped_texture_get_sampling_opaque_region (MetaShapedTexture *stex)
+{
+  return stex->sampling_opaque_region;
+}
+
+gboolean
+meta_shaped_texture_get_mipmap_scale_units (MetaShapedTexture *stex,
+                                            float             *x_scale_unit,
+                                            float             *y_scale_unit)
+{
+  int sample_width;
+  int sample_height;
+
+  meta_shaped_texture_ensure_size_valid (stex);
+
+  if (!stex->texture || stex->dst_width == 0 || stex->dst_height == 0)
+    return FALSE;
+
+  get_sample_size (stex, &sample_width, &sample_height);
+  if (sample_width == 0 || sample_height == 0)
+    return FALSE;
+
+  *x_scale_unit = stex->dst_width / (float) sample_width;
+  *y_scale_unit = stex->dst_height / (float) sample_height;
+
+  return TRUE;
+}
+
+gboolean
+meta_shaped_texture_can_use_mipmaps (MetaShapedTexture *stex)
+{
+  return stex->create_mipmaps &&
+         stex->tex_width >= 8 &&
+         stex->tex_height >= 8;
+}
+
+gboolean
+meta_shaped_texture_should_use_mipmaps (MetaShapedTexture *stex,
+                                        float              x_scale,
+                                        float              y_scale)
+{
+  return meta_should_use_mipmaps (meta_shaped_texture_can_use_mipmaps (stex),
+                                  stex->tex_width,
+                                  stex->tex_height,
+                                  x_scale,
+                                  y_scale);
+}
+
+gboolean
+meta_should_use_mipmaps (gboolean create_mipmaps,
+                         int      texture_width,
+                         int      texture_height,
+                         float    x_scale,
+                         float    y_scale)
+{
+  return create_mipmaps &&
+         x_scale < 0.5f &&
+         y_scale < 0.5f &&
+         texture_width >= 8 &&
+         texture_height >= 8;
+}
+
