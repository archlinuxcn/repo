+  ClutterEffect *effect;
+  SizeTrackingDeformEffect *deform_effect;
+  ClutterActorBox initial_allocation;
+  ClutterActorBox allocation;
+  g_autofree uint8_t *pixels = NULL;
+  int initial_generation;
+
+  parent = clutter_actor_new ();
+  actor = clutter_actor_new ();
+  effect = g_object_new (size_tracking_deform_effect_get_type (), NULL);
+  deform_effect = (SizeTrackingDeformEffect *) effect;
+
+  clutter_actor_set_position (actor, 20.0f, 20.0f);
+  clutter_actor_set_size (actor, 64.0f, 48.0f);
+  clutter_actor_set_background_color (actor,
+                                      &(CoglColor) { 255, 0, 0, 255 });
+  clutter_actor_add_effect (actor, effect);
+  clutter_actor_add_child (parent, actor);
+  clutter_actor_add_child (stage, parent);
+  clutter_actor_show (stage);
+
+  pixels = clutter_stage_read_pixels (CLUTTER_STAGE (stage), 0, 0, 1, 1);
+  g_clear_pointer (&pixels, g_free);
+  initial_generation = deform_effect->mesh_generation;
+  clutter_actor_get_allocation_box (actor, &initial_allocation);
+
+  clutter_actor_set_translation (parent, 0.25f, 0.0f, 0.0f);
+  pixels = clutter_stage_read_pixels (CLUTTER_STAGE (stage), 0, 0, 1, 1);
+  g_clear_pointer (&pixels, g_free);
+
+  g_assert_cmpint (deform_effect->mesh_generation, ==, initial_generation + 1);
+
+  clutter_actor_set_translation (parent, 0.5f, 0.0f, 0.0f);
+  pixels = clutter_stage_read_pixels (CLUTTER_STAGE (stage), 0, 0, 1, 1);
+  g_clear_pointer (&pixels, g_free);
+
+  g_assert_cmpint (deform_effect->mesh_generation, ==, initial_generation + 1);
+
+  clutter_actor_set_translation (parent, 0.0f, 0.0f, 0.0f);
+  pixels = clutter_stage_read_pixels (CLUTTER_STAGE (stage), 0, 0, 1, 1);
+
+  g_assert_cmpint (deform_effect->mesh_generation, ==, initial_generation + 2);
+  clutter_actor_get_allocation_box (actor, &allocation);
+  g_assert_true (clutter_actor_box_equal (&allocation, &initial_allocation));
+
+  clutter_actor_destroy (parent);
+}
+
 CLUTTER_TEST_SUITE (
   CLUTTER_TEST_UNIT ("/actor/offscreen/redirect", actor_offscreen_redirect)
-)
+  CLUTTER_TEST_UNIT ("/actor/offscreen/deform-target-size",
+                     actor_offscreen_deform_target_size))
