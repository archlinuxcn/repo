   g_assert_cmphex (rgba, ==, expected_rgba);
 }
 
+static uint8_t *
+read_view_pixels (CoglFramebuffer *framebuffer,
+                  size_t          *size)
+{
+  int width = cogl_framebuffer_get_width (framebuffer);
+  int height = cogl_framebuffer_get_height (framebuffer);
+  uint8_t *pixels;
+
+  *size = width * height * 4;
+  pixels = g_malloc (*size);
+  cogl_framebuffer_read_pixels (framebuffer,
+                                0, 0, width, height,
+                                COGL_PIXEL_FORMAT_RGBA_8888,
+                                pixels);
+
+  return pixels;
+}
+
+static void
+assert_offscreen_effect_matches_direct (ClutterActor    *stage,
+                                        ClutterActor    *actor,
+                                        TestNoopEffect  *effect,
+                                        CoglFramebuffer *framebuffer)
+{
+  static const graphene_point_t offsets[] = {
+    GRAPHENE_POINT_INIT (0.0f, 0.0f),
+    GRAPHENE_POINT_INIT (1.0f, 0.0f),
+    GRAPHENE_POINT_INIT (0.0f, 1.0f),
+    GRAPHENE_POINT_INIT (1.0f, 1.0f),
+  };
+  g_autoptr (GPtrArray) direct_frames =
+    g_ptr_array_new_with_free_func (g_free);
+  size_t direct_size = 0;
+  size_t i;
+
+  clutter_actor_meta_set_enabled (CLUTTER_ACTOR_META (effect), FALSE);
+  for (i = 0; i < G_N_ELEMENTS (offsets); i++)
+    {
+      uint8_t *direct_pixels;
+      size_t frame_size;
+
+      clutter_actor_set_position (actor,
+                                  101.0f + offsets[i].x,
+                                  800.0f + offsets[i].y);
+      clutter_actor_queue_redraw (stage);
+      meta_wait_for_paint (CLUTTER_STAGE (stage));
+      direct_pixels = read_view_pixels (framebuffer, &frame_size);
+      if (i == 0)
+        direct_size = frame_size;
+      else
+        g_assert_cmpuint (frame_size, ==, direct_size);
+      g_ptr_array_add (direct_frames, direct_pixels);
+    }
+
+  clutter_actor_meta_set_enabled (CLUTTER_ACTOR_META (effect), TRUE);
+  for (i = 0; i < G_N_ELEMENTS (offsets); i++)
+    {
+      g_autofree uint8_t *effect_pixels = NULL;
+      size_t effect_size;
+      unsigned int paint_count;
+
+      clutter_actor_set_position (actor,
+                                  101.0f + offsets[i].x,
+                                  800.0f + offsets[i].y);
+      paint_count = effect->paint_count;
+      clutter_actor_queue_redraw (stage);
+      meta_wait_for_paint (CLUTTER_STAGE (stage));
+      effect_pixels = read_view_pixels (framebuffer, &effect_size);
+
+      g_assert_cmpuint (effect->paint_count, >, paint_count);
+      g_assert_cmpmem (effect_pixels, effect_size,
+                       g_ptr_array_index (direct_frames, i), direct_size);
+    }
+}
