+typedef struct _SizeTrackingDeformEffect
+{
+  ClutterDeformEffect parent;
+
+  float mesh_width;
+  float mesh_height;
+  int mesh_generation;
+} SizeTrackingDeformEffect;
+
+typedef ClutterDeformEffectClass SizeTrackingDeformEffectClass;
+
+GType size_tracking_deform_effect_get_type (void);
+
+G_DEFINE_TYPE (SizeTrackingDeformEffect,
+               size_tracking_deform_effect,
+               CLUTTER_TYPE_DEFORM_EFFECT)
+
+static void
+size_tracking_deform_effect_deform_vertex (ClutterDeformEffect  *effect,
+                                           float                 width,
+                                           float                 height,
+                                           ClutterTextureVertex *vertex)
+{
+  SizeTrackingDeformEffect *self = (SizeTrackingDeformEffect *) effect;
+
+  if (vertex->tx == 0.0f && vertex->ty == 0.0f)
+    {
+      self->mesh_width = width;
+      self->mesh_height = height;
+      self->mesh_generation++;
+    }
+}
+
+static void
+size_tracking_deform_effect_paint_target (ClutterOffscreenEffect *effect,
+                                          ClutterPaintNode       *node,
+                                          ClutterPaintContext    *paint_context)
+{
+  SizeTrackingDeformEffect *self = (SizeTrackingDeformEffect *) effect;
+  float target_width;
+  float target_height;
+
+  g_assert_true (clutter_offscreen_effect_get_target_size (effect,
+                                                           &target_width,
+                                                           &target_height));
+
+  CLUTTER_OFFSCREEN_EFFECT_CLASS (
+    size_tracking_deform_effect_parent_class)->paint_target (effect,
+                                                             node,
+                                                             paint_context);
+
+  g_assert_cmpfloat (self->mesh_width, ==, target_width);
+  g_assert_cmpfloat (self->mesh_height, ==, target_height);
+}
+
+static void
+size_tracking_deform_effect_class_init (SizeTrackingDeformEffectClass *klass)
+{
+  ClutterDeformEffectClass *deform_effect_class =
+    CLUTTER_DEFORM_EFFECT_CLASS (klass);
+  ClutterOffscreenEffectClass *offscreen_effect_class =
+    CLUTTER_OFFSCREEN_EFFECT_CLASS (klass);
+
+  deform_effect_class->deform_vertex =
+    size_tracking_deform_effect_deform_vertex;
+  offscreen_effect_class->paint_target =
+    size_tracking_deform_effect_paint_target;
+}
+
+static void
+size_tracking_deform_effect_init (SizeTrackingDeformEffect *self)
+{
+}
