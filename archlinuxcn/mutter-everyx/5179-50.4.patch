From 3ecf994a96b1a6a9de596ce7542c8329a203eba8 Mon Sep 17 00:00:00 2001
From: Matthew Hiltner <matthew.e.hiltner@gmail.com>
Date: Fri, 24 Jul 2026 20:09:41 -0700
Subject: [PATCH 1/4] compositor: Add a region inset helper

Linear texture sampling can read beyond the exact opaque texels at a region boundary. Add a union-preserving one-pixel inset helper for callers that need a conservative sampling region, and cover adjacent rectangles, holes, and thin regions.
---
 src/compositor/clutter-utils.c | 31 ++++++++++++++++++
 src/compositor/clutter-utils.h |  4 +++
 src/tests/unit-tests.c         | 59 ++++++++++++++++++++++++++++++++++
 3 files changed, 94 insertions(+)

diff --git a/src/compositor/clutter-utils.c b/src/compositor/clutter-utils.c
index b75a9b7ebc3..d8355ed503f 100644
--- a/src/compositor/clutter-utils.c
+++ b/src/compositor/clutter-utils.c
@@ -190,3 +190,34 @@ meta_actor_painting_untransformed (CoglFramebuffer *fb,
                                                 out_transforms);
 }
 
+MtkRegion *
+meta_region_create_inset (const MtkRegion *region)
+{
+  g_autoptr (MtkRegion) horizontal = NULL;
+  g_autoptr (MtkRegion) shifted = NULL;
+  MtkRegion *inset;
+
+  /* Intersect one-unit translations of the complete region so adjacent
+   * rectangles remain a single opaque area rather than growing false seams.
+   */
+  horizontal = mtk_region_copy (region);
+
+  shifted = mtk_region_copy (region);
+  mtk_region_translate (shifted, 1, 0);
+  mtk_region_intersect (horizontal, shifted);
+
+  mtk_region_translate (shifted, -2, 0);
+  mtk_region_intersect (horizontal, shifted);
+
+  inset = mtk_region_copy (horizontal);
+
+  g_clear_pointer (&shifted, mtk_region_unref);
+  shifted = mtk_region_copy (horizontal);
+  mtk_region_translate (shifted, 0, 1);
+  mtk_region_intersect (inset, shifted);
+
+  mtk_region_translate (shifted, 0, -2);
+  mtk_region_intersect (inset, shifted);
+
+  return inset;
+}
diff --git a/src/compositor/clutter-utils.h b/src/compositor/clutter-utils.h
index 58bf67dc6af..33958ef9498 100644
--- a/src/compositor/clutter-utils.h
+++ b/src/compositor/clutter-utils.h
@@ -21,6 +21,10 @@
 #pragma once
 
 #include "clutter/clutter.h"
+#include "core/util-private.h"
+
+META_EXPORT_TEST
+MtkRegion * meta_region_create_inset (const MtkRegion *region);
 
 typedef struct {
   int x_origin, y_origin;
diff --git a/src/tests/unit-tests.c b/src/tests/unit-tests.c
index c05b834e209..5f041b70af4 100644
--- a/src/tests/unit-tests.c
+++ b/src/tests/unit-tests.c
@@ -27,6 +27,7 @@
 #include <meta/main.h>
 #include <meta/util.h>
 
+#include "compositor/clutter-utils.h"
 #include "core/boxes-private.h"
 #include "core/display-private.h"
 #include "meta-test/meta-context-test.h"
@@ -42,6 +43,61 @@
 
 MetaContext *test_context;
 
+static void
+meta_test_region_inset (void)
+{
+  const MtkRectangle adjacent_rects[] = {
+    MTK_RECTANGLE_INIT (0, 0, 5, 8),
+    MTK_RECTANGLE_INIT (5, 0, 5, 8),
+  };
+  g_autoptr (MtkRegion) region = NULL;
+  g_autoptr (MtkRegion) inset = NULL;
+  g_autoptr (MtkRegion) expected = NULL;
+
+  region = mtk_region_create_rectangles (adjacent_rects,
+                                         G_N_ELEMENTS (adjacent_rects));
+  inset = meta_region_create_inset (region);
+  expected =
+    mtk_region_create_rectangle (&MTK_RECTANGLE_INIT (1, 1, 8, 6));
+
+  g_assert_true (mtk_region_equal (inset, expected));
+}
+
+static void
+meta_test_region_inset_hole (void)
+{
+  g_autoptr (MtkRegion) region = NULL;
+  g_autoptr (MtkRegion) inset = NULL;
+  g_autoptr (MtkRegion) expected = NULL;
+
+  region =
+    mtk_region_create_rectangle (&MTK_RECTANGLE_INIT (0, 0, 10, 10));
+  mtk_region_subtract_rectangle (region,
+                                 &MTK_RECTANGLE_INIT (4, 4, 2, 2));
+
+  inset = meta_region_create_inset (region);
+
+  expected =
+    mtk_region_create_rectangle (&MTK_RECTANGLE_INIT (1, 1, 8, 8));
+  mtk_region_subtract_rectangle (expected,
+                                 &MTK_RECTANGLE_INIT (3, 3, 4, 4));
+
+  g_assert_true (mtk_region_equal (inset, expected));
+}
+
+static void
+meta_test_region_inset_thin (void)
+{
+  g_autoptr (MtkRegion) region = NULL;
+  g_autoptr (MtkRegion) inset = NULL;
+
+  region =
+    mtk_region_create_rectangle (&MTK_RECTANGLE_INIT (0, 0, 2, 20));
+  inset = meta_region_create_inset (region);
+
+  g_assert_true (mtk_region_is_empty (inset));
+}
+
 typedef struct _MetaTestLaterOrderCallbackData
 {
   GMainLoop *loop; /* Loop to terminate when done. */
@@ -205,6 +261,9 @@ init_tests (void)
   g_test_add_func ("/util/meta-later/order", meta_test_util_later_order);
   g_test_add_func ("/util/meta-later/schedule-from-later",
                    meta_test_util_later_schedule_from_later);
+  g_test_add_func ("/util/region/inset", meta_test_region_inset);
+  g_test_add_func ("/util/region/inset-hole", meta_test_region_inset_hole);
+  g_test_add_func ("/util/region/inset-thin", meta_test_region_inset_thin);
 
   init_monitor_store_tests ();
   init_boxes_tests ();
