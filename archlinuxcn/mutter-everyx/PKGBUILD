prepare() {
  cd mutter
  git apply -3 ../5179.patch
  git apply -3 ../1b169970bfd4da9f4dba87083e49e2b9740264cb.patch
  git apply -3 ../e68cf2168d3267e5d519787af521ed63cd9bb086.patch
  git apply -3 ../434500b28e78b810c654899d5a7235ce64be45c3.patch
}

build() {
  local meson_options=(
    -D docs=false
    -D devkit=enabled
    -D installed_tests=false
    -D tests=disabled
  )

  CFLAGS="${CFLAGS/-O2/-O3} -fno-semantic-interposition"
  LDFLAGS+=" -Wl,-Bsymbolic-functions"

  # Inject gvdb
  export MESON_PACKAGE_CACHE_DIR="$srcdir"

  arch-meson mutter build "${meson_options[@]}"
  meson compile -C build
}


package() {
  provides+=(libmutter-51.so)
  optdepends=(
    'bash-completion: Bash completions for gdctl'
    'mutter-devkit: Mutter SDK, "MDK"'
  )

  meson install -C build --no-rebuild --destdir "$pkgdir"

  rm "$pkgdir"/usr/lib/mutter-devkit
  rm "$pkgdir"/usr/share/applications/org.gnome.Mutter.Mdk.desktop
  rm "$pkgdir"/usr/share/icons/hicolor/scalable/apps/org.gnome.Mutter.Mdk.Devel.svg
  rm "$pkgdir"/usr/share/icons/hicolor/scalable/apps/org.gnome.Mutter.Mdk.svg
  rm "$pkgdir"/usr/share/icons/hicolor/symbolic/apps/org.gnome.Mutter.Mdk-symbolic.svg

}



