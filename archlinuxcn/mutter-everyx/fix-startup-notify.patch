--- a/src/core/meta-launch-context.c
+++ b/src/core/meta-launch-context.c
@@ -138,6 +138,20 @@ meta_launch_context_get_startup_notify_id (GAppLaunchContext *launch_context,
   if (context->workspace)
     workspace_idx = meta_workspace_index (context->workspace);
 
+  /* A desktop entry with StartupNotify=false opts out of startup
+   * notification: the app will never send an activation/remove message,
+   * so creating a tracked sequence would only show the global WAIT cursor
+   * until STARTUP_TIMEOUT_MS. Skip the X11/libsn path (whose monitor
+   * sequences carry an application-id and thus count as pending) and fall
+   * through to the Wayland token path: the return value stays usable as
+   * an activation token (tray/notification clicks still raise the window)
+   * while the sequence has no application-id, so it never flips the
+   * compositor's global cursor to WAIT. */
+  if (G_IS_DESKTOP_APP_INFO (info) &&
+      !g_desktop_app_info_get_boolean (G_DESKTOP_APP_INFO (info),
+                                       "StartupNotify"))
+    goto skip_x11_startup_notification;
+
 #ifdef HAVE_XWAYLAND
   if (display->x11_display)
     {
@@ -154,6 +168,7 @@ meta_launch_context_get_startup_notify_id (GAppLaunchContext *launch_context,
     }
 #endif
 
+skip_x11_startup_notification:
   if (!startup_id)
     {
       const char *application_id = NULL;
