pkgname=julia-git-sass-src
pkgver=0.2.0
_commit=80950376e7293df84246bcac608f58f89466b147
pkgrel=1
pkgdesc="Sass.jl"
url="https://github.com/piever/Sass.jl.git"
arch=('any')
