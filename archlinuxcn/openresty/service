[Unit]
Description=OpenResty - A Fast and Scalable Web Platform by Extending NGINX with Lua
After=syslog.target network.target

[Service]
Type=forking
PIDFile=/run/openresty/nginx.pid
RuntimeDirectory=openresty
LogsDirectory=openresty
ExecStartPre=/opt/openresty/nginx/sbin/nginx -t -q
ExecStart=/opt/openresty/nginx/sbin/nginx
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s QUIT $MAINPID

[Install]
WantedBy=multi-user.target
