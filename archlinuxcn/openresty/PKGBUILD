package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm644 "$srcdir/nginx.conf" "$pkgdir/$_cfgdir/nginx.conf"

  install -Dm644 "$srcdir/nginx.vh.default.conf" "$pkgdir/$_cfgdir/conf.d/default.conf"

  install -d "$pkgdir"/etc/logrotate.d
  install -m644 "$srcdir/openresty.logrotate" "$pkgdir/etc/logrotate.d/openresty"

  install -dm755 "$pkgdir/$_logdir"

  install -Dm644 "$srcdir/service" "$pkgdir/usr/lib/systemd/system/openresty.service"
  rm -rf "$pkgdir/var/run"
  install -Dm755 "$srcdir/$pkgname.sh" "$pkgdir/etc/profile.d/$pkgname.sh"
}
