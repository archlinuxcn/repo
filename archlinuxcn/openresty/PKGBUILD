build() {
  cd "$srcdir/$pkgname-$pkgver"

  ./configure \
    --prefix=/opt/openresty \
    --conf-path=$_cfgdir/nginx.conf \
    --pid-path=/run/openresty/nginx.pid \
    --http-log-path=$_logdir/access.log \
    --error-log-path=$_logdir/error.log \
    --user=http --group=http \
    --with-compat \
    --with-threads \
    --with-file-aio \
    --with-http_addition_module \
    --with-http_auth_request_module \
    --with-http_dav_module \
    --with-http_flv_module \
    --with-http_geoip_module=dynamic \
    --with-http_gunzip_module \
    --with-http_gzip_static_module \
    --with-http_mp4_module \
    --with-http_random_index_module \
    --with-http_realip_module \
    --with-http_secure_link_module \
    --with-http_slice_module \
    --with-http_ssl_module \
    --with-http_stub_status_module \
    --with-http_sub_module \
    --with-http_v2_module \
    --with-http_v3_module \
    --with-http_iconv_module \
    --with-luajit \
    --with-pcre-jit \
    --with-stream_ssl_module \
    --with-stream_ssl_preread_module \
    --without-http_rds_json_module \
    --without-http_rds_csv_module \
    --without-lua_rds_parser \
    --without-mail_pop3_module \
    --without-mail_imap_module \
    --without-mail_smtp_module \
    # Complete set of configure options
    #
    # OpenResty build options
    # --with-debug                        \ # enable debug logging
    # --with-no-pool-patch                \ # enable no-pool patch for debugging memory issues
    #
    # Lua library options
    # --without-lua_cjson                 \ # disable the lua-cjson library
    # --without-lua_tablepool             \ # disable the lua-tablepool library (and by consequence, lua-resty-shell)
    # --without-lua_redis_parser          \ # disable the lua-redis-parser library
    # --without-lua_rds_parser            \ # disable the lua-rds-parser library
    # --without-lua_resty_dns             \ # disable the lua-resty-dns library
    # --without-lua_resty_memcached       \ # disable the lua-resty-memcached library
