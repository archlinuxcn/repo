# Maintainer: Xeonacid <h.dwwwwww@gmail.com>

_name=bitstruct
pkgname=python-${_name}
pkgver=8.22.2
pkgrel=1
pkgdesc="Python bit pack/unpack package."
arch=(x86_64)
url="https://github.com/eerimoq/${_name}"
license=(MIT)
depends=(glibc python)
makedepends=(python-build python-installer python-setuptools python-wheel)
checkdepends=(python-pytest)
source=(${_name}-${pkgver}.tar.gz::${url}/archive/${pkgver}.tar.gz)
sha512sums=('71f1d52d9ea9f2e5223567fa2cd045d0aff1fff62fd8416cf9f8bb4b3532b95ce7bbd8e40c807f55c077c534b4b17c173d9adc6483b78870ef286c4d645f5f5b')

build() {
  cd $_name-$pkgver
  python -m build --wheel --no-isolation
}

check(){
  cd $_name-$pkgver
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest -vv tests/
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 README.rst -t "$pkgdir/usr/share/doc/$pkgname"
}
