pkgname=julia-git-libva_jll-src
pkgver=2.24.1+0
_commit=1f0e15919380e007aebfbf8df064a258fb06cf62
pkgrel=1
pkgdesc="libva_jll.jl"
url="https://github.com/JuliaBinaryWrappers/libva_jll.jl.git"
arch=('any')
license=('MIT')
makedepends=(git julia-pkg-scripts)
depends=(julia-git libva)
source=("git+https://github.com/JuliaBinaryWrappers/libva_jll.jl.git#commit=$_commit"
        jll.toml)
sha256sums=('8837411e2ecd5ceb55c93284c70b8e4f074e8171bdc94ba452d6f2bcf9f0cc2c'
            '612d2a5af9e7c518cd30750b63d5f6c235d99951c3d94d0000a9d8edf318817e')

build() {
  cd libva_jll.jl

  julia /usr/lib/julia/julia-gen-jll.jl libva_jll ../jll.toml
}

package() {
  cd libva_jll.jl

  JULIA_INSTALL_SRCPKG=1 . /usr/lib/julia/julia-install-pkg.sh libva_jll "${pkgdir}" "${pkgname}" julia-git
}
