pkgname=julia-git-opencl-src
pkgver=0.10.10
_commit=3b7e0ad57004037b28b72f7474fdcc2f2c265a1c
pkgrel=1
pkgdesc="OpenCL.jl"
url="https://github.com/JuliaGPU/OpenCL.jl.git"
arch=('any')
license=('MIT')
makedepends=(git julia-pkg-scripts)
depends=(julia-git)
source=("git+https://github.com/JuliaGPU/OpenCL.jl.git#commit=$_commit"
        0001-Fix-loading-on-julia-master.patch)
sha256sums=('032847577015256f92c8141087c9c4cbfe74c5a064bf93817e924f2928e8756d'
            'a8335af6905c3c8b1c7e63008cd2741b91240145ba5eb842a971b1217461cb11')

prepare() {
  cd OpenCL.jl

  patch -Np1 --no-backup-if-mismatch < ../0001-Fix-loading-on-julia-master.patch
}

package() {
  cd OpenCL.jl

  JULIA_INSTALL_SRCPKG=1 . /usr/lib/julia/julia-install-pkg.sh OpenCL "${pkgdir}" "${pkgname}" julia-git
}
