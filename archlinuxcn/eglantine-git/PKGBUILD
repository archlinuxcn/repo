pkgname=eglantine-git
pkgver=0.r30666.g835019f
pkgrel=2
pkgdesc='Nintendo Switch emulator (development branch)'
arch=('x86_64')
url='https://github.com/Djihads80/Eglantine'
license=('GPL-3.0-or-later')
depends=(
  'boost-libs'
  'enet'
  'ffmpeg'
  'libusb'
  'opus'
  'openssl'
  'qt6-base'
  'qt6-charts'
  'sdl3'
  'vulkan-icd-loader'
)
makedepends=(
  'boost'
  'clang'
  'cmake'
  'git'
  'glslang'
  'libzip'
  'lld'
  'lz4'
  'ninja'
  'nlohmann-json'
  'opus'
  'qt6-base'
  'qt6-charts'
  'spirv-headers'
  'spirv-tools'
  'vulkan-headers'
  'vulkan-utility-libraries'
  'xbyak'
  'zlib'
  'zstd'
)
optdepends=(
  'qt6-wayland: native Wayland support'
)
provides=('eglantine')
conflicts=('eglantine')
source=("eglantine::git+https://github.com/Djihads80/Eglantine.git#branch=nx2"
        'explicit-optional-json.patch'
        'eglantine-names.patch')
sha256sums=('SKIP'
            '37616bc50db1d8289043c5eb731f87735023cf9db6f958edc6df0d4a5c2f9b64'
            '82c9e7ad7c21c6aa7ca62244408297e09254a506b4a8ae8e8d913d427d907429')

pkgver() {
  cd "$srcdir/eglantine"
  printf '0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$srcdir/eglantine"
  # Avoid ambiguous JSON conversion to std::optional with current nlohmann-json.
  patch -Np1 -i "$srcdir/explicit-optional-json.patch"
  # Keep installed binaries and runtime paths separate from Eden.
  patch -Np1 -i "$srcdir/eglantine-names.patch"
}

build() {
  # Use upstream's bundled LLVM profile, as in its Linux PGO builds.
  local profile="$srcdir/eglantine/eglantine.profdata"
  if [[ ! -s "$profile" ]]; then
    error "Missing PGO profile: $profile"
    return 1
  fi
  local pgo="-fprofile-use=\"$profile\" -Wno-backend-plugin -Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date"

  cmake -S "$srcdir/eglantine" -B "$srcdir/build" -G Ninja \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    "-DCMAKE_C_FLAGS=$CFLAGS $pgo" \
    "-DCMAKE_CXX_FLAGS=$CXXFLAGS $pgo" \
    "-DCMAKE_EXE_LINKER_FLAGS=$LDFLAGS -fuse-ld=lld" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DENABLE_QT=ON \
    -DENABLE_UPDATE_CHECKER=OFF \
    -DYUZU_CMD=ON \
    -DYUZU_ROOM=OFF \
    -DYUZU_USE_BUNDLED_QT=OFF \
    -DYUZU_USE_BUNDLED_SDL3=OFF \
    -DYUZU_USE_BUNDLED_FFMPEG=OFF \
    -DYUZU_TESTS=OFF \
    -DBUILD_TESTING=OFF
  cmake --build "$srcdir/build" --parallel
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"

  # The desktop entry uses the Eglantine icon name; the upstream install uses
  # the older Eden filename, so install an alias that matches the desktop file.
  install -Dm644 "$srcdir/eglantine/dist/dev.eden_emu.eden.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.eglantine.eglantine.svg"
}
