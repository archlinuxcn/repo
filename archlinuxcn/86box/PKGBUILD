pkgname=86box
pkgver=6.0
pkgrel=2
pkgdesc='An emulator for classic IBM PC clones'
arch=('x86_64')
url='https://github.com/86Box/86Box'
license=('GPL-2.0-or-later' 'CC-BY-4.0')
depends=(
	'fluidsynth'
	'hicolor-icon-theme'
	'libserialport'
	'libslirp'
	'openal'
	'qt6-base'
	'rtmidi'
	'sdl2'
	'freetype2'
	'gcc-libs'
	'glib2'
	'glibc'
	'libevdev'
	'libglvnd'
	'libpng'
	'libsndfile'
	'libx11'
	'libxcb'
	'libxext'
	'libxi'
	'libxkbcommon-x11'
	'libxkbcommon'
	'zlib'
)

makedepends=(
	'cmake'
	'extra-cmake-modules'
	'ninja'
	'qt6-tools'
	'vde2'
	'vulkan-headers'
	'git'
)
optdepends=(
	'86box-roms: ROM files'
	'discord-game-sdk: Discord Rich Presence'
	'ghostscript: Printing with Generic PostScript Printer'
	'libpcap: Networking not limited to TCP/IP'
)
options=(
	'!buildflags'
)
source=(
	"source::git+${url}.git#tag=v${pkgver}"
	"assets::git+https://github.com/86Box/assets.git#tag=v${pkgver}"
)
sha512sums=('8a4c1fb124a17e16df8c5adadd523da86f9b1d64028ee0bd5a1e56af869ce9bf5cbc0d030bd8c8643723983a45f391af0df321188e34daae9ed8186c40110a48'
            '5b99107cc8542f6ffdba0cdb0833d1c0f1dcfcc9b46c4edf4b00acca49b470132bfd5c2d7f00c2c4899da905991d2b7f7c427aa860530465630e657972745335')

build() {
	LDFLAGS='-z now -z shstk' \
		cmake \
		-S"source" \
		-Bbuild \
		--preset \
		regular \
		--toolchain \
		"cmake/flags-gcc-${CARCH}.cmake" \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DUSE_QT6=on
	cmake \
		--build \
		build
}

package() {
	DESTDIR="${pkgdir}" \
		cmake \
		--build \
		"${srcdir}/build" \
		--target install
	for i in 16x16 20x20 24x24 32x32 48x48 64x64 72x72 128x128 256x256; do
		install \
			-vDm644 \
			"${srcdir}/source/src/unix/assets/${i}/net.86box.86Box.png" \
			-t \
			"${pkgdir}/usr/share/icons/hicolor/${i}/apps"
	done

	install \
		-vDm644 \
		"${srcdir}/source/src/unix/assets/net.86box.86Box.desktop" \
		"${pkgdir}/usr/share/applications/net.86box.86Box.desktop"
	install \
		-d \
		"${pkgdir}/usr/share/86Box/assets"
	cp \
		-a \
		"${srcdir}/assets/sounds" \
		"${pkgdir}/usr/share/86Box/assets"
}
